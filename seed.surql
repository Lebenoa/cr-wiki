-- ------------------------------
-- TABLE: skin_translation
-- ------------------------------

DEFINE TABLE skin_translation TYPE ANY SCHEMALESS PERMISSIONS NONE;




-- ------------------------------
-- TABLE DATA: skin_translation
-- ------------------------------


-- ------------------------------
-- TABLE: treasure
-- ------------------------------

DEFINE TABLE treasure TYPE ANY SCHEMALESS PERMISSIONS NONE;


DEFINE INDEX treasure_rank_release_date ON treasure FIELDS rank, release_date;
DEFINE INDEX treasure_search_0 ON treasure FIELDS tr.en.name FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX treasure_search_1 ON treasure FIELDS tr.th.name FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);
DEFINE INDEX treasure_search_2 ON treasure FIELDS tr.en.description FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX treasure_search_3 ON treasure FIELDS tr.th.description FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);

DEFINE EVENT treasure_gram ON treasure WHEN ($after.tr.en.name ?? '') != '' THEN { FOR $g IN (SELECT VALUE gram FROM name_gram WHERE section = 'treasure' AND entity_id = record::id($after.id)) { DELETE name_gram WHERE section = 'treasure' AND gram = $g AND entity_id = record::id($after.id) }; FOR $g IN array::windows(array::filter(string::split(string::lowercase($after.tr.en.name), ''), |$c: any| $c != ''), 3).map(|$w: any| array::join($w, '')) { CREATE name_gram SET gram = $g, section = 'treasure', entity_id = record::id($after.id) }; };

-- ------------------------------
-- TABLE DATA: treasure
-- ------------------------------

