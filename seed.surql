-- ------------------------------
-- TABLE: relic
-- ------------------------------

DEFINE TABLE relic TYPE ANY SCHEMALESS PERMISSIONS NONE;


DEFINE INDEX relic_search_0 ON relic FIELDS tr.en.name FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX relic_search_1 ON relic FIELDS tr.th.name FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);
DEFINE INDEX relic_search_2 ON relic FIELDS tr.en.description FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX relic_search_3 ON relic FIELDS tr.th.description FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);

DEFINE EVENT relic_gram ON relic WHEN ($after.tr.en.name ?? '') != '' THEN { FOR $g IN (SELECT VALUE gram FROM name_gram WHERE section = 'relic' AND entity_id = record::id($after.id)) { DELETE name_gram WHERE section = 'relic' AND gram = $g AND entity_id = record::id($after.id) }; FOR $g IN array::windows(array::filter(string::split(string::lowercase($after.tr.en.name), ''), |$c: any| $c != ''), 3).map(|$w: any| array::join($w, '')) { CREATE name_gram SET gram = $g, section = 'relic', entity_id = record::id($after.id) }; };

-- ------------------------------
-- TABLE DATA: relic
