-- ------------------------------
-- TABLE: cookie
-- ------------------------------

DEFINE TABLE cookie TYPE ANY SCHEMALESS PERMISSIONS NONE;


DEFINE INDEX cookie_release_date ON cookie FIELDS release_date;
DEFINE INDEX cookie_search_0 ON cookie FIELDS tr.en.name FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX cookie_search_1 ON cookie FIELDS tr.th.name FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);
DEFINE INDEX cookie_search_2 ON cookie FIELDS tr.en.abilities FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX cookie_search_3 ON cookie FIELDS tr.th.abilities FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);
DEFINE INDEX cookie_search_4 ON cookie FIELDS tr.en.description FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX cookie_search_5 ON cookie FIELDS tr.th.description FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);

DEFINE EVENT cookie_gram ON cookie WHEN ($after.tr.en.name ?? '') != '' THEN { FOR $g IN (SELECT VALUE gram FROM name_gram WHERE section = 'cookie' AND entity_id = record::id($after.id)) { DELETE name_gram WHERE section = 'cookie' AND gram = $g AND entity_id = record::id($after.id) }; FOR $g IN array::windows(array::filter(string::split(string::lowercase($after.tr.en.name), ''), |$c: any| $c != ''), 3).map(|$w: any| array::join($w, '')) { CREATE name_gram SET gram = $g, section = 'cookie', entity_id = record::id($after.id) }; };

-- ------------------------------
-- TABLE DATA: cookie
-- ------------------------------

INSERT [ { grade: 1, id: cookie:1, image: 'gingerbrave.png', rank: 0, release_date: 1364860800, tr: { en: { abilities: 'Not just a running Cookie. He can Jump, Double Jump, and Slide, too!', description: "GingerBrave was the first Cookie to escape from the Witch's oven. It is unknown how this Cookie came to life, but rumor has it that the Witch accidentally used magic powder instead of ginger powder. Level up for more HP.", name: 'GingerBrave', power_plus: '', power_plus_requirement: '', unlock_goal: 'Available from the start' }, th: { abilities: 'กล้าหาญ', description: 'ไม่มีใครกล้าหาญไปกว่าเขาแล้ว!', name: 'คุกกี้ผู้กล้าหาญ', power_plus: '', power_plus_requirement: '', unlock_goal: 'ปลดล็อกอัตโนมัติ' } } }, { grade: 2, id: cookie:2, image: 'strawberry_cookie.png', rank: 1, release_date: 1364860800, tr: { en: { abilities: 'Longer Bonus Time.', description: "As shy as a Cookie can get, Strawberry Cookie prefers hanging out in Bonus Time to all the running. She'd stay there forever if she could.", name: 'Strawberry Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 3 friends' }, th: { abilities: 'Slows HP drain (up to 17%)', description: 'ลดอัตราการสูญเสียพลังชีวิต (สูงสุด 17%)\n\nคุกกี้รสสตรอเบอร์รี่ขี้อายสุดขีด ชอบโบนัสไทม์มากกว่าการวิ่งทั้งหมด เธออยากอยู่ตรงนั้นตลอดไปถ้าทำได้', name: 'คุกกี้รสสตรอเบอร์รี่', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี เพื่อน 3 คน' } } }, { grade: 1, id: cookie:3, image: 'gingerbright.png', rank: 0, release_date: 1364860800, tr: { en: { abilities: 'Earns more XP (up to 12%).', description: "Maybe the Witch thought [[cookie:1]] seemed lonely all by himself, because she baked GingerBright with the leftover dough from making [[cookie:1]]. Sweet and bubbly GingerBright is full of life. But this smart Cookie clearly knows that it would be a bad idea to offer her lollipop to [[cookie:1]]! She's so smart, she even found a way to get extra XP every time.", name: 'GingerBright', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach 30,000 points' }, th: { abilities: 'Earns more XP (Up to 12% more)', description: 'ได้รับเอ็กซ์พีเพิ่มขึ้น (สูงสุด 12%)\n\n<tabber> |-|Classic=บางทีแม่มดอาจคิดว่า คุกกี้ไบรท์ดูเหงาเกินไปเมื่ออยู่เพียงลำพัง เพราะเธออบคุกกี้ไบรท์ด้วยแป้งที่เหลือจากการทำคุกกี้เบรฟ คุกกี้ไบรท์ผู้ร่าเริงและอ่อนหวานเต็มไปด้วยชีวิตชีวา แต่คุกกี้ที่ฉลาดคนนี้รู้ดีว่าการเสนออมยิ้มของเธอให้คุกกี้เบรฟนั้นเป็นความคิดที่ไม่ดี! เธอฉลาดมาก จนถึงกับหาวิธีได้รับเอ็กซ์พีพิเศษได้ทุกครั้ง |-|India/LINE=เธอเป็นทั้งขนมปังขิงครึ่งหนึ่งและสมองอีกครึ่งหนึ่ง การวิ่งเป็นหนทางหนึ่งที่จะหนีปัญหา แต่เธอมีวิธีแก้ปัญหาอีกนับล้านวิธี เธอฉลาดมากจนหาวิธีได้รับเอ็กซ์พีพิเศษได้ทุกครั้ง<ref group="note">คำบรรยายภาษาอังกฤษของคุกกี้ไบรท์ในเวอร์ชัน LINE เป็นการแปลท้องถิ่นที่คลาดเคลื่อนอย่างมากจากต้นฉบับภาษาเกาหลีใน Cookie Run for Kakao และการแปลที่ถูกต้องของข้อความดังกล่าวปรากฏใน Cookie Run Classic ดูส่วน Trivia</ref> |-|Kakao=คุกกี้สาวผู้ร่าเริงสดใสราวกับรสชาติที่ชุ่มฉ่ำ เมื่อเห็นว่า[[cookie:1]]ดูเหงาเมื่ออยู่เพียงลำพัง แม่มดจึงนำแป้งที่เหลือมาอบเป็นคุกกี้สาวผู้ร่าเริงนี้ คุกกี้ที่ฉลาดมากคนนี้ไม่มีวันเสนออมยิ้มของตัวเองให้[[cookie:1]]แน่นอน ว่ากันว่าเมื่อวิ่งเสร็จจะได้รับประสบการณ์เพิ่มเติม </tabber>', name: 'คุกกี้สาวผู้ร่าเริง', power_plus: '', power_plus_requirement: '', unlock_goal: 'ทำคะแนนถึง 30,000 แต้ม' } } }, { grade: 3, id: cookie:4, image: 'ginger_claus.png', rank: 2, release_date: 1387497600, tr: { en: { abilities: '+13% Coins, +3% XP', description: "It's the Cookie you can meet after being a good child for the whole year. It is said that this Cookie was baked in a faraway land and crawled into the oven through the Witch's chimney. Ginger Claus loves giving presents more than receiving them and goes around handing out special, but pretty odd gifts for everyone.", name: 'Ginger Claus', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 125 friends' }, th: { abilities: '13-20% Coin Bonus, 3-10% XP Bonus.', description: 'โบนัสเหรียญ 13-20% โบนัสเอ็กซ์พี 3-10%\n\nเป็นคุกกี้ที่คุณจะพบได้เมื่อเป็นเด็กดีตลอดทั้งปี ว่ากันว่าถูกอบในดินแดนอันไกลโพ้นและคลานเข้าเตาอบผ่านปล่องไฟของแม่มด คุกกี้นี้ชอบให้ของขวัญมากกว่ารับ และไปแจกของขวัญพิเศษที่แปลกประหลาดไม่น้อยให้กับทุกคน', name: 'คุกกี้ซานต้า', power_plus: '', power_plus_requirement: '', unlock_goal: 'ปลดล็อกเมื่อเก็บระฆังทอง 400 อัน' } } }, { grade: 2, id: cookie:5, image: 'cloud_cookie.png', rank: 1, release_date: 1364860800, tr: { en: { abilities: 'Increases Power Jelly duration (up to 35%).', description: "\"I dance cuz life's a party and we each make our own funky beat,\" she likes to say. Her dream is to dance in the clouds. Cloud Cookie's energetic persona makes Power Jellies last longer.", name: 'Cloud Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 5 Pets' }, th: { abilities: 'Increases Power Jelly duration (up to 35%)', description: 'เพิ่มระยะเวลาของพาวเวอร์เยลลี่ (สูงสุด 35%)\n\n"ฉันเต้นเพราะชีวิตคือปาร์ตี้ และเราแต่ละคนก็สร้างจังหวะสนุกๆ ของตัวเอง" เธอชอบพูดแบบนั้น ความฝันของเธอคือการเต้นรำบนก้อนเมฆ บุคลิกสุดคึกคักของคุกกี้รสเมฆทำให้พาวเวอร์เยลลี่คงอยู่นานขึ้น', name: 'คุกกี้รสเมฆ', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยง 5 ตัว' } } }, { grade: 2, id: cookie:6, image: 'buttercream_choco_cookie.png', rank: 1, release_date: 1364860800, tr: { en: { abilities: 'More Coins (up to 25%)', description: "They don't call him \"Rich\" without reason - Buttercream Choco Cookie knows how to handle his Coins, with positive return on all investments. He wouldn't share his secret, but a source tells us he is particularly into renewable energy.", name: 'Buttercream Choco Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach 180,000 points' }, th: { abilities: 'ได้รับเหรียญมากขึ้น', description: 'ได้รับเหรียญมากขึ้น (สูงสุด 25%)\r\n\r\nสมกับฉายา "รวย" คุกกี้บัตเตอร์ครีมช็อกโก้รู้วิธีจัดการเหรียญของเขา ด้วยผลตอบแทนที่เป็นบวกจากการลงทุนทุกครั้ง เขาไม่ยอมแบ่งปันความลับ แต่แหล่งข่าวบอกเราว่าเขาชอบพลังงานสะอาดเป็นพิเศษ', name: 'คุกกี้ช็อคโก้ครีมเนย', power_plus: '', power_plus_requirement: '', unlock_goal: 'ทำคะแนน 180,000 แต้ม' } } }, { grade: 4, id: cookie:7, image: 'ninja_cookie.png', rank: 3, release_date: 1364860800, tr: { en: { abilities: 'Multi Jump (up to 10)', description: "Just as making perfect dough demands diligent kneading, tireless training is of equal importance on the path of the ninja. The flavor and ingredients of the mysterious Ninja Cookie remain unknown. The secret to his multi jumps is unknown. Some say he steps on the air itself, others claim he is using some sort of shadow clone technique... And by leveling up his training, he can multi jump even more! The sky's the limit, literally.", name: 'Ninja Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach 600,000 points' }, th: { abilities: 'กระโดดหลายครั้ง', description: 'เมื่ออัปเกรด เขาสามารถกระโดดกลางอากาศได้สูงสุด 10 ครั้ง\r\n\r\nไม่มีคุกกี้ใดเข้าใจความสำคัญของการฝึกซ้อมได้ดีไปกว่าคุกกี้นินจา แต่นั่นเป็นเพียงการฝึกซ้อมจริงหรือ? ความลับของการกระโดดหลายชั้นของเขายังไม่มีใครรู้ บางคนบอกว่าเขาเหยียบสายลม บางคนอ้างว่าเขาไม่ใช่คุกกี้ธรรมดา ยิ่งระดับสูง เขาก็ยิ่งกระโดดได้มากขึ้น', name: 'คุกกี้นินจา', power_plus: '', power_plus_requirement: '', unlock_goal: 'LINE: ทำคะแนน 600,000 แต้ม' } } }, { grade: 3, id: cookie:8, image: 'princess_cookie.png', rank: 2, release_date: 1364860800, tr: { en: { abilities: 'Less HP loss when colliding with an obstacle (up to 50%)', description: "Don't be fooled by her adorable smile and cute hairdo. If you imagined a graceful and regal princess, think again! She may be far from elegant, but it's hard not to fall in love with this mischievous Cookie and her whipped cream petticoat, which shields her from many dangers.", name: 'Princess Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Jelly Upgrade Lv.15' }, th: { abilities: 'Less Energy loss when colliding with an obstacle (Up to 50%).', description: 'สูญเสียพลังงานน้อยลงเมื่อชนอุปสรรค (สูงสุด 50%)\n\nแก้วตาดวงใจของราชวงศ์ เธอได้ทุกอย่างที่ต้องการเสมอ อย่าหลงกลรอยยิ้มน่ารักและทรงผมสวยๆ นะ คุกกี้เจ้าหญิงผ่านการฝึกศิลปะการต่อสู้อย่างจริงจังมาตั้งแต่เด็ก เธอไม่กลัวอะไร เพราะรู้ดีว่ากระโปรงวิปครีมของเธอแข็งแกร่งราวกับโล่', name: 'คุกกี้เจ้าหญิง', power_plus: '', power_plus_requirement: '', unlock_goal: 'ได้รับเยลลี่เลเวล 15' } } }, { grade: 3, id: cookie:9, image: 'knight_cookie.png', rank: 2, release_date: 1364860800, tr: { en: { abilities: 'Runs faster and longer after collecting Blast Jellies. (Counts as a riding skill.)', description: 'Armed with white chocolate reinforced by steamed milk, Knight Cookie is a knight in shining armor. If you want to see him at his mightiest, simply collect a Blast Jelly and watch him ride his trusty horse. You can always count on this devoted Cookie, for he will never let you down. If only he could express his true feelings as freely as he wields his lance.', name: 'Knight Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'HP Upgrade Lv.15' }, th: { abilities: 'Special Blast', description: 'วิ่งเร็วขึ้นและนานขึ้นหลังจากเก็บพุ่งเยลลี่\n\nติดอาวุธด้วยไวท์ช็อกโกแลตเสริมฟองนม คุกกี้อัศวินคือตำนานที่มีชีวิต ว่ากันว่าเขาสู้กับมังกรเพื่อออกกำลังกาย เรียกม้าจากอากาศธาตุ และขี่ได้เร็วและนานกว่าอัศวินคนใดในประวัติศาสตร์ของคุกกี้', name: 'คุกกี้อัศวิน', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงพลังงานเลเวล 15' } } }, { grade: 3, id: cookie:10, image: 'coffee_cookie.png', rank: 2, release_date: 1364860800, tr: { en: { abilities: 'Increases HP recovery from potions (up to 29%).', description: 'A classic city slicker Cookie, Coffee Cookie refuses to start the day without a cup of coffee. She loves meeting up with friends, shopping for designer bags, and pilates. Infused with strong coffee, she recovers faster with each Energy Potion.', name: 'Coffee Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.15' }, th: { abilities: 'Recovers up to 29% more Energy from Potions.', description: 'ฟื้นฟูพลังงานจากโพชันเพิ่มขึ้นสูงสุด 29%\n\nตัวอย่างคลาสสิกของคุกกี้ชาวเมือง เธอปฏิเสธที่จะเริ่มต้นวันใหม่โดยไม่ดื่มกาแฟสักแก้ว เธอชอบพบปะเพื่อนฝูง ช้อปปิ้งกระเป๋าดีไซเนอร์ และเล่นพิลาทิส ด้วยความเข้มข้นของกาแฟ เธอจึงฟื้นตัวได้เร็วกว่ากับโพชันพลังงานทุกอัน', name: 'คุกกี้รสกาแฟ', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 15' } } }, { grade: 3, id: cookie:11, image: 'skater_cookie.png', rank: 2, release_date: 1474934400, tr: { en: { abilities: 'Faster base speed (up to 35%)', description: "The secret to Skater Cookie's speed and boarding skills lies in the special elasticity of his Cat Tail Candy Cane Board. Inseparable from his 2009 limited edition board, he even sleeps on it too! Not everyone can handle Skater Cookie's speed, but if you dare, prepare for a sweet ride. Warning: Once you get a taste of Skater Cookie's speed, other Cookies may feel a bit slow.", name: 'Skater Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach 300,000 points' }, th: { abilities: 'Faster base speed (up to 35%)', description: "The secret to Skater Cookie's speed and boarding skills lies in the special elasticity of his Cat Tail Candy Cane Board. Inseparable from his 2009 limited edition board, he even sleeps on it too! Not everyone can handle Skater Cookie's speed, but if you dare, prepare for a sweet ride. Warning: Once you get a taste of Skater Cookie's speed, other Cookies may feel a bit slow.", name: 'Skater Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach 300,000 points' } } }, { grade: 4, id: cookie:12, image: 'angel_cookie.png', rank: 3, release_date: 1364860800, tr: { en: { abilities: 'Draws in Items with magnetic aura', description: "Angel Cookie is trying to master the art of flying but can't rise higher than a teeny tiny bit above the ground just yet! Angel Cookie's favorite animals are penguins, ostriches, and baby chicks. Can you guess why? Shiny golden curls are the source of the Cookie's special Magnetic Aura, which attracts all Coins and Jellies nearby. Yum!", name: 'Angel Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.30' }, th: { abilities: 'Magnetic Aura', description: 'ล้อมรอบด้วยสนามแม่เหล็ก ซึ่งแข็งแกร่งขึ้นเมื่ออัปเกรด\r\n\r\nคุกกี้แองเจิลยังเป็นทารก เธอกำลังฝึกฝนศิลปะการบินอย่างช้าๆ ตอนนี้เธอลอยขึ้นจากพื้นได้เพียงหนึ่งนิ้ว เธอบินไม่ได้เพราะปีกยังโตไม่เต็มที่ ไม่ใช่เพราะหัวที่ใหญ่เกินสัดส่วน (ตามที่คุกกี้บางตัวอ้าง) แต่สนามแม่เหล็กของเธอแข็งแกร่งสุดขีด เก็บเยลลี่และเหรียญที่อยู่ใกล้เคียงได้อย่างง่ายดาย', name: 'คุกกี้นางฟ้า', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 30' } } }, { grade: 3, id: cookie:13, image: 'zombie_cookie.png', rank: 2, release_date: 1364860800, tr: { en: { abilities: 'Revives after running out of HP (up to 8 times with 17 HP)', description: 'Zombie Cookie was thoroughly underbaked and slopped carelessly with strawberry jam and melted chocolate. But you see, the key ingredient for Zombie Cookie is a pinch of zombie cells to the dough. And no need to worry about getting your own zombie cells! They can be easily acquired at the local cemetery and come without an expiration date, so they can be stored basically forever. Zombie cookie can revive easily and is really only worried about falling into pits.', name: 'Zombie Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 50 Friends' }, th: { abilities: 'Revives after running out of Energy up to 8 times (every time 17~30 energy) with upgrades.', description: 'ฟื้นคืนชีพเมื่อพลังงานหมดได้สูงสุด 8 ครั้ง (ครั้งละ 17~30 พลังงาน) เมื่ออัปเกรด\n\nทำจากส่วนผสมที่ขึ้นรา คุกกี้ซอมบี้ถูกอบอย่างไม่ทั่วถึงและราดแยมสตรอว์เบอร์รีกับช็อกโกแลตละลายอย่างเลอะเทอะ เนื่องจากฟื้นคืนชีพได้ง่าย เขาจึงกังวลเพียงเรื่องการตกลงไปในหลุมเท่านั้น', name: 'คุกกี้ซอมบี้', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี เพื่อน 50 คนจากกิจกรรมเชิญเพื่อนระยะเวลาจำกัด' } } }, { grade: 2, id: cookie:14, image: 'cream_cookie.png', rank: 1, release_date: 1364860800, tr: { en: { abilities: 'Slows HP drain (up to 17%).', description: "A delicious mix of cookie and cream, she enjoys knitting in front of a warm oven. Years of running taught her to manage the scarce HP pool well, so even though she prefers knitting in the warmth of the Oven, once she gets running, she doesn't tire easily.", name: 'Cream Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.8' }, th: { abilities: 'Slows HP drain (up to 17%)', description: 'ลดอัตราการสูญเสียพลังชีวิต (สูงสุด 17%)\n\n<tabber> |-|Classic= คุกกี้เนื้อเนียนผสมครีมอันโอชะ เธอชอบถักนิตติ้งหน้าอบอุ่นของเตาอบ ปีแห่งการวิ่งสอนให้เธอจัดการพลังงานอันน้อยนิดได้เป็นอย่างดี ถึงแม้เธอจะชอบถักนิตติ้งในความอบอุ่นของเตาอบ แต่เมื่อเริ่มวิ่งแล้วเธอก็ไม่เหนื่อยง่ายๆ |-|LINE= คุกกี้เนื้อเนียนผสมครีมอันโอชะ เธอชอบถักนิตติ้งหน้าอบอุ่นของเตาอบ ปีแห่งการวิ่งสอนให้เธอจัดการพลังงานอันน้อยนิดได้เป็นอย่างดี และถึงแม้จะป่วยเป็นโรคข้ออักเสบขั้นรุนแรง เธอก็ยังเป็นคู่แข่งที่น่าเกรงขามสำหรับเหล่าหนุ่มสาวทุกคน </tabber>', name: 'คุกกี้รสคุกกี้แอนด์ครีม', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 8' } } }, { grade: 3, id: cookie:15, image: 'muscle_cookie.png', rank: 2, release_date: 1364860800, tr: { en: { abilities: 'Chance to crush obstacles on collision (up to 75%)', description: "Muscle Cookie's recipe requires protein powder and 3 weeks of powerful kneading. Only after that, the muscles come to life. Such a rigorous baking process has prepared him to push through most obstacles without losing HP. Leveling up will strengthen his crust even more.", name: 'Muscle Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach 450,000 points' }, th: { abilities: 'Invincible to obstacles when hitting them, up to 75% of time with upgrades.', description: 'ไร้เทียมทานต่ออุปสรรคเมื่อชน สูงสุด 75% ของเวลาด้วยการอัปเกรด\n\nสูตรของคุกกี้มัสเซิลต้องใช้ผงโปรตีนและนวดแป้งอย่างน้อย 3 สัปดาห์ (ยิ่งนานยิ่งดี) กระบวนการปรุงอันเคร่งครัดเช่นนี้ทำให้เขาฝ่าอุปสรรคส่วนใหญ่ได้โดยไม่เสียพลังงาน การอัปเกรดอย่างสม่ำเสมอจะทำให้เปลือกของเขาแข็งแกร่งยิ่งขึ้น', name: 'คุกกี้นักกล้าม', power_plus: '', power_plus_requirement: '', unlock_goal: 'ทำคะแนน 450,000 แต้ม' } } } ];
INSERT [ { grade: 4, id: cookie:16, image: 'pirate_cookie.png', rank: 3, release_date: 1364860800, tr: { en: { abilities: 'Revives as Ghost Pirate (with up to 160 HP)', description: "Seaweed obtained from the roughest and deepest ocean waters was dried, powdered, and then added into the dough. Wine or rum is a must if you wish to get rid of the oceany odor. Don't use too much, or you'll be left with a bitter taste instead! In his travels, Pirate Cookie has learned a miraculous ability to revive as a ghost after death. In his ghostly form, Pirate Cookie walks right through obstacles, but alas, is unable to pick up any HP Potions.", name: 'Pirate Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 100 Friends' }, th: { abilities: 'After running out of Energy, revives as Ghost Pirate with up to 160 Energy.', description: 'หลังจากพลังงานหมด จะฟื้นคืนชีพเป็นคุกกี้ผีโจรสลัดด้วยพลังงานสูงสุด 160\n\nน้ำทะเลและเหล้ารัมเป็นส่วนผสมสำคัญของคุกกี้โจรสลัด เขาอาจดูแข็งกร้าว แต่แท้จริงแล้วเป็นคนโรแมนติกสิ้นหวัง ในร่างผี คุกกี้โจรสลัดเดินทะลุอุปสรรคได้ แต่อนิจจา ไม่สามารถเก็บโพชันพลังงานได้เลย', name: 'คุกกี้โจรสลัด', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี เพื่อน 100 คน' } } }, { grade: 4, id: cookie:17, image: 'skating_queen_cookie.png', rank: 3, release_date: 1368230400, tr: { en: { abilities: 'Earns Performance Points for Double Jumps, Blast Jellies, and Bonus Time.', description: 'It is true that only top quality ingredients were used to bake this Cookie, but that never stopped her from giving her best at exhausting rehearsals. Her unparalleled discipline and practice are what gave the finishing touch to the Cookie we know today. Her graceful performances never fail to receive extra points. Other Cookies simply pale in comparison.', name: 'Skating Queen Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.45' }, th: { abilities: 'Figure Skating', description: 'คะแนนพิเศษสำหรับการกระโดดสองชั้น พุ่งเยลลี่ และโบนัสไทม์ คะแนนจะเพิ่มขึ้นทุกครั้งที่อัปเกรดและสูงได้มาก\n\nส่วนผสมระดับพรีเมียม การซ้อมอันเหน็ดเหนื่อย และวินัยที่ไร้เทียมทาน หล่อหลอมให้เป็นคุกกี้ที่เรารู้จักในวันนี้ เธอได้คะแนนพิเศษจากการแสดงที่สมบูรณ์แบบทั้งเทคนิคและการนำเสนอ จนคนอื่นๆ ซีดเซียวเมื่อเทียบกัน สวยงามทุกรายละเอียด', name: 'คุกกี้ราชินีสเก็ตลีลา', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 35' } } }, { grade: 4, id: cookie:18, image: 'hero_cookie.png', rank: 3, release_date: 1368230400, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Hero Cookie puts on his Caramel Syrup Suit for a flying Blast with magnetic effect and slower HP drain.', description: "While the other Cookies escaped the hot oven one by one, this Cookie remained inside, lost in his research. He was brilliant enough to finally succeed in building an ultimate escaping machine, the Caramel Syrup Suit. The suit is optimized for escape with a rechargeable Candy Engine as its core source of energy. Now, the only task left is to continue his studies to reduce Candy Engine's recharge time.", name: 'Hero Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 150 Friends' }, th: { abilities: 'Hero Mode', description: 'เมื่อเกจพลังเต็ม คุกกี้จะแปลงร่างเป็นซูเปอร์ฮีโร่ ซึ่งบินด้วยพุ่งและไร้เทียมทาน (ระหว่างโหมดฮีโร่ คุณสามารถบินความเร็วสูงแบบไร้เทียมทานและได้รับออร่าแม่เหล็ก)\n\nหลังจากการศึกษาหลายชั่วโมง ในที่สุดเขาก็ประสบความสำเร็จในการสร้างชุดซูเปอร์แคราเมลไซรัป ออกแบบมาเพื่อการหลบหนีอย่างเหมาะสม ด้วยเครื่องยนต์แคนดี้ที่ชาร์จได้และพลังจรวด การอัปเกรดจะลดเวลาที่ต้องใช้ในการชาร์จเครื่องยนต์เต็ม', name: 'คุกกี้ฮีโร่', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี เพื่อน 120 คน' } } }, { grade: 4, id: cookie:19, image: 'cheerleader_cookie.png', rank: 3, release_date: 1373587200, tr: { en: { abilities: 'A cheerleader squad comes to help after every 32 jumps, crushing obstacles and spreading Coins and Jellies. Leveling up reduces the number of jumps needed and increases the time for the squad.', description: "Fresh lemon juice and mints were used to bake Cheerleader Cookie. Her sunny and cheerful personality energizes Cookie crowds better than anything else. Rumor has it that she takes energy drink showers to refresh her dough and soul. Now that's refreshing!", name: 'Cheerleader Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 12 Pets at Lv.8' }, th: { abilities: 'Cheer Squad', description: 'ทีมเชียร์ลีดเดอร์จะมาช่วยหลังจากกระโดด 18-32; 18 ครั้ง (สำหรับเลเวล 8 ของคุกกี้เชียร์ลีดเดอร์ จำนวนการกระโดดจะเปลี่ยนไปตามเลเวล ดูตารางสถิติเพื่อดูจำนวนการกระโดดที่ต้องใช้) ทำลายอุปสรรคและกระจายเหรียญกับเยลลี่ การอัปเกรดจะลดจำนวนการกระโดดที่ต้องใช้และทำให้ทีมอยู่กับคุณนานขึ้น\r\n\r\nบุคลิกสดใสร่าเริงของเธอเติมพลังให้ฝูงคุกกี้ได้ดีกว่าสิ่งใด มีข่าวลือว่าเธออาบน้ำพลังงานดื่มและดื่มแต่น้ำมะนาว', name: 'คุกกี้เชียร์ลีดเดอร์', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยง 12 ตัว' } } }, { grade: 4, id: cookie:20, image: 'special_force_cookie.png', rank: 3, release_date: 1371859200, tr: { en: { abilities: 'Shoots star candies that crush some obstacles and, when collected, earn points. More obstacles can be crushed with each upgrade.', description: 'Armed with a sweet candy gun, Special Force Cookie passed special force training with flying colors and joined the Cookie Intelligence Agency shortly after. Her mission is classified, but likely involves escaping from the oven first.', name: 'Special Force Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 10 Cookies at Lv.8' }, th: { abilities: 'Candy Defense', description: 'ยิงสตาร์แคนดี้ที่ทำลายอุปสรรคบางส่วน และเมื่อเก็บได้จะได้รับคะแนน อุปสรรคจะถูกทำลายได้มากขึ้นทุกครั้งที่อัปเกรด\n\n<center>ติดอาวุธด้วยปืนแคนดี้แสนหวาน คุกกี้ผ่านการฝึกหน่วยรบพิเศษอย่างยอดเยี่ยมและเข้าร่วมหน่วยสืบราชการลับคุกกี้ในเวลาต่อมา ภารกิจของเธอเป็นความลับ แต่คงเกี่ยวข้องกับการหนีออกจากเตาอบเป็นอย่างแรก</center>', name: 'คุกกี้หน่วยรบพิเศษ', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้เลเวลสูงสุด 10 ตัว' } } }, { grade: 4, id: cookie:21, image: 'rebel_cookie.png', rank: 3, release_date: 1379116800, tr: { en: { abilities: 'Can perform 3 Multi Jumps and instantly land when tapping Slide in the air. Earns extra points for multi jumps. Revives as Cloud Decoy. Cloud Decoy does not collide with obstacles but cannot pick up HP potions, either. (Leveling up increases number of multi jumps and HP of Cloud Decoy)', description: 'An organic Cookie made of rice that makes you feel healthy only by looking at him. Rebel Cookie mastered sorcery on his own and can do up to 10 jumps without touching the ground. He is popular among Cookies for stealing from the Witch and sharing with the poor.', name: 'Rebel Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 120 friends' }, th: { abilities: 'Instant landing when pressing SLIDE after a 3-10 multi-step jump.', description: 'ลงจอดทันทีเมื่อกดสไลด์หลังการกระโดดหลายชั้น 3-10 ครั้ง\n\nคุกกี้ออร์แกนิกทำจากข้าว ที่ทำให้รู้สึกสุขภาพดีเพียงแค่มอง เขาศึกษาเวทมนตร์ด้วยตัวเองและกระโดดได้สูงสุด 10 ชั้น เขาเป็นที่นิยมในหมู่คุกกี้เพราะขโมยของของแม่มดมาแบ่งปันให้คนอื่น', name: 'คุกกี้จอมโจรคุณธรรม', power_plus: '', power_plus_requirement: '', unlock_goal: 'ปลดล็อก [[pet:28]] (Line)\nมีเพื่อน 120 คน (Kakao)' } } }, { grade: 4, id: cookie:22, image: 'devil_cookie.png', rank: 3, release_date: 1377820800, tr: { en: { abilities: 'Transforms into an all-consuming Super Devil after collecting Spirit Jellies. By leveling up, fewer Spirit Jellies are required to trigger the transformation.', description: "Devil Cookie is mysterious in many ways. This Cookie might look hot and spicy but tastes like fizzy cola. According to a trustworthy source, they are made of bat extract and a few drops of carbonated beverage. Devil Cookie's ultrasonic powers allow them to see flying Spectral Jellies invisible to the others. Catching those Jellies unleashes the feared Super Devil.", name: 'Devil Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.50' }, th: { abilities: 'Super Devil Rush', description: 'แปลงร่างเป็นซูเปอร์เดวิลผู้กลืนกินทุกสิ่งหลังจากจับสปิริตเยลลี่ได้ 22~15 อัน ด้วยการอัปเกรด สปิริตเยลลี่ที่น้อยลงจะกระตุ้นการแปลงร่าง\n\nลึกลับหลายด้าน ดูเผ็ดร้อน แต่รสชาติเหมือนโคล่า เป็นผลพลอยได้จากแป้งคุกกี้แองเจิลที่สัมผัสกับเวทมนตร์มืด เขาสามารถมองเห็นสปิริตเยลลี่บินที่คุกกี้ตัวอื่นมองไม่เห็น การจับเยลลี่เหล่านั้นปลดปล่อยซูเปอร์เดวิลผู้น่าเกรงขาม', name: 'คุกกี้เดวิล', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 50' } } }, { grade: 4, id: cookie:23, image: 'kumiho_cookie.png', rank: 3, release_date: 1379116800, tr: { en: { abilities: 'Slows HP drain. Changes forms every 9 multi jumps. In Cookie form, seduces Bear Jellies to grant extra points.', description: "A fox-shaped marshmallow wished to become a Cookie so much it mastered a spell to shapeshift into a Cookie by subsisting only on flour and butter for 999 days. As a result, she can now disguise herself as a seductive and attractive Cookie. Anyone who catches even a glimpse of her will instantly fall in love. Perhaps she's dazzling them with her nine tails.", name: 'Kumiho Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.55' }, th: { abilities: 'Jelly Seduction', description: 'การกระโดดสองชั้น 9 ครั้งจะเปลี่ยนเธอเป็นนินเทลส์ ล่อลวงแบร์เยลลี่เพื่อรับคะแนนพิเศษ\r\n\r\nเดิมทีเป็นมาร์ชเมลโลว์รูปสุนัขจิ้งจอก เธอปรารถนาที่จะเป็นคุกกี้มากจนดำรงชีวิตด้วยแป้งและเนยเพียงอย่างเดียวเป็นเวลา 999 วัน พร้อมกับฝึกฝนเวทมนตร์เพื่อปลอมตัวเป็นคุกกี้ ผลลัพธ์คือตอนนี้เธอสามารถปลอมตัวเป็นคุกกี้ที่เย้ายวนและน่าหลงใหล ใครก็ตามที่ได้เห็นเธอแม้เพียงชั่วแวบเดียวจะตกหลุมรักเธอ', name: 'คุกกี้จิ้งจอกเก้าหาง', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 55' } } }, { grade: 4, id: cookie:24, image: 'wizard_cookie.png', rank: 3, release_date: 1382140800, tr: { en: { abilities: 'Casts Magic Spells that can crush obstacles and create Jellies. Leveling up reduces the time between spells.', description: "Wizard Cookie came to possess the Witch's Candy Wand by accident (or not?). Within it, he discovered unique magical powers. His popping candy ice cream cone hat is the finishing touch to his wizard look. Frequently used spells include the festive Hocus-Party-Pocus and Abra-Cookie-Cadabra, which bring unexpected luck and fun.", name: 'Wizard Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 16 Pets at Lv.8' }, th: { abilities: 'Magic Spells', description: 'ร่ายคาถาวิเศษที่สามารถทำลายอุปสรรคและสร้างเยลลี่โคนไอศกรีม การอัปเกรดจะลดเวลาระหว่างคาถา\n\nเมื่อได้ครอบครองไม้กายสิทธิ์แคนดี้ของแม่มดโดยบังเอิญ (หรือไม่บังเอิญ?) เขาค้นพบพลังเวทอันเป็นเอกลักษณ์ ซึ่งดูเหมือนจะเสริมด้วยหมวกวาฟเฟิลโคนของเขา คาถาที่ใช้บ่อยได้แก่ "MayeverydaybelikeHalloweennolessnomore" ซึ่งไม่เคยพลาดที่จะเริ่มงานเฉลิมฉลองที่นั่นที่นี่', name: 'คุกกี้พ่อมด', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยงเลเวลสูงสุด 16 ตัว' } } }, { grade: 4, id: cookie:25, image: 'fairy_cookie.png', rank: 3, release_date: 1383264000, tr: { en: { abilities: 'Creates magnetic aura which also serves as a shield', description: "With the least calories and highest fiber content, she is the healthiest Cookie of all. She can even produce oxygen, which keeps the air clean around her. She uses the energy of the forest to create a protective shield. Those who envy Fairy Cookie say she has strawberry jam of ambition inside, but you don't believe them, right?", name: 'Fairy Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 8 Treasures at +9' }, th: { abilities: 'Magnetic Shield', description: 'สร้างออร่าแม่เหล็กซึ่งทำหน้าที่เป็นโล่ด้วย\r\n\r\nด้วยแคลอรีน้อยที่สุดและไฟเบอร์สูงที่สุด เป็นคุกกี้ที่สุขภาพดีที่สุดในทั้งหมด เธอ甚至可以ผลิตออกซิเจน ซึ่งทำให้อากาศรอบตัวสะอาด พลังงานของป่าเลี้ยงโล่ปกป้องของเธอ ผู้ที่อิจฉาคุกกี้แฟรี่บอกว่าเธอมีแยมสตรอว์เบอร์รีแห่งความเย่อหยิ่งอยู่ข้างใน แต่คุณไม่เชื่อพวกเขาใช่ไหม?', name: 'คุกกี้เทพธิดา', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอัปเกรดเต็มที่ 5 ชิ้น' } } }, { grade: 4, id: cookie:26, image: 'rockstar_cookie.png', rank: 3, release_date: 1384560000, tr: { en: { abilities: 'Slide Blast releases Note Jellies that can be collected for points. Slide Blast is charged by sliding. A fully charged Slide Blast crushes nearby obstacles.', description: "Amidst all the sounds in the sizzling oven, Rockstar Cookie discovered the spirit of rock 'n' roll. He realized that in order to move the audience one must not only be talented, but give a stunning performance as well. During the ceaseless tuning of his style, he came to master his signature Slide Blast technique.", name: 'Rockstar Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 20 Treasures' }, th: { abilities: 'Slide Blast', description: 'สไลด์พุ่งปล่อยโน้ตเยลลี่ที่เก็บเป็นคะแนนได้ สไลด์พุ่งที่ชาร์จเต็มจะทำลายอุปสรรคใกล้เคียง\n\n<nowiki>เขาเป็นคุกกี้เพียงคนเดียวที่ค้นพบร็อกแอนด์โรลในเตาอบ การแสดงร็อกของเขาจะทำให้ถุงเท้าคุณหลุด ความลับที่ทำให้การแสดงของเขาน่าทึ่งคืออะไร? เขารู้ว่าการฝึกฝนทำให้สมบูรณ์แบบ ท่ามกลางการปรับปรุงสไตล์ไม่หยุดหย่อน เขาค้นพบความสามารถสไลด์พุ่ง เขาคือดาวเด่นท่ามกลางเหล่าคุกกี้</nowiki>', name: 'คุกกี้ร็อคสตาร์', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติ 20 ชิ้น' } } }, { grade: 4, id: cookie:27, image: 'cherry_cookie.png', rank: 3, release_date: 1387497600, tr: { en: { abilities: 'Throws Cherry Bombs that crush obstacles and create Cherry Jellies. Speeds up over time, but hitting an obstacle sets her back to normal speed. Leveling up grants more frequent bombs.', description: 'Behind her endearing smile and adorable looks, Cherry Cookie hides a destructive nature. A true troublemaker decorated in bright red cherry syrup, she enjoys pulling destructive pranks. She especially enjoys throwing her Cherry Bombs, which blow up like fireworks. Surprisingly, the smoke from her exploded bombs smells sweet and can relieve one of all the stress in the world.', name: 'Cherry Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 8 Treasures at +9' }, th: { abilities: 'Cherry Bomb', description: 'ขว้างเชอร์รี่บอมบ์ที่ทำลายอุปสรรคและสร้างเชอร์รี่เยลลี่ ความเร็วจะเพิ่มขึ้นจนกว่าจะชนอุปสรรค การชนอุปสรรคจะทำให้กลับสู่ความเร็วเดิม ระเบิดถี่ขึ้นเมื่ออัปเกรด\n\nตกแต่งด้วยไซรัปเชอร์รี่สดใส คุกกี้นี้ตามหาปัญหาอยู่เสมอ รูปลักษณ์น่ารักทำให้การแกล้งอันตรายของเธอคาดไม่ถึงมากขึ้น ระวังเชอร์รี่บอมบ์ที่เธอชอบขว้างไปมา', name: 'คุกกี้รสเชอร์รี่', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอัปเกรดเต็มที่ 8 ชิ้น' } } }, { grade: 4, id: cookie:28, image: 'carol_cookie.png', rank: 3, release_date: 1387497600, tr: { en: { abilities: 'Switches songs every 7 multi jumps: Song of Life recovers HP, Song of Change turns obstacles into Jellies, Song of Abundance creates Coins. Leveling up increases frequency of song effects.', description: "This gentle Cookie believes that a song can be stronger than a sword. She exerts great power with just a song of beautiful poetry and melody. \"No matter what happens, I will always have my songs. If you need more strength, I'll sing of how beautiful life can be. If obstacles bother you, I'll sing the magic Song of Change. If Coins are what you need, let me sing of abundance.\"", name: 'Carol Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.57' }, th: { abilities: 'Magic Songs', description: 'การกระโดดสองชั้น 7 ครั้งเปลี่ยนเพลงระหว่าง: เพลงแห่งชีวิต (ฟื้นฟูพลังงาน) เพลงแห่งการเปลี่ยนแปลง (เปลี่ยนอุปสรรคเป็นเยลลี่) เพลงแห่งความอุดมสมบูรณ์ (สร้างเหรียญ) เพิ่มความถี่ของเอฟเฟกต์เพลงด้วยการอัปเกรด\n\nคุกกี้ผู้อ่อนโยนเชื่อว่าเพลงแข็งแกร่งกว่าดาบ เธอปลดปล่อยพลังอันยิ่งใหญ่ด้วยเพียงเพลงที่งดงามทั้งกวีและทำนอง "ไม่ว่าจะเกิดอะไรขึ้น ฉันจะมีเพลงของฉันเสมอ ถ้าคุณต้องการพลังงาน ฉันจะร้องเพลงว่าชีวิตสวยงามเพียงใด ถ้าอุปสรรครบกวนคุณ ฉันจะร้องเพลงวิเศษแห่งการเปลี่ยนแปลง ถ้าคุณต้องการเหรียญ ให้ฉันร้องเพลงแห่งความอุดมสมบูรณ์"', name: 'คุกกี้นักดนตรี', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 57' } } }, { grade: 4, id: cookie:29, image: 'snow_sugar_cookie.png', rank: 3, release_date: 1388534400, tr: { en: { abilities: 'Summons Snow Cones that destroy obstacles and create [[pet:22]] Jellies when the small blue gauge is full. Gathering [[pet:22]] Jellies fills the green gauge. Once it is full, the Great Snow King appears and causes a snowstorm. Riding the Great Snow King restores a small amount of HP. (Great Snow King counts as a riding skill.)', description: "Made of snow, sugar, and an unknown secret ingredient, this Cookie was once very lonely, wandering through a vast snow field. One day, Snow Sugar Cookie found a magic wand that could summon snow creatures and wouldn't melt even in the oven. The Cookie quickly learned to summon friends like the Snow Cone and the Great Snow King and was never lonely again.", name: 'Snow Sugar Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 12 S Treasures' }, th: { abilities: 'Snow Friends', description: 'ทำลายอุปสรรคตามช่วงเวลาที่กำหนดด้วยการเรียกซีสโนว์โคนที่สร้างสโนว์ฟลาวเวอร์เยลลี่ การเก็บสโนว์ฟลาวเวอร์เยลลี่จะสามารถเรียกเกรทสโนว์คิงที่สร้างพายุหิมะสโนว์ฟลาวเวอร์เยลลี่ได้ พลังงานจะฟื้นฟูเล็กน้อยเมื่ออยู่บนเกรทสโนว์คิง\n\nทำจากหิมะ น้ำตาล และส่วนผสมลับ คุกกี้นี้เคยเหงามาก เดินเตร่ไปในทุ่งหิมะอันกว้างใหญ่ แล้ววันหนึ่ง เธอพบไม้กายสิทธิ์ที่สามารถเรียกสิ่งมีชีวิตจากหิมะได้ และไม่ละลายแม้ในเตาอบ คุกกี้เรียนรู้ที่จะเรียกเพื่อนอย่างซีสโนว์โคนและเกรทสโนว์คิง และไม่เคยเหงาอีกเลย', name: 'คุกกี้น้ำตาลหิมะ', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอันดับ S 12 ชิ้น' } } }, { grade: 4, id: cookie:30, image: 'pink_coco_cookie.png', rank: 3, release_date: 1392249600, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Pink Choco Cookie shoots a Heart Beam that creates Pink Bonbon Jellies and crushes obstacles. (Leveling up makes the gauge fill faster.)', description: "This Cookie spreads love far and wide with her sugary sweet Love Virus. If the world around you has suddenly become brighter, there's an unusual, but pleasant sensation in your stomach, and your cheeks just can't stop blushing, chances are that her Heart Beam has got you! However, no matter how hard she tries to fulfill her mission, she spends a lot of time all by her lonesome self. If only she were better at aiming...", name: 'Pink Coco Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 160 friends' }, th: { abilities: 'Heart Beam', description: 'สร้างพิงก์บงบงเยลลี่ ยิงฮาร์ตบีมตามช่วงเวลาที่กำหนดเพื่อทำลายอุปสรรค ฮาร์ตบีมถี่ขึ้นเมื่ออัปเกรด\n\nคุกกี้นี้แพร่ความรักไปทั่วด้วยไวรัสรักอันหวานละมุนของเธอ รอยยิ้มติดเชื้อและแก้มสีชมพูสดใสของเธอทำให้ไม่อาจต้านทานฮาร์ตบีมอันน่ารักของเธอได้ อย่างไรก็ตาม ไม่ว่าเธอจะพยายามแค่ไหนในภารกิจให้เป็นที่รักของทุกคน เธอก็ใช้เวลาอยู่กับตัวเองตามลำพังเป็นเวลานาน ถ้าเพียงแต่เธอเล็งลำแสงรักได้ดีกว่านี้', name: 'คุกกี้พิงค์ช็อกโก้', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี เพื่อน 160 คน' } } } ];
INSERT [ { grade: 4, id: cookie:31, image: 'prophet_cookie.png', rank: 3, release_date: 1393632000, tr: { en: { abilities: 'His prophecies always come true.', description: "This wizened Cookie is often called \"Fortune Cookie\" for his ability to know what's coming before it happens. His Scroll of Prophecy tells him how he should run, giving him the confidence to jump and slide his way to victory, even if it isn't always right. Some say the source of his foresight is his mysterious purple Crystal Ball, but in reality it is his majestic beard!", name: 'Prophet Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 20 Cookies at Lv.8' }, th: { abilities: 'Divination', description: 'คำทำนายของเขามักเป็นจริงเสมอ\n\nคุกกี้ผู้รอบรู้นี้มักถูกเรียกว่า "คุกกี้เสี่ยงทาย" เพราะความสามารถในการรู้ว่าอะไรจะเกิดขึ้นก่อนมันจะเกิดขึ้น ม้วนคำทำนายของเขาบอกวิธีที่เขาควรวิ่ง ทำให้เขามั่นใจที่จะกระโดดและสไลด์สู่ชัยชนะ แม้จะไม่ถูกเสมอไป บางคนบอกว่าที่มาของญาณทัศนะของเขาคือลูกแก้วสีม่วงลึกลับ แต่ทุกคนรู้ดีว่ามันมาจากเคราอันสง่างามของเขา!', name: 'คุกกี้นักพยากรณ์', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้เลเวลสูงสุด 20 ตัว' } } }, { grade: 4, id: cookie:32, image: 'pistachio_cookie.png', rank: 3, release_date: 1394841600, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Pistachio Cookie performs a long Blast. At the end of the Blast, a small amount of HP is restored. Receives minimal damage from collisions thanks to her tough shell armor, but as a result HP drain is a little faster. (Leveling up causes the gauge to fill faster.)', description: 'A purple storm cloud loomed over the forgotten pistachio forest where Pistachio Cookie was sleeping. With a sudden strike of lilac lightning, she received a divine revelation that it was her destiny to rescue the Cookies. When she awoke, she was surrounded by hundreds of Pistachio Fireflies with hard pistachio shells. She realized right then and there that now was her time to shine! She then swore to the divine and mysterious being that she would give her life to helping other Cookies. Clad in her shell armor, the healthy and deliciously nutty Pistachio Cookie then set out on her sacred mission to save her fellow Cookies from the great dangers that approached the Cookie World. Thus, Pistachio Cookie took her first step as a holy knight.', name: 'Pistachio Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.60' }, th: { abilities: 'Guardian Hero', description: 'พุ่งด้วยความเร็วสูงและไร้เทียมทานตามช่วงเวลาปกติ หลังจากการพุ่ง เธอได้รับพลังงานจากสิ่งมีชีวิตลึกลับอันศักดิ์สิทธิ์ เธอหนีการชนได้ด้วยความเสียหายน้อยที่สุดเพราะเกราะเปลือกแข็งของเธอ แต่ผลที่ตามมาคือพลังงานของเธอสูญเสียเร็วกว่าปกติเล็กน้อย (พุ่งถี่ขึ้นหลังอัปเกรด)\n\nเมฆพายุสีม่วงปกคลุมป่าที่ถูกลืมซึ่งคุกกี้รสพิสทาชิโอหลับอยู่ ทันใดนั้นเธอก็ถูกฟ้าผ่าสีม่วงอ่อน และสิ่งมีชีวิตลึกลับอันศักดิ์สิทธิ์ปรากฏแก่เธอในนิมิต บอกว่าเป็นชะตากรรมของเธอที่จะช่วยคุกกี้ทั้งหมดออกจากเตาอบ เมื่อเธอตื่นขึ้น เธอถูกรายล้อมด้วย[[pet:40]]พันตัวที่มีเปลือกพิสตาชิโอแข็ง และเธอรู้ทันทีว่านี่คือเวลาของเธอที่จะเปล่งประกาย! จากนั้นเธอสาบานต่อสิ่งมีชีวิตลึกลับอันศักดิ์สิทธิ์ว่าเธอจะอุทิศชีวิตเพื่อช่วยคุกกี้คนอื่น สวมเกราะเปลือกของเธอ คุกกี้รสพิสทาชิโอผู้แข็งแรง อร่อย และเพียบพร้อมด้วยถั่วแล้วออกเดินทางในภารกิจอันศักดิ์สิทธิ์เพื่อขจัดอันตรายจากเตาอบ นี่คือก้าวแรกของการเดินทางของคุกกี้รสพิสทาชิโอสู่การเป็นฮีโร่และนักบุญ!', name: 'คุกกี้รสพิสทาชิโอ', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 60' } } }, { grade: 4, id: cookie:33, image: 'alchemist_cookie.png', rank: 3, release_date: 1396051200, tr: { en: { abilities: 'The green gauge charges over time. When it is full, a Double Jump launches an Alchemist Flask that spawns Jellies depending on the currently selected type. Each jump landing toggles between the different types of alchemy. (Leveling up causes the gauge to fill up faster.)', description: "Made from the freshest of grapes, the fruit of the gods, this smart Cookie only cares about one thing: Research! She is always doing wild calculations, trying to figure out how to transform the elements. And she knows that being lazy or sitting idly by will achieve nothing. In order to acquire something of value, one must give something of value in return - that's Alchemist Cookie's theory at least.", name: 'Alchemist Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 11 Treasures at +9' }, th: { abilities: 'แปรธาตุ', description: 'เมื่อแถบเล่นแร่แปรธาตุสีเขียวเต็ม กระโดดสองชั้นเพื่อยิงเยลลี่พิเศษ กระโดดเพื่อสลับประเภทการเล่นแร่แปรธาตุที่ใช้ได้ (แถบเล่นแร่แปรธาตุเติมเร็วขึ้นเมื่ออัปเกรด)\r\n\r\nทำจากองุ่นสดที่สุดที่ว่ากันว่าสืบเชื้อสายมาจากสรวงสวรรค์ คุกกี้ที่ฉลาดคนนี้สนใจเพียงสิ่งเดียว นั่นคือการวิจัย! เธอไม่เพียงคำนวณมูลค่าของสสารทั้งหมดในหัวได้ เธอยังรู้ว่าต้องเติมธาตุใดเพื่อเปลี่ยนมัน! แต่เธอรู้ดีว่าความเกียจคร้านหรือการนั่งเฉยจะไม่นำไปสู่อะไร! จะได้สิ่งที่มีค่า ต้องให้สิ่งที่มีค่าตอบแทน นั่นคือทฤษฎีของคุกกี้นักแปรธาตุ', name: 'คุกกี้นักแปรธาตุ', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอัปเกรดเต็มที่ 11 ชิ้น' } } }, { grade: 4, id: cookie:34, image: 'vampire_cookie.png', rank: 3, release_date: 1397865600, tr: { en: { abilities: 'Transforms into a swift Grape Bat when the green bar is full. As a bat, Vampire Cookie can pass through obstacles, earning Evasion Points, but must keep flapping his wings to stay above the ground. Occasionally extracts Grape Juice Drops from obstacles to restore HP, but HP drain is faster. (Leveling up makes the gauge fill faster.)', description: "The Witch, busy from baking several Cookies at once, had forgotten to use her favorite high quality grapes. So, she stored them in oak barrels and let them age for a long, long time. And with that special grape juice, she made Vampire Cookie. It was difficult for Vampire Cookie to wake up at first, due to the 10% of strong grape juice in the dough. Unlike the other Cookies, he does nothing but relax and enjoy life. He wasn't even bothered by the heat of the oven and only escaped because his sister, [[cookie:33]], dragged him outside. With his pale face and smug posture, he likes to relax with a nice glass of grape juice and ponder the meaning of life.", name: 'Vampire Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 17 S Treasures' }, th: { abilities: 'Juice Bat', description: 'แปลงร่างเป็นค้างคาวน้ำผลไม้ติดปีกที่เร็วและไร้เทียมทานตามช่วงเวลาปกติ ในร่างค้างคาวน้ำผลไม้ เขาสกัดน้ำผลไม้แสนอร่อยจากอุปสรรคเป็นระยะเพื่อเพิ่มพลัง (แปลงร่างถี่ขึ้นหลังอัปเกรดและได้คะแนนพิเศษสำหรับการผ่านอุปสรรค)\n\nแม่มดกำลังยุ่งกับการทำคุกกี้พร้อมกับหมักน้ำองุ่นโปรดของเธอ แต่เธอใช้องุ่นที่สุกเกินไปและทิ้งไว้ในถังนานเกินไปนานเกินไป เธอพยายามสร้างคุกกี้รสน้ำผลไม้ แต่จากถังนั้นกลับออกมาคือคุกกี้แวมไพร์ คุกกี้ที่ทรงพลังอย่างเหลือเชื่อแต่อร่อย ด้วยความกระหายน้ำองุ่นที่ไม่อาจดับได้ เนื่องจากร่างกายของคุกกี้แวมไพร์เป็นน้ำองุ่น 10% เขาจึงออกล่าน้ำผลไม้หยดพิเศษอยู่เสมอเพื่อไม่ให้ระดับน้ำผลไม้ลดลง การออกล่าทำให้เขาตื่นดึกดื่นจนลำบากมากที่จะตื่นนอนตอนเช้า ท่าทางขี้เกียจยามเช้าของเขาอาจทำให้คุณคิดว่าเขาชอบชีวิตง่ายๆ แต่เขาเต็มไปด้วยความหลงใหล และตำนานเล่าว่าเขาเสี่ยงชีวิตเพื่อปลดปล่อย[[cookie:33]]จากถ้ำของแม่มด ทัศนคติที่มีเสน่ห์และใบหน้าหล่อเหลาแบบ rugged ทำให้เขาเป็นที่นิยมในหมู่คุกกี้สาว เมื่อไม่ได้ออกล่า เขาชอบพักผ่อนกับน้ำองุ่นเย็นๆ สักแก้วและครุ่นคิดถึงความหมายของชีวิต', name: 'คุกกี้แวมไพร์', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติเกรด S 17 ชิ้น' } } }, { grade: 4, id: cookie:35, image: 'apple_cookie.png', rank: 3, release_date: 1398902400, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Apple Cookie creates Alphabet Jelly Bubbles. (Some of the Bubbles are empty.) Enters a special Bonus Time where Balloon Jellies appear. Runs faster at first, but slows down when losing HP. (Leveling up makes Alphabet Jelly Bubbles appear more frequently.)', description: "A Cookie that resembles a crisp, refreshing spring morning! This cute little Cookie loves apple-shaped balloons and alphabet bubbles. No other Cookie can rival her powerful yet innocent creativity and brilliant imagination. She even created her own Bonus Time to play to her heart's content. Like any other youngster Cookie, she runs like there's no tomorrow at first. But after all that energetic running, little by little, she slows down when tiring out.", name: 'Apple Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'HP Upgrade Lv.50' }, th: { abilities: 'Alphabet Jelly Bubbles', description: '<tabber>\n\n<tabber> |-|India= คุกกี้ตัวน้อยน่ารักชวนให้นึกถึงเดือนพฤษภาคมอันสดชื่น คุกกี้แอปเปิ้ลชอบฟองสบู่ตัวอักษรและลูกโป่งรูปแอปเปิ้ล ด้วยจินตนาการที่คุกกี้ตัวโตไม่มีใครเทียบได้ เธอสร้างโบนัสไทม์ของตัวเองขึ้นมา ที่ซึ่งเธอสนุกที่สุดในโลก เช่นเดียวกับเด็กส่วนใหญ่ เธอเริ่มวิ่งเร็วด้วยความตื่นเต้นแต่ช้าลงเมื่อพลังหมด |-|LINE= คุกกี้ตัวน้อยน่ารักคนนี้ชอบลูกโป่งรูปแอปเปิ้ลและฟองสบู่ตัวอักษร ไม่มีคุกกี้ตัวไหนเทียบความสร้างสรรค์อันบริสุทธิ์อันทรงพลังของเธอได้ เธอถึงกับสร้างโบนัสไทม์ของตัวเองเพื่อเล่นอย่างเต็มที่ เช่นเดียวกับเด็กคนอื่นๆ เธอวิ่งอย่างบ้าคลั่งในตอนแรกและช้าลงเมื่อเหนื่อย </tabber>', name: 'คุกกี้รสแอปเปิ้ล', power_plus: '', power_plus_requirement: '', unlock_goal: '*ถึงพลังงานเลเวล 50 (Kakao, LINE)\n*ถึงโบนัสไทม์เลเวล 22 (India)' } } }, { grade: 4, id: cookie:36, image: 'cheesecake_cookie.png', rank: 3, release_date: 1400889600, tr: { en: { abilities: 'Gathering 18 Invitation Jellies triggers a Coin Fireworks Party.', description: "This flavorful Cookie is made out of an entire cheesecake. Since she has never known a life without Coins, she likes to throw luxurious parties and set off Coin Fireworks for her friends. She's always stylish, using only the finest cheese, as she casually trots along. It's hard to resist the temptation to devour this deliciously decadent Cookie.", name: 'Cheesecake Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 24 Pets' }, th: { abilities: 'Coin Firework Party', description: 'ปาร์ตี้พลุเหรียญจะถูกปล่อยเมื่อได้รับเยลลี่คำเชิญ 16-23 อัน\r\n\r\nเป็นคุกกี้รสชาติเข้มข้นที่ทำจากชีสเค้กทั้งชิ้น เนื่องจากเธอไม่เคยมีปัญหาด้านเงินตอนโต เธอชอบจัดปาร์ตี้หรูหราและจุดพลุเหรียญให้เพื่อนๆ ของเธอ เธอรวยในรสชาติไม่แพ้คุกกี้บัตเตอร์ครีมช็อกโก้ และชอบรักษาสไตล์ขณะวิ่งเหยาะๆ อย่างสบายใจ เป็นการยากที่จะต้านทานสิ่งล่อใจที่จะกลืนกินคุกกี้แสนอร่อยน่าหลงใหลนี้', name: 'คุกกี้รสชีสเค้ก', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยง 24 ตัว' } } }, { grade: 4, id: cookie:37, image: 'adventurer_cookie.png', rank: 3, release_date: 1406764800, tr: { en: { abilities: 'Discovers secret doors to an underground passage filled with Coins and possibly a Mystery Box.', description: "For a long time, there have been only rumors of Adventurer Cookie's travels far and wide beyond the realm of the Witch, but now he's back and ready to guide the other Cookies into uncharted territories of an exciting new world. Adventurer Cookie has got quite a lot of stories to tell: about a legendary dragon, a kingdom in ruins, but... So little time! His thirst for the unknown is unquenchable, and he will continue to roam the wide world as long as possible.", name: 'Adventurer Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 200 friends' }, th: { abilities: 'Hidden Ruins Exploration', description: 'เขาสามารถเปิดประตูลับไปยังทางเดินใต้ดินที่เต็มไปด้วยเหรียญ และถ้าโชคดี ก็เป็นกล่องปริศนา\n\nคุกกี้นี้เดินทางไปทั่วดินแดนอันไกลโพ้น เหนืออาณาจักรของแม่มด คุกกี้ตัวอื่นคิดว่าเขาเป็นตำนาน แต่เขากลับมาแล้ว และจะนำผู้อื่นไปสู่ดินแดนที่ไม่เคยรู้จักของโลกใหม่ที่น่าตื่นเต้น ความกระหายในสิ่งที่ไม่รู้ของเขาไม่มีวันดับ และจะท่องไปในโลกกว้างตราบเท่าที่ทำได้', name: 'คุกกี้นักสำรวจ', power_plus: '', power_plus_requirement: '', unlock_goal: 'ทำคะแนน 2,000,000 แต้ม (LINE)\nเพิ่มเพื่อน 200 คน (Kakao)' } } }, { grade: 4, id: cookie:38, image: 'soda_cookie.png', rank: 3, release_date: 1404172800, tr: { en: { abilities: 'Gathering HP Potions triggers cool Soda Waves. Blast Mode is triggered while riding the waves on his surfboard, obstacles are swept away by the waves, and collecting Jellies awards bonus points. (Leveling up increases the duration of the waves.)', description: "This Cookie was baked once, then baked once again under the sun of the beach. He was glazed with a special oil, then toasted to the perfect shade of golden brown. He is now a free-spirited waterproof Cookie who loves to surf on the popsicle surfboard he found in the Witch's freezer. He has the power to generate cool soda waves wherever he wishes. Watching this Cookie smoothly coast along, you'll feel like it's summertime all the time. Oh yeah!", name: 'Soda Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 25 Cookies at Lv.8' }, th: { abilities: 'โต้คลื่น', description: 'ขี่คลื่นโซดาหลังจากกินโพชันพลังงาน ทุกครั้งที่เขาอยู่บนบอร์ด อุปสรรคทั้งหมด (โต้คลื่นนานขึ้นเมื่ออัปเกรด)\r\n\r\nหลังจากเคลือบตัวเองด้วยเกลซพิเศษ เขาก็อาบแดดและถูกย่างจนเป็นสีน้ำตาลทองสมบูรณ์ ตอนนี้เขาเป็นคุกกี้กันน้ำหัวใจอิสระที่ชอบโต้คลื่นบนบอร์ดโซดาป๊อปซิเคิลที่พบในช่องแช่แข็งของแม่มด ถ้ามีโอกาส เขาจะออกเดินทางไล่ล่าคลื่นที่สมบูรณ์แบบอย่างไม่มีวันสิ้นสุด เขาจะกลับมาหรือเปล่า? บางทีอาจไม่! ด้วยพลังมหัศจรรย์ในการสร้างคลื่นโซดา เขาสามารถโต้คลื่นได้ทั้งฤดูร้อน! คุณจะรู้ความหมายที่แท้จริงของ กับคุกกี้นี้', name: 'คุกกี้รสโซดา', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้เลเวลสูงสุด 25 ตัว' } } }, { grade: 6, id: cookie:39, image: 'tiger_lily_cookie.png', rank: 5, release_date: 1406764800, tr: { en: { abilities: 'The small blue gauge charges over time. When it is full, Tiger Lily Cookie throws her spear, turning obstacles into grass. Jellies or HP Potions grow where the spear hits the ground. Throws the spear again immediately when picking it up from the ground. Each spear throw fills the green gauge a bit. Summons the Butter Tiger for a fast ride when the green gauge is full. (Butter Tiger counts as a riding skill.)', description: 'It is not known how Tiger Lily Cookie ended up in the jungle all by herself. Under the constant threat of encroaching enemies, her senses grew sharp. In contrast to her rough outward appearance, she is soft and delicate on the inside. Her only family is her trusty Butter Tiger, whom she cherishes more than anything in the world. Her great skill with the spear and excellent jumping abilities make her one tough Cookie to beat.', name: 'Tiger Lily Cookie', power_plus: 'Creates Mystery Boxes at a given rate in Episode 2 "Primeval Jungle" (higher probability with upgrades).', power_plus_requirement: '', unlock_goal: 'Special acquisition (event / no unlock condition in data)' }, th: { abilities: 'Spear Thrower', description: 'ในช่วงเวลาที่กำหนด เธอเปลี่ยนอุปสรรคเป็นหญ้าและขว้างหอกไปรอบๆ เยลลี่และโพชันจะเกิดจากจุดที่หอกปักลงพื้น จากนั้นเธอขี่เสือของเธอและเคลื่อนที่เร็วมากข้ามแท่น\r\n\r\nเธอเป็นคุกกี้ป่าด้วยดวงตาคมกริบ ระแวดระวังศัตรูที่เข้ามาใกล้ เธอเติบโตเพียงลำพังในป่า และถึงแม้เธอจะดูมีท่าทีเป็นปฏิปักษ์ แต่ภายในเธออ่อนโยนมาก ครอบครัวเดียวของเธอคือเสือของเธอ ซึ่งเธอทะนุถนอมมากกว่าสิ่งใดในโลก ทักษะหอกอันยอดเยี่ยมและความสามารถกระโดดที่ยอดเยี่ยมทำให้เธอเป็นคุกกี้ที่เอาชนะได้ยาก', name: 'คุกกี้สาวเจ้าป่า', power_plus: 'Creates Mystery Boxes at a given rate in Episode 2 "Primeval Jungle" (higher probability with upgrades).', power_plus_requirement: '', unlock_goal: 'รางวัลพิเศษจากการเก็บอัญมณีลึกลับทั้งหมดในตอนที่ 2: Primeval Jungle' } } }, { grade: 6, id: cookie:40, image: 'fire_spirit_cookie.png', rank: 5, release_date: 1406764800, tr: { en: { abilities: 'Revives by turning into a fire spirit for a set time. Earns bonus points for Jellies gathered in this form. (1 Revive with 25 HP)', description: "Most Cookies merely adapted to the flames of the Dragon's Valley, but this legendary Cookie was born in it, molded by it. This mysterious Cookie lives in both the Cookie World and the Dragon World. The Red Dragon's Bead that he carries is proof that he has either won the Red Dragon's favor or has escaped with it through some kind of mischievous trade.", name: 'Fire Spirit Cookie', power_plus: "Creates Mystery Box at a given rate in Episode 3 \"Dragon's Valley\" (Higher probability with upgrades)", power_plus_requirement: '', unlock_goal: 'Special acquisition (event / no unlock condition in data)' }, th: { abilities: 'Fiery Spark', description: 'มันจะแปลงร่างเป็นวิญญาณไฟในช่วงเวลาที่กำหนดหลังจากฟื้นคืนชีพ\r\n\r\nนี่คือคุกกี้ในตำนานที่ทนทานต่อเปลวไฟของเตาอบมานานจนเปลวไฟกลายเป็นส่วนหนึ่งของเขา ไม่มีใครรู้ว่าเขาทำได้สำเร็จได้อย่างไร และใครก็ตามที่สบตาเขาจะหลงใหลในแสงอันอบอุ่นที่ส่องประกายของเปลวไฟนิรันดร์ของเขา', name: 'คุกกี้ภูตอัคคี', power_plus: "Creates Mystery Box at a given rate in Episode 3 \"Dragon's Valley\" (Higher probability with upgrades)", power_plus_requirement: '', unlock_goal: "รางวัลพิเศษจากการเก็บอัญมณีลึกลับทั้งหมดในตอนที่ 3: Dragon's Valley" } } }, { grade: 4, id: cookie:41, image: 'blackberry_cookie.png', rank: 3, release_date: 1409356800, tr: { en: { abilities: 'Spirits surrounding her eat Jellies and periodically create Blackberry Jellies. (Leveling up increases the number of Blackberry Jellies.)', description: "Blackberry Cookie always wears a reserved look, but it would be hard to find a more caring and devoted Cookie. She has been working at one prestigious household for a long time, and is praised for her miraculous ability to do a multitude of tasks in virtually no time! Despite Blackberry's tightest schedule, she always finds the time to save the life of her venturesome employer. Perhaps, this is her main duty these days.", name: 'Blackberry Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 16 Treasures at +9' }, th: { abilities: 'Paranormal Activity', description: 'วิญญาณรอบตัวเธอกินเยลลี่และผลิตแบล็กเบอร์รีเยลลี่ตามช่วงเวลาที่กำหนด ผลิตเยลลี่มากขึ้นเมื่ออัปเกรด\n\nเธอสวมสีหน้าเฉยเมยเสมอ และคุกกี้ตัวอื่นอาจคิดว่าเธอเข้าถึงยาก แต่รูปลักษณ์หลอกลวง เธอมีความสามารถที่น่าทึ่งในการจดจ่อกับงานเดียวจนเสร็จ และได้ช่วยคุกกี้ตัวอื่นแก้ปัญหาด้วยทักษะการจัดการอันน่าทึ่งที่เธอเรียนรู้จากการทำงานให้บ้านอันทรงเกียรติ ใครๆ ก็คิดว่าคุกกี้ตัวเดียวไม่สามารถทำอะไรได้มากมายขนาดนั้น แต่เธอพิสูจน์ให้ทุกคนเห็นตรงกันข้าม เมื่อถึงเวลาวิ่ง เธอเร่งเครื่องจริงๆ', name: 'คุกกี้แบล็คเบอร์รี่', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอัปเกรดเต็มที่ 16 ชิ้น' } } }, { grade: 4, id: cookie:42, image: 'kiwi_cookie.png', rank: 3, release_date: 1412121600, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Kiwi Cookie blasts ahead on his bike. Picking up Kiwi Fuel Jellies boosts bike speed for a short time and prolongs the duration of the ride. (Leveling up makes the gauge fill faster.)', description: 'He is a tough Cookie, hardened under the blazing sun while riding wherever his wheels will take him. He feels most alive going uphill at top speed with the wind blowing directly in his face. But, no worries, "Safety first" is his motto. Kiwi Cookie has vowed to fill the world with his kiwi scent, and it seems like nothing will quench his thirst for adventure.', name: 'Kiwi Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 25 S Treasures' }, th: { abilities: 'Biker', description: 'เขาพุ่งทะลุแท่นขณะขี่มอเตอร์ไซค์ ซึ่งเร็วขึ้นเมื่อกินเฟวลเยลลี่ (เร็วขึ้นเมื่ออัปเกรด) โปรดทราบว่ามอเตอร์ไซค์ไม่ถือเป็น "ไรด์" ดังนั้นจะไม่ได้รับคะแนนพิเศษจากสมบัติเมื่อใช้\n\nเขาเป็นคุกกี้แกร่งที่แข็งแกร่งขึ้นภายใต้แสงอาทิตย์อันร้อนระอุ ขณะขี่ไปอย่างไร้จุดหมายกับจักรยานอันล้ำค่าของเขา เขารู้สึกมีชีวิตชีวาที่สุดเมื่อลมพัดเข้าหน้าขณะขี่ด้วยความเร็วสูงสุด ว่ากันว่าเขาปฏิญาณว่าจะแพร่กลิ่นกีวีไปทั่วโลก และดูเหมือนไม่มีอะไรจะดับความกระหายการผจญภัยของเขาได้ เขาจะขี่ไปที่ไหนต่อไป?', name: 'คุกกี้รสกีวี่', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอันดับ S 25 ชิ้น' } } }, { grade: 4, id: cookie:43, image: 'werewolf_cookie.png', rank: 3, release_date: 1414713600, tr: { en: { abilities: 'The green gauge charges over time (the lower the HP, the faster). When it is full, Werewolf Cookie changes into wolf form to crush obstacles, earning Crush Points. Careful: Werewolf Cookie can still fall into pits while in wolf form. (Leveling up makes the gauge fill faster and increases the amount of Crush Points.)', description: "While adding great amount of pepper into the cookie dough, a wolf hair had fallen in by accident. Hence, whenever Werewolf Cookie feels scared or threatened, his wolf instinct kicks in and he transforms into a feral beast. A long time ago, his friend fell in grave danger, and Werewolf Cookie saved him only after transforming and revealing his true self to the townsfolk. He was castaway out of fear and has been living alone in the forests since. With so much pain buried within him, this Cookie tastes bitter and salty (of tears). Don't ask about his scar or try to get close to him. He'll only push you away cause he's afraid he'll hurt you. We can only assume he's been hurt deep inside, just like his deep scar under his eyes.", name: 'Werewolf Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 25 Pets at Lv.8' }, th: { abilities: 'Wolf Transformation', description: 'เขากลายร่างเป็นหมาป่าในช่วงเวลาที่กำหนด และแปลงร่างถี่ขึ้นเมื่อพลังงานต่ำ ได้คะแนนพิเศษสำหรับการทำลายอุปสรรค โปรดระวังเพราะเขาสามารถตกลงไปในหลุมได้เมื่อกลายเป็นหมาป่า เมื่ออัปเกรด การแปลงร่างของเขาถี่ขึ้นและได้คะแนนพิเศษสำหรับการทำลายอุปสรรค\n\nตอนที่คุกกี้กำลังถูกอบ มีขนหมาป่าปนอยู่ในส่วนผสม และเมื่อใดก็ตามที่เขารู้สึกกลัวหรือถูกคุกคาม สัญชาตญาณหมาป่าของเขาจะพุ่งออกมาและเขากลายร่างเป็นสัตว์ป่าดุร้าย วันหนึ่ง เพื่อนคนหนึ่งของเขาตกอยู่ในอันตราย และเขาช่วยเขาไว้หลังจากการแปลงร่างและเผยตัวตนที่แท้จริงให้ชาวบ้านในหมู่บ้านที่เขาอาศัยอยู่ เขาถูกขับไล่ด้วยความกลัวและใช้ชีวิตตามลำพังตั้งแต่นั้นมา ดวงตาของเขายังมีร่องรอยของตัวตนเดิมอยู่หรือไม่? ไม่มีใครรู้', name: 'คุกกี้หมาป่า', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยงเลเวลสูงสุด 25 ตัว' } } }, { grade: 4, id: cookie:44, image: 'cocoa_cookie.png', rank: 3, release_date: 1417219200, tr: { en: { abilities: 'Gathering HP Potions summons a flying Cocoa Mug to ride in. While flying, regular Jellies turn into Cocoa Marshmallow Jellies awarding more points. Recovers more HP from Potions. (Leveling up increases flight duration and recovery amount. The Cocoa Mug counts as a riding skill.)', description: "Even though her dough is already 80% cocoa, she's always sipping hot cocoa, even during summertime. Her marshmallow hat is so deliciously sweet that she needs to resist the temptation of taking a chunk out of it and dipping it into her cup. Her plump, smooth cheeks just add to her charm! When she indulges in a freshly prepared cup of cocoa, all her worries melt away.", name: 'Cocoa Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 5 evolved Treasures' }, th: { abilities: 'Cocoa Cup', description: 'เมื่อกินโพชัน เธอกระโดดขึ้นถ้วยโกโก้และบินผ่านเส้นทางในช่วงเวลาที่กำหนด เมื่ออยู่บนถ้วย เยลลี่ปกติจะกลายเป็นมาร์ชเมลโลว์เยลลี่ที่ให้คะแนนสูงขึ้น หลังจากดื่มโพชัน เธอฟื้นฟูพลังงานมากกว่าปกติ (เมื่ออัปเกรด เธอบินนานขึ้นด้วยถ้วยและฟื้นฟูพลังงานมากขึ้น) (ถ้วยของคุกกี้รสโกโก้ถือเป็นไรด์และจะได้รับคะแนนเพิ่มเติมเมื่อเธออยู่บนนั้น)\n\nถึงแม้ร่างกายของเธอจะเป็นโกโก้ 80% เธอก็ยังจิบโกโก้ร้อนเสมอ แม้ในฤดูร้อน หมวกมาร์ชเมลโลว์ของเธอหวานน่าทานจนเธอต้องอดใจไม่ให้กัดชิ้นหนึ่งแล้วจิ้มลงในถ้วย แก้มกลมเนียนของเธอเพิ่มเสน่ห์ให้เธอ! เมื่อเธอดื่มด่ำกับโกโก้ที่ชงสดใหม่ ความกังวลทั้งหมดของเธอละลายหายไป', name: 'คุกกี้รสโกโก้', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติวิวัฒน์ 5 ชิ้น' } } }, { grade: 4, id: cookie:45, image: 'mint_choco_cookie.png', rank: 3, release_date: 1417219200, tr: { en: { abilities: 'Plays the violin to create Coins. Avoiding collisions with obstacles for a given time increases running speed and generates more Coins. Colliding with an obstacle resets to the default speed and causes greater damage. (Leveling up increases the amount of Coins generated.) (Special music plays when running with Mint Choco Cookie.)', description: 'His exquisite performance and dashing looks make him a favorite among the Cookies. His Mint Candy Violin gives off a sweet intoxicating candy aroma while he plays. Though often called a genius, he refuses to let all this attention go to his head and never forgets his long years as a humble street performer.', name: 'Mint Choco Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 40 Cookies' }, th: { abilities: 'Violin Performance', description: "สร้างเหรียญเมื่อเล่นไวโอลิน ในช่วงเวลาที่กำหนด ถ้าไม่ชนอุปสรรคใดๆ เขาจะวิ่งเร็วขึ้นและสร้างเหรียญจำนวนมาก ถ้าชนอุปสรรค ความเร็วจะกลับเป็นปกติและพลังงานจะลดลงอย่างมาก (เมื่ออัปเกรด จำนวนเหรียญที่เขาสร้างจะเพิ่มขึ้น) (คุณสามารถเพลิดเพลินกับ BGM คุกกี้รสมิ้นท์ช็อกโก้พิเศษเมื่อวิ่งกับเขา)\n\nการแสดงอันยอดเยี่ยม รูปลักษณ์โดดเด่น และความสามารถอันน่าทึ่งของไวโอลินมินต์แคนดี้ของเขาที่ปล่อยกลิ่นขนมหวานมึนเมาขณะเล่น ทำให้เขาเป็นที่โปรดปรานของคุกกี้ทั้งหมด ถึงแม้จะถูกเรียกว่า 'อัจฉริยะ' เขาปฏิเสธที่จะปล่อยให้ความสนใจทั้งหมดนี้เข้าหัว และจะไม่มีวันลืมปีอันยาวนานในฐานะนักแสดงข้างถนนผู้ถ่อมตน", name: 'คุกกี้รสมิ้นท์ช็อกโก้', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้ 40 ตัว' } } } ];
INSERT [ { grade: 4, id: cookie:46, image: 'red_pepper_cookie.png', rank: 3, release_date: 1528761600, tr: { en: { abilities: "Small chance of crushing obstacles on collision instead of taking damage. When his rage gauge is filled, he's on fire and crushes all obstacles. Revives out of sheer willpower after running out of HP once. Earns extra Crush Points. (Leveling up increases the amount of HP on Revive.)", description: "Whole chunks of spicy peppers were added to the dough to make Red Pepper Cookie. His biggest desire is to become the toughest Muay Thai fighter in the world. To do so, Red Pepper can spend days and nights training in the most unthinkable conditions. He even refused to leave the oven to make his body hard as stone! He's now got quite a tan, which goes perfectly with his fiery charisma. Red Pepper Cookie considers his hairstyle a symbol of his strong will and dedication, so he has no plans to change it.", name: 'Red Pepper Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 30 S Treasures' }, th: { abilities: "Small chance of crushing obstacles on collision instead of taking damage. When his rage gauge is filled, he's on fire and crushes all obstacles. Revives out of sheer willpower after running out of HP once. Earns extra Crush Points. (Leveling up increases the amount of HP on Revive.)", description: "Whole chunks of spicy peppers were added to the dough to make Red Pepper Cookie. His biggest desire is to become the toughest Muay Thai fighter in the world. To do so, Red Pepper can spend days and nights training in the most unthinkable conditions. He even refused to leave the oven to make his body hard as stone! He's now got quite a tan, which goes perfectly with his fiery charisma. Red Pepper Cookie considers his hairstyle a symbol of his strong will and dedication, so he has no plans to change it.", name: 'Red Pepper Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 30 S Treasures' } } }, { grade: 4, id: cookie:47, image: 'cream_puff_cookie.png', rank: 3, release_date: 1422748800, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Cream Puff Cookie casts a Minor Jelly Spell to create a small amount of Jellies. Sometimes this triggers a Jelly Storm, generating a large amount of Jellies. (Leveling up makes the gauge fill faster.)', description: "Sweet Cream Puff Cookie makes you feel good just by looking at her. Made of soft and delicate cream puff, this Cookie is as fragile as can be. Something about her makes you worry about her, but that's her charm point. Although she is a bit clumsy, great powers lie within her, and her potential is unpredictable. After many failed attempts with her spells, she often visits the old library to cheer herself up. Will Cream Puff Cookie be able to become a respected wizard? Let's find out!", name: 'Cream Puff Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 10 evolved S Treasures' }, th: { abilities: 'Magic Apprentice', description: 'เล่นกลเล็กๆ น้อยๆ ในช่วงเวลาที่กำหนด เธอเริ่มวิ่งด้วยความน่าจะเป็นต่ำที่จะปล่อยกลใหญ่ ซึ่งจะเพิ่มขึ้นทุกครั้งที่ปล่อยกลใหญ่ไม่สำเร็จ เมื่อสำเร็จ เกจความน่าจะเป็นจะรีเซ็ต (เมื่ออัปเกรด เธอสามารถเล่นกลใหญ่ได้บ่อยขึ้น)\n\nเธอคือคุกกี้รสชูครีมสุดหวานที่ทำให้คุณรู้สึกดีเพียงแค่มอง บางอย่างเกี่ยวกับเธอทำให้คุณเป็นห่วงเธอ แต่นั่นคือเสน่ห์ของเธอ ถึงแม้จะซุ่มซ่ามเล็กน้อย พลังอันยิ่งใหญ่ซ่อนอยู่ในตัวเธอ และศักยภาพของเธอคาดเดาไม่ได้ หลังจากความล้มเหลวหลายครั้งกับคาถาของเธอ เธอไปห้องสมุดเพื่อปลอบใจตัวเอง วันนั้น เธอค้นพบเมืองแห่งพ่อมด และการผจญภัยของเธอเพื่อเป็นพ่อมดที่น่าเคารพก็เริ่มต้นขึ้น! คุกกี้รสชูครีมจะบรรลุเป้าหมายของเธอได้ไหม?? มาดูกัน!', name: 'คุกกี้รสชูครีม', power_plus: '', power_plus_requirement: '', unlock_goal: '*ครอบครองสมบัติเกรด S วิวัฒน์ 10 ชิ้น (Kakao, LINE)\n*มีสมบัติระดับ S 14 ชิ้น (India)' } } }, { grade: 6, id: cookie:48, image: 'moonlight_cookie.png', rank: 5, release_date: 1422748800, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Moonlight Cookie falls asleep and dreams. While dreaming, Moonlight Cookie attracts Dark Moon Jellies, while Star Powder Jellies appear and crush obstacles. When waking up, a small amount of HP is restored. (Leveling up makes the gauge fill faster.)', description: "Moonlight Cookie's graceful wavy hair shines under the night sky, elegant and mystical as ever. She was created by the ancient wizards and learned the secrets of the City of Wizards. Now, all the wizards are gone and she is the only one left to protect the city. She is strongest while in her dreams, enabling her to protect the city from intruders. Whenever she feels sad, she falls asleep, where she is able to lean on her friend Moon and draw in the night sky with her Star friends to cheer up.", name: 'Moonlight Cookie', power_plus: 'Creates Mystery Boxes at a given rate in Episode 4 "The City of Wizards" (Higher probability with upgrades)', power_plus_requirement: '', unlock_goal: 'Special acquisition (event / no unlock condition in data)' }, th: { abilities: 'Moonlight Magic', description: 'เธอหลับและฝันในช่วงเวลาที่กำหนด และระหว่างฝันหวาน เธอดึงดูดเยลลี่ทั้งหมด รวมถึงดาร์กมูนเยลลี่ เธอยังสร้างสตาร์พาวเดอร์เยลลี่ที่เปิดทางให้เธอ และเมื่อเธอตื่นจากฝันหวาน พลังงานของเธอจะถูกฟื้นฟู (เธอฝันบ่อยขึ้นเมื่ออัปเกรด)\n\nผมลอนอันสง่างามของคุกกี้มูนไลท์เปล่งประกายใต้ท้องฟ้ายามค่ำคืน งดงามและลึกลับเช่นเคย เธอถูกสร้างโดยพ่อมดโบราณก่อนที่อาณาจักรคุกกี้จะถูกสร้างขึ้นเสียอีก และเรียนรู้ความลับของเมืองแห่งพ่อมด แต่ด้วยเหตุผลบางอย่างที่ไม่ทราบ เธอถูกทิ้งให้ปกป้องเมืองเพียงลำพัง เธอแข็งแกร่งที่สุดในยามฝัน จึงสามารถปกป้องเมืองจากผู้บุกรุกได้ แต่การอยู่คนเดียวมานานทำให้เธอเศร้าและเหงาในบางครั้ง ในช่วงเวลาเช่นนี้ เธอจะหลับไป ที่ซึ่งเธอสามารถพิงเพื่อนของเธอ พระจันทร์ และวาดบนท้องฟ้ายามค่ำคืนกับเพื่อนดวงดาวเพื่อปลอบใจตัวเอง', name: 'คุกกี้แสงจันทร์', power_plus: 'Creates Mystery Boxes at a given rate in Episode 4 "The City of Wizards" (Higher probability with upgrades)', power_plus_requirement: '', unlock_goal: 'รางวัลพิเศษจากการได้รับอัญมณีลึกลับทั้งหมดในตอนที่ 4: The City of Wizards' } } }, { grade: 4, id: cookie:49, image: 'gumball_cookie.png', rank: 3, release_date: 1425081600, tr: { en: { abilities: 'Loads gumballs while jumping and shoots while sliding. The shots crush obstacles and earn shot points. Consecutive shots increase shot points. Up to 20 gumballs can be loaded at a time. (Leveling up increases the amount of shot points earned.)', description: 'The hard outside and soft inside of a gumball were separated, then evenly mixed into the batter and--ta-da!--Gumball Cookie was born! If you smell a sweet and sour aroma, Gumball Cookie is nearby! He is out on a mission to transform the boring world into a fun and colorful playground with his gumball cannon! Walls? Ceilings? Obstacles? Everything is a canvas for this mischievous cookie! It is said that he angered the Witch by coloring her oven the day after he was born. For his turbulent nature, he is resented sometimes, but he will stop at nothing to share his art with the world.', name: 'Gumball Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.70' }, th: { abilities: 'Gumball Cannon', description: 'เขาบรรทุกกัมบอลขณะกระโดดและยิงขณะสไลด์ การยิงทำลายอุปสรรคและได้รับคะแนนยิง การยิงต่อเนื่องเพิ่มคะแนน! กัมบอลสามารถบรรทุกได้สูงสุด 20 ครั้ง (ได้รับคะแนนยิงมากขึ้นเมื่ออัปเกรด)\n\nเปลือกแข็งและไส้ในนุ่มของกัมบอลถูกแยกออก แล้วผสมให้เข้ากันในแป้งคุกกี้... และแจ้ม! คุกกี้รสหมากฝรั่งถือกำเนิด! ถ้าได้กลิ่นหอมเปรี้ยวหวาน แสดงว่าคุกกี้รสหมากฝรั่งอยู่ใกล้! เขาออกปฏิบัติภารกิจเปลี่ยนสิ่งที่ "น่าเบื่อ" ให้เป็นสีสันและสนุก! กำแพง? เพดาน? อุปสรรค? ทุกอย่างคือผืนผ้าใบสำหรับคุกกี้จอมซนคนนี้! ว่ากันว่าเขาถึงกับทำให้แม่มดโกรธด้วยการระบายสีเตาอบของเธอในวันรุ่งขึ้นหลังเกิด ด้วยเหตุผลดังกล่าว เขาจึงถูกหมางเมนในบางครั้ง แต่เขาจะไม่หยุดเพื่อแบ่งปันศิลปะของเขากับโลก เมื่อเขาค้นพบเมืองแห่งพ่อมด เขาเต้นรำด้วยความยินดีที่พบโลกที่เหมือนผืนผ้าใบรอการระบายสี!', name: 'คุกกี้รสหมากฝรั่ง', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 70' } } }, { grade: 4, id: cookie:50, image: 'cherry_blossom_cookie.png', rank: 3, release_date: 1427846400, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Cherry Blossom Cookie takes flight, creating Cherry Blossom Jellies along the way. Creates Cherry Blossom Jelly Party in Bonus Time. (Leveling up makes the gauge fill faster.)', description: 'On a warm spring day, the first pink cherry blossoms were collected and then infused for a generous amount of time. Then this essence was used to create Cherry Blossom Cookie. Just by looking at her, you will feel splendid and warm inside, with a tingle on both your cheeks. On a perfect day, you can see her humming, trying to fly into the air with her umbrella open. She is most adorable when she offers you delicious sandwiches and tea. But watch out, once she starts to chat, you will lose track of time!', name: 'Cherry Blossom Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 20 evolved S Treasures' }, th: { abilities: 'Blossom Power', description: 'สร้างเชอร์รี่บลอสซัมเยลลี่ขณะบินตามช่วงเวลาที่กำหนด ปาร์ตี้เชอร์รี่บลอสซัมเยลลี่ถูกสร้างขึ้นในโบนัสไทม์ (บินถี่ขึ้นเมื่ออัปเกรด)\n\nในวันฤดูใบไม้ผลิอันอบอุ่น เชอร์รี่บลอสซัมสีชมพูดอกแรกถูกเก็บมา แล้วสกัดเป็นสาระสำคัญเหลวเป็นเวลานานพอสมควร และด้วยสาระสำคัญนี้ คุกกี้รสซากุระจึงถือกำเนิด เพียงแค่มองเธอ คุณจะรู้สึกงดงามและอบอุ่นภายใน พร้อมกับความซาบซ่านที่แก้มทั้งสองข้าง ในวันที่อากาศดี คุณจะได้เห็นเธอฮัมเพลงพร้อมกับร่มที่กาง พยายามบินขึ้นไปในอากาศ เธอน่ารักที่สุดเมื่อเธอเสนอแซนด์วิชและชาอร่อยๆ ให้คุณ แต่ระวังไว้ เมื่อเธอเริ่มคุย คุณจะลืมเวลาไปเลย', name: 'คุกกี้รสซากุระ', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติวิวัฒน์อันดับ S 20 ชิ้น' } } }, { grade: 4, id: cookie:51, image: 'lemon_cookie.png', rank: 3, release_date: 1430352000, tr: { en: { abilities: "The green gauge charges over time. When it is full, Lemon Cookie generates an Electro Shield, increasing Jelly points and slightly slowing HP drain. The shield's magnetic field attracts all Jellies, including Dark Moon Jellies. During Blast, Lemon Cookie crushes obstacles around him. (Leveling up makes the gauge fill faster.)", description: "Lemon Cookie was born not inside the hot Oven, but in a cold, neon-lit laboratory during an experiment with electricity. A giant, highly acidic lemon was used in the making of this Cookie, hence he courses with electricity. The cube that Lemon Cookie always carries with him controls the electric currents in his body. In his childhood, Lemon Cookie had only one friend who was always fascinated with his cube tricks. When Lemon Cookie couldn't control his power and became a danger to other Cookies, this friend was the only one to be there for him... Always listening to his music, Lemon Cookie might not be easy to approach, but who knows what electrifying surprises might await us if we do?", name: 'Lemon Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 50 Pets' }, th: { abilities: 'Electro Shield', description: 'สร้างอิเล็กโทร ตามช่วงเวลาที่กำหนด อิเล็กโทรชีลด์เพิ่มคะแนนเยลลี่และลดความเร็วการสูญเสียพลังงานเล็กน้อย มันยังดึงดูดเยลลี่ทั้งหมด แม้แต่ดาร์กมูนเยลลี่ที่แข็งแกร่ง พุ่งของคุกกี้รสเลม่อนกลายเป็นไลท์นิงพุ่ง ซึ่งทำลายอุปสรรคและได้รับคะแนนพิเศษ (อิเล็กโทรถี่ขึ้นเมื่ออัปเกรด)\n\nคุกกี้รสเลม่อนเปรี้ยวฉุนถือกำเนิดในห้องแล็บเย็นเยือก ขณะที่ผู้สร้างกำลังทดลองกับไฟฟ้า มะนาวสดยักษ์ที่มีความเป็นกรดสูงถูกใส่ในการสร้างคุกกี้นี้ ดังนั้นมันจึงไหลไปด้วยไฟฟ้า ลูกบาศก์ที่คุกกี้รสเลม่อนพกควบคุมไฟฟ้าแรงสูงทั้งหมดในร่างกายของเขา เพื่อนในวัยเด็กของคุกกี้รสเลม่อนพบว่าลูกบาศก์นี้น่าสนใจมาก ด้วยความช่วยเหลือของเพื่อน คุกกี้รสเลม่อนเรียนรู้วิธีแก้ลูกบาศก์หลากหลายวิธี และยังมีเคล็ดลับของตัวเองอีกด้วย เมื่อคุกกี้รสเลม่อนไม่สามารถควบคุมพลังของมันได้ มันก็กลายเป็นอันตรายต่อคุกกี้ตัวอื่น เพื่อนในวัยเด็กคนนี้อาจเป็นคนเดียวที่คุกกี้รสเลม่อนคุยด้วยได้ คุกกี้รสเลม่อนอาจเข้าถึงยาก แต่เซอร์ไพรส์สุดช็อตอาจรอเราอยู่ถ้าเราเข้าใกล้', name: 'คุกกี้รสเลม่อน', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยง 50 ตัว' } } }, { grade: 4, id: cookie:52, image: 'orange_cookie.png', rank: 3, release_date: 1433289600, tr: { en: { abilities: 'Periodically creates a Tennis Ball Jelly that can be picked up to smash using a double jump. The ball then bounces around crushing obstacles and creating Orange Citrus Jellies. While in the air, the Slide button turns into a Smash button. Tapping it triggers an even stronger bounce. Frantically smashes tennis balls while in Blast Mode. (Leveling up increases the frequency of tennis balls appearing.)', description: "You can't find another cookie as zesty as Orange Cookie. She enjoys all outdoor activities, especially on a sunny day. The sun-cream mixed into her dough is the secret to her perfect tan. She is always full of positive energy and just being with her makes others happy. Her smashes are getting stronger every time... perhaps it is because of her childhood friend...?", name: 'Orange Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 42 Cookies at Lv.8' }, th: { abilities: 'Power Tennis', description: "ลูกเทนนิสปรากฏตามช่วงเวลาที่กำหนด หลังจากการกระโดดสองชั้น ลูกเทนนิสจะเด้งไปรอบๆ ทำลายอุปสรรคและกระจายเนื้อส้ม ปุ่ม 'สแมช' แทนที่ 'สไลด์' ทำให้เด้งแรงยิ่งขึ้น คุกกี้รสส้มขว้างลูกเทนนิสไม่จำกัดจำนวนระหว่างพุ่ง (ลูกเทนนิสถี่ขึ้นเมื่ออัปเกรด)\n\nคุณหาคุกกี้ที่สดชื่นเท่าคุกกี้รสส้มไม่ได้อีกแล้ว เธอชอบกิจกรรมกลางแจ้งทั้งหมด โดยเฉพาะในวันที่แดดจ้า ส่วนผสมครีมกันแดดในตัวเธอคือความลับของผิวสีแทนที่สมบูรณ์แบบ เธอเต็มไปด้วยพลังบวกเสมอ และการอยู่กับเธอทำให้คนอื่นมีความสุข สแมชของเธอแข็งแกร่งขึ้นทุกครั้ง... บางทีอาจเป็นเพราะเพื่อนในวัยเด็กของเธอ?..", name: 'คุกกี้รสส้ม', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้เลเวลสูงสุด 42 ตัว' } } }, { grade: 4, id: cookie:53, image: 'lime_cookie.png', rank: 3, release_date: 1435795200, tr: { en: { abilities: 'Catches beach balls and strikes them when Double Jumping, crushing obstacles and creating Lime Citrus Jellies. Striking a ball in Giant form creates more Lime Citrus Jellies. The green gauge charges over time. When it is full, Lime Cookie rides a giant beach ball in Blast Mode, crushing obstacles and earning Crush Points. (Leveling up makes the gauge fill faster.)', description: "When baking this Cookie, large amounts of bitter lime peel were used. Perhaps that's why Lime Cookie is so feisty. Her trademark bangs were made with sweet, sweet jelly, and stay perfectly styled no matter how fast or wildly she runs. Don't let her appearance fool you, she is known to be not the friendliest type! There is only one Cookie that she has a weak spot for. She follows that Cookie around and looks up to them. Sometimes Lime Cookie can get pretty jealous and cause a rather uncomfortable situation. It is said that she learned her SMASH! skills from that Cookie...", name: 'Lime Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 60 S Treasures' }, th: { abilities: 'Super Beach Ball', description: 'กระโดดสองชั้นหลังจากรับลูกบอลชายหาดเพื่อขว้างมันและสร้างเนื้อมะนาวทำลายอุปสรรค เนื้อมะนาวถูกสร้างมากขึ้นในโหมดตัวยักษ์ ตามช่วงเวลาที่กำหนด คุกกี้รสมะนาวเข้าสู่บีชบอลแดช ทำลายอุปสรรคที่ขวางทาง (บีชบอลแดชถี่ขึ้นเมื่ออัปเกรด)\n\nตอนอบคุกกี้นี้ ใช้เปลือกส้มจำนวนมาก บางทีนั่นอาจเป็นเหตุผลที่คุกกี้รสมะนาวดุเดือด หน้าม้าอันเป็นเอกลักษณ์ของเธอทำจากพุดดิ้งหวานๆ ไม่ว่าเธอจะวิ่งเร็วหรือป่าเถื่อนแค่ไหน หน้าม้าของเธอก็สมบูรณ์แบบเสมอ อย่าปล่อยให้รูปลักษณ์น่ารักหลอกคุณ เธอเป็นที่รู้กันว่าค่อนข้างเย็นชากับคุกกี้ตัวอื่น แต่มีคุกกี้ตัวหนึ่งที่เธออ่อนแอด้วย เธอตามคุกกี้ตัวนั้นไปทั่วและชื่นชมมัน บางครั้ง ความหึงหวงของเธอทำให้เกิดสถานการณ์อึดอัด ว่ากันว่าเธอเรียนรู้ทักษะสแมช! จากคุกกี้ตัวนั้น...', name: 'คุกกี้รสมะนาว', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอันดับ S 60 ชิ้น' } } }, { grade: 4, id: cookie:54, image: 'peppermint_cookie.png', rank: 3, release_date: 1439251200, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Peppermint Cookie blows the conch shell to call upon the Peppermint Whale. The Peppermint Whale creates Splash Jellies as it makes its appearance, swimming with Peppermint Cookie on its back. While riding the whale, the Jump and Slide buttons call dolphins to gather Jellies instead. (The Peppermint Whale counts as a riding skill. Leveling up makes the gauge fill faster.)', description: "Mint leaves for Peppermint Cookie were gathered from a town near the clear sea. This Cookie likes to spend time at the shore, staring dreamily at the horizon, or playing the shell ocarina. An old friend, the Peppermint Whale, often appears to the sound for company. Peppermint Cookie treasures the simple but unchanging things, just like the waves that come and go. May the Cookie's smile remain unchanging as well!", name: 'Peppermint Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.74' }, th: { abilities: 'Whale Surfing', description: '<tabber> Classic=เกจสีเขียวชาร์จตามเวลา เมื่อเต็ม คุกกี้รสลูกอมมิ้นท์เป่าหอยสังข์เพื่อเรียกวาฬเปปเปอร์มินต์ วาฬเปปเปอร์มินต์สร้างสแปลชเยลลี่ขณะปรากฏตัว ว่ายพร้อมกับคุกกี้รสลูกอมมิ้นท์บนหลังของมัน ขณะขี่วาฬ ปุ่มกระโดดและสไลด์จะเรียกโลมามาเก็บเยลลี่แทน (วาฬเปปเปอร์มินต์นับเป็นสกิลขี่ การเลเวลอัพทำให้เกจเติมเร็วขึ้น) เป่าหอยสังข์เพื่อเรียกวาฬเปปเปอร์มินต์ตามช่วงเวลาที่กำหนด วาฬเปปเปอร์มินต์สร้างสแปลชเยลลี่ขณะปรากฏตัว ว่ายพร้อมกับคุกกี้รสลูกอมมิ้นท์บนหลังของมัน ขณะเรียกวาฬ คุณสามารถเรียกโลมาเพื่อเก็บเยลลี่แทนการกระโดดหรือสไลด์ การอัปเกรดจะเรียกวาฬเปปเปอร์มินต์บ่อยขึ้น การเรียกวาฬถือเป็นสกิลเรียก เป่าหอยสังข์เพื่อเรียกวาฬเปปเปอร์มินต์ ซึ่งพาคุกกี้รสลูกอมมิ้นท์ขึ้นหลังและสร้างซีบับเบิลเยลลี่ โลมาจะถูกเรียกแทนการกระโดดหรือสไลด์ เพื่อกินเยลลี่ขณะขี่ (วาฬเปปเปอร์มินต์ปรากฏถี่ขึ้นเมื่ออัปเกรด) </tabber>\n\n<tabber> |-|Classic/India= ใบมินต์สำหรับคุกกี้รสลูกอมมิ้นท์ถูกเก็บจากเมืองใกล้ทะเลใส คุกกี้นี้ชอบใช้เวลาอยู่ที่ชายฝั่ง มองขอบฟ้าอย่างฝันกลางวัน หรือเล่นโอคาริน่าเปลือกหอย เพื่อนเก่า วาฬเปปเปอร์มินต์ มักปรากฏตามเสียงเรียกมาเป็นเพื่อน คุกกี้รสลูกอมมิ้นท์ทะนุถนอมสิ่งที่เรียบง่ายแต่ไม่เปลี่ยนแปลง เหมือนคลื่นที่มาวานไป ขอให้รอยยิ้มของคุกกี้นี้ไม่เปลี่ยนแปลงเช่นกัน! |-|LINE= ใบมินต์ที่ใช้ทำคุกกี้นี้ถูกเก็บจากเมืองใกล้ทะเลใส คุกกี้สดชื่นนี้ชอบมองไปไกลๆ ด้วยสีหน้าฝันกลางวันที่ห่างไกล ดวงตาของมันดูเหมือนมหาสมุทรลึกลึก เมื่อมันหมกมุ่นอยู่กับความคิด มันให้บรรยากาศลึกลับยิ่งขึ้น เมื่อมันเป่าหอยสังข์อันล้ำค่า เพื่อนเก่า วาฬเปปเปอร์มินต์ปรากฏตัวมาเป็นเพื่อน คุกกี้รสลูกอมมิ้นท์เชื่อมั่นและทะนุถนอม ไม่ใช่สิ่งยิ่งใหญ่ แต่เป็นสิ่งที่ไม่เปลี่ยนแปลง เหมือนคลื่นที่มาวานไป ขอให้รอยยิ้มของมันไม่เปลี่ยนแปลงเช่นกัน </tabber>', name: 'คุกกี้รสลูกอมมิ้นท์', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 74' } } }, { grade: 4, id: cookie:55, image: 'peach_cookie.png', rank: 3, release_date: 1443225600, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Peach Cookie enters a bamboo forest to fight the Bamboo Bandits. Each downed Bandit grants points, with consecutive hits offering even more points. The mysterious aura of the bamboo forest allows Peach Cookie to perform up to 6 Multi Jumps. (Leveling up makes the gauge fill faster.)', description: "Peach Cookie is a master of martial arts from far, far away. She picked two of the juiciest peaches from a sunny valley and wears them in a traditional \"ox horns\" hairstyle. Don't be fooled by her cute smile - her agility and strength are unmatched! She is brimming with confidence and ready to fight any obstacle standing in her way. Even the Bamboo Forest, filled with hidden dangers and lurking bandits, is hardly a challenge to her. You can always tell where she's been, for she leaves behind a sweet, peachy scent... and a few fallen enemies. Gulp!", name: 'Peach Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 52 Cookies' }, th: { abilities: 'Peachy Bo-Staff', description: 'เข้าสู่ป่าไผ่และต่อสู้กับนักฆ่าไผ่ตามช่วงเวลาที่กำหนด รับคะแนนจากการต่อสู้กับนักฆ่าไผ่ และได้คะแนนมากขึ้นสำหรับการโจมตีต่อเนื่อง ในป่าไผ่ สามารถกระโดด 5 ชั้นได้ด้วยพลังงานลึกลับบางอย่าง (คะแนนทำลายมากขึ้นเมื่ออัปเกรด)\n\nคุกกี้รสพีชเป็นปรมาจารย์ศิลปะการต่อสู้จากแดนไกล เธอเลือกพีชฉ่ำที่สุดสองลูกในหุบเขาที่มีแดดจัดและสวมไว้ในทรงผม "เขาวัว" แบบดั้งเดิม อย่าหลงกลรอยยิ้มน่ารักของเธอ—เธอสามารถบดกระดูกคุณได้! เธอเต็มไปด้วยความมั่นใจและพร้อมสู้กับอุปสรรคใดๆ ที่ขวางทาง ป่าไผ่แทบไม่เป็นความท้าทายสำหรับเธอ คุณสามารถบอกได้เสมอว่าเธอเคยไปที่ไหน เพราะเธอทิ้งกลิ่นพีชหอมหวานไว้... และศัตรูที่ล้มลงสองสามตัว อึ๋ม!', name: 'คุกกี้รสพีช', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้ 52 ตัว' } } }, { grade: 4, id: cookie:56, image: 'general_jujube_cookie.png', rank: 3, release_date: 1443225600, tr: { en: { abilities: 'The green gauge charges over time. When it is full, General Jujube Cookie rides his Red Jujube Horse, crushing obstacles as arrows fly towards him. While Riding, a Candy Scimitar button replaces the Slide button, which crushes obstacles and creates Jujube Slice Jellies. (Horseback Riding counts as a riding skill. Leveling up makes the gauge fill faster.)', description: "This long-bearded Cookie is from the furthest eastern edge of the continent. Don't let his fierce appearance intimidate you; he is actually quite sweet. And he becomes even sweeter when his face reddens with anger or surprise! With his Candy Glaive, he can deflect oncoming arrows with swift slashes and destroy everything standing in his path with one fell swoop. But, don't worry, behind his rough exterior is a delicate soul: just look at all the care he puts into combing out his beard.", name: 'General Jujube Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 30 Treasures at +9' }, th: { abilities: 'Horseback Charge', description: 'ขี่ม้าจูจูบแดงและทำลายอุปสรรคกับลูกธนูที่บินมาหาเขาตามช่วงเวลาที่กำหนด ปุ่มกระบี่แคนดี้แทนที่ปุ่มสไลด์ระหว่างการใช้สกิล กดเพื่อเปลี่ยนอุปสรรคเป็นจูจูบสไลซ์เยลลี่ (สกิลถี่ขึ้นเมื่ออัปเกรด) (การขี่ม้านับเป็นไรด์)\n\nคุกกี้เคราอาวนี้มาจากขอบตะวันออกสุดของทวีป อย่าปล่อยให้รูปลักษณ์ดุดันทำให้คุณกลัว จริงๆ แล้วเขาอ่อนหวานทีเดียว และเขายิ่งอ่อนหวานขึ้นเมื่อใบหน้าแดงก่ำด้วยความโกรธหรือความประหลาดใจ ด้วยกระบี่แคนดี้ของเขา เขาสามารถทำลายทุกสิ่งที่ขวางทางด้วยฟันอันรวดเร็ว แต่ไม่ต้องกังวล เบื้องหลังภายนอกที่หยาบกร้านคือจิตใจที่ละเอียดอ่อน ทุกเช้าเขาจะถูกพบเห็นหวีเคราอย่างระมัดระวัง', name: 'คุกกี้รสพุทรา', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอัปเกรดเต็มที่ 30 ชิ้น' } } }, { grade: 4, id: cookie:57, image: 'onion_cookie.png', rank: 3, release_date: 1446249600, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Onion Cookie enters a Haunted House. Passes through obstacles earning Evasion Points while in the house. (Leveling up makes the gauge fill faster.)', description: "Your eyes will start to water if you get too close to this onion-based Cookie! And once she starts crying, she cannot stop. Mainly because her tears consist of onion juice, which causes her to cry even more. Poor thing. She is truly afraid of ghosts and weeps when scared. Perhaps one day, she'll realize why her surroundings sometimes become ghostly and clocks suddenly start ticking backwards.", name: 'Onion Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 25 evolved S Treasures' }, th: { abilities: 'Haunted House', description: 'เข้าไปในบ้านผีสิงและผ่านอุปสรรคตามช่วงเวลาที่กำหนด คะแนนพิเศษสำหรับการผ่านอุปสรรค (เยี่ยมบ้านผีสิงถี่ขึ้นเมื่ออัปเกรด)\n\nดวงตาของคุณจะเริ่มแสบหากเข้าใกล้คุกกี้รสหัวหอมนี้เกินไป! และเมื่อเธอเริ่มร้องไห้ เธอก็หยุดไม่ได้ สาเหตุหลักคือน้ำตาของเธอประกอบด้วยน้ำหัวหอม ซึ่งทำให้เธอร้องไห้มากขึ้นไปอีก น่าสงสารจริงๆ เธอกลัวผีอย่างแท้จริงและร้องไห้เมื่อตกใจ บางทีสักวันเธออาจรู้ว่าทำไมรอบตัวเธอถึงกลายเป็นผีๆ บางครั้ง และนาฬิกาจู่ๆ ก็เดินถอยหลัง', name: 'คุกกี้รสหัวหอม', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติวิวัฒน์อันดับ S 25 ชิ้น' } } }, { grade: 4, id: cookie:58, image: 'macaron_cookie.png', rank: 3, release_date: 1450310400, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Macaron Cookie leads the Macaron Parade. During the parade, the Macaron Animals run along creating Macaron Jellies and crushing obstacles, earning Crush Points and extra Jelly Points. (Leveling up makes the gauge fill faster.)', description: 'Did you think this Cookie was made with artificial food coloring? Guess again! She is made with 100% all-natural ingredients. Even her long, gorgeous eyelashes are completely organic. Cookies are drawn to her friendly smile and gentle voice. In fact, cute little Macaron Animals love to gather around her too. Once she starts playing on her macaron drum, the Macaron Animals start a tiny parade. At times, the parade can get out of hand, but Macaron Cookie still enjoys the company anyway. When she gets really excited, Macaron Cookie may demonstrate her most festive performance for you.', name: 'Macaron Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:69]]Castanets' }, th: { abilities: 'Parade', description: 'นำขบวนพาเหรดมาการองตามช่วงเวลาที่กำหนด สัตว์มาการองสร้างมาการองเยลลี่และทำลายอุปสรรค ได้คะแนนทำลายและคะแนนเยลลี่เพิ่มเติม (พาเหรดถี่ขึ้นเมื่ออัปเกรด)\n\nคุณคิดว่าคุกกี้นี้ทำจากสีผสมอาหารเทียมหรือ? เดาอีกครั้ง! เธอทำจากส่วนผสมธรรมชาติ 100% แม้แต่ขนตายาวสวยของเธอก็เป็นออร์แกนิกทั้งหมด คุกกี้ถูกดึงดูดด้วยรอยยิ้มเป็นมิตรและเสียงอ่อนโยนของเธอ จริงๆ แล้ว สัตว์มาการองตัวน้อยน่ารักก็ชอบมารวมตัวรอบตัวเธอเช่นกัน เมื่อเธอเริ่มตีกลองมาการอง สัตว์มาการองก็เริ่มขบวนพาเหรดเล็กๆ บางครั้งขบวนพาเหรดอาจควบคุมไม่ได้ แต่คุกกี้มาการองก็ยังสนุกกับการอยู่ร่วมกัน เมื่อเธอตื่นเต้นมาก คุกกี้มาการองอาจเปิดตัวการแสดงที่สนุกที่สุดสำหรับคุณ', name: 'คุกกี้รสมาการง', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยง [[pet:69]]Castanets' } } }, { grade: 4, id: cookie:59, image: 'cinnamon_cookie.png', rank: 3, release_date: 1448668800, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Cinnamon Cookie performs various card tricks. Dazzles with Revival Magic when running out of HP once. (Leveling up makes the gauge fill faster.)', description: "Sweet cinnamon powder lightly scatters each time this Cookie swings his cape. If you happen to be at Cinnamon Cookie's show, prepare for some of the most hectic, yet amazingly spectacular card tricks! As they go up and down and side to side, it is almost impossible to follow. One might say that Cinnamon Cookie's limitless energy can be tiresome, but as long as a single Cookie enjoys the wonderful show, it must go on. Keep your distance though: being too close to this sweet-scented magician will make you sneeze. Poof!", name: 'Cinnamon Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 70 S Treasures' }, th: { abilities: 'Card Trick', description: 'แสดงกลไพ่หลากหลายตามช่วงเวลาที่กำหนด เซอร์ไพรส์ด้วยเวทมนตร์คืนชีพ 1 ครั้ง (กลไกถี่ขึ้นเมื่ออัปเกรด)\n\nผงอบเชยหอมๆ ปลิวกระจายเบาๆ ทุกครั้งที่คุกกี้นี้โบกเสื้อคลุม คุกกี้ผู้รื่นเริงนี้ยืนยันจะแสดงกลไพ่ ซึ่งวุ่นวายมาก ขึ้นลงซ้ายขวาจนแทบเป็นไปไม่ได้ที่จะตามทัน คุกกี้ตัวอื่นบางครั้งเรียกคุกกี้ซินนามอนว่าขี้เล่นเกินไป แต่ตราบใดที่คุกกี้เพียงตัวเดียวเพลิดเพลินกับการแสดง มันก็ต้องดำเนินต่อไป รักษาระยะห่าง การอยู่ใกล้พ่อมดกลิ่นหอมนี้เกินไปจะทำให้คุณจาม ปุ๊ฟ!', name: 'คุกกี้รสชินนามอน', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติอันดับ S 70 ชิ้น' } } }, { grade: 4, id: cookie:60, image: 'red_bean_cookie.png', rank: 3, release_date: 1451433600, tr: { en: { abilities: 'Treat Fish Jelly appear while running. The green gauge charges over time. When it is full, Red Bean Cookie rides his Penguin Sled. The speed of the sled depends on the number of gathered Fish Treat Jellies. (Penguin Sled counts as a riding skill.)', description: "Red Bean Cookie was created on a frigid day when snow made of sweet rice flour fell from the sky. The hardiest grains of rice from that snowstorm were collected and used to make his thick and chewy Sweet Rice Cake Hat. The bitter winter is no challenge for Red Bean Cookie. He rides along joyfully on his sled as harsh winds muss up his red bean paste hair. As he rides along, Red Bean Cookie is always on the lookout for delicious Fish Treat Jellies. A single sniff of these tasty treats will elate even the grouchiest penguin. The more treats the penguins receive, the faster they'll pull the sled.", name: 'Red Bean Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:71]]Sweet Rice Seal' }, th: { abilities: 'Penguin Sled', description: 'เก็บฟิชทรีตเยลลี่ขณะวิ่ง ขี่เลื่อนเพนกวินตามช่วงเวลาที่กำหนด จำนวนฟิชทรีตเยลลี่ที่เก็บได้ยิ่งมาก เลื่อนยิ่งเร็ว (เลื่อนเพนกวินนับเป็นไรด์)\n\nคุกกี้เรดบีนถือกำเนิดในวันที่หนาวเหน็บเมื่อหิมะที่ทำจากแป้งข้าวหวานตกลงมาจากฟ้า เมล็ดข้าวที่แข็งแกร่งที่สุดจากพายุหิมะนั้นถูกเก็บมาทำหมวกเค้กข้าวหวานหนานุ่มของเขา ฤดูหนาวอันโหดร้ายไม่ใช่ความท้าทายสำหรับคุกกี้เรดบีน เขาขี่เลื่อนอย่างสนุกสนานขณะที่ลมแรงพัดผมถั่วแดงของเขาปลิว ขณะขี่ คุกกี้เรดบีนมองหาฟิชทรีตเยลลี่แสนอร่อยอยู่เสมอ กลิ่นของขนมเหล่านี้เพียงครั้งเดียวจะทำให้แม้แต่เพนกวินที่ขี้บ่นที่สุดก็เบิกบาน ยิ่งเพนกวินได้รับขนมมาก พวกมันก็จะลากเลื่อนเร็วขึ้น', name: 'คุกกี้รสถั่วแดง', power_plus: '', power_plus_requirement: '', unlock_goal: 'ได้รับ [[pet:71]]Sweet Rice Seal' } } } ];
INSERT [ { grade: 4, id: cookie:61, image: 'white_choco_cookie.png', rank: 3, release_date: 1454025600, tr: { en: { abilities: "Sliding charges two gauges. Standing up when the small gauge is full crushes nearby obstacles. Standing up when the big gauge is full triggers Blast Mode for a short distance. At the end of Blast Mode, obstacles in a large area are crushed. All obstacles crushed by White Choco Cookie's skill turn into White Choco Jelly. The small gauge fills faster at higher running speed.", description: "A Cookie made of indulgent gourmet white chocolate. White Choco Cookie's moves are both elegant and precise. With her fencing sword, she is sharp and graceful. Without it, she remains delicate and precise. Watch her perfect hair shine with every step she takes. White Choco Cookie can always be found surrounded by her devoted Cookie fans. With her excellent skill and dapper appearance, it's no wonder she makes the hearts of her female fans bubble with adoration.", name: 'White Choco Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Reach Lv.76' }, th: { abilities: 'Fencing', description: 'สไลด์ตามเวลาที่กำหนดแล้วยืนขึ้นเพื่อทำลายอุปสรรค เมื่อเกจเล็กเต็ม คุกกี้จะทำลายอุปสรรคใกล้เคียง เมื่อเกจใหญ่เต็ม คุกกี้จะพุ่งระยะสั้น เมื่อพุ่งจบ อุปสรรคจำนวนมากจะถูกทำลาย อุปสรรคทั้งหมดที่คุกกี้ไวท์ช็อกโก้ทำลายจะกลายเป็นไวท์ช็อกโกเยลลี่ ความเร็วที่มากขึ้นจะเติมเกจเล็กเร็วขึ้น\n\nคุกกี้ที่ทำจากไวท์ช็อกโกแลตเกรดพรีเมียมหรูหราที่มีเนยอุดมสมบูรณ์ ท่วงท่าของคุกกี้ไวท์ช็อกโก้ทั้งสง่างามและแม่นยำ ด้วยดาบฟันดาบของเธอ เธอคมและงดงาม หากไม่มีมัน เธอยังคงละเอียดอ่อนและเที่ยงตรง ชมผมที่สมบูรณ์แบบของเธอเปล่งประกายทุกย่างก้าว คุกกี้ไวท์ช็อกโก้มักถูกรายล้อมด้วยแฟนคลับคุกกี้ผู้ภักดีของเธอ ด้วยทักษะยอดเยี่ยมและรูปลักษณ์สง่างาม ไม่แปลกใจที่เธอทำให้หัวใจของแฟนสาวๆ เต้นระรัวด้วยความชื่นชม', name: 'คุกกี้รสไวท์ช็อกโก้', power_plus: '', power_plus_requirement: '', unlock_goal: 'ถึงเลเวล 76' } } }, { grade: 4, id: cookie:62, image: 'herb_cookie.png', rank: 3, release_date: 1456790400, tr: { en: { abilities: "A water gauge appears above Herb Cookie's head. Rain and Sun Jellies appear periodically. Picking up Rain Jellies causes rain, filling up the water gauge. When the gauge is full, picking up a Sun Jelly brings out the sun to turn regular Jellies into Sprout Jellies. Slower HP drain. (Leveling up makes Rain and Sun Jellies appear more frequently.)", description: "Warm like the sunshine and fresh like the scent of rain, Herb Cookie will ease your mind when you're feeling down. Made of fresh green herbs, this Cookie may not be to everyone's taste. On rainy days, Herb Cookie loves to listen to the sound of falling raindrops under his trusty leaf umbrella. On warm days, he enjoys the sunshine together with his favorite plant. This Cookie treats all living things and every moment as precious. He believes that the little things that make you laugh or cry are to be cherished, just like a ray of sunshine after the rain.", name: 'Herb Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 56 Cookies' }, th: { abilities: 'Cultivation', description: 'เรนเยลลี่และซันเยลลี่จะปรากฏตามช่วงเวลาที่กำหนด เก็บเรนเยลลี่เพื่อเติมเกจหยดน้ำฝน เมื่อเกจหยดน้ำฝนเต็ม จะไม่สามารถเก็บหยดน้ำฝนได้อีก เก็บซันเยลลี่เพื่อเรียกดวงอาทิตย์ ดวงอาทิตย์ใช้หยดน้ำฝนที่เก็บได้เปลี่ยนเยลลี่ปกติเป็นสเปราต์เยลลี่ (เรนเยลลี่และซันเยลลี่ถี่ขึ้นเมื่ออัปเกรด)\n\nอบอุ่นเหมือนแสงแดดและสดชื่นเหมือนกลิ่นฝน คุกกี้เฮิร์บจะทำให้จิตใจคุณสงบเมื่อคุณรู้สึกแย่ คุกกี้เฮิร์บทำจากส่วนผสมออร์แกนิกสดใหม่ มีคุณค่าทางโภชนาการ ซึ่งอาจไม่ถูกปากทุกคน ในวันที่ฝนตก คุกกี้เฮิร์บรักษาตัวเองให้แห้งด้วยร่มใบไม้ขณะฟังเสียงหยดฝน ในวันที่อากาศอบอุ่น คุกกี้เฮิร์บเพลิดเพลินกับแสงแดดขณะพกต้นไม้โปรดของเขา คุกกี้นี้ปฏิบัติต่อสิ่งมีชีวิตทั้งหมดและทุกช่วงเวลาว่ามีค่า เขาเชื่อว่าสิ่งเล็กๆ ในชีวิตที่ทำให้คุณหัวเราะหรือร้องไห้ควรได้รับการทะนุถนอม เหมือนแสงแดดหลังฝน', name: 'คุกกี้รสสมุนไพร', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้ 55 ตัว' } } }, { grade: 4, id: cookie:63, image: 'dino_sour_cookie.png', rank: 3, release_date: 1459728000, tr: { en: { abilities: 'Picking up a Giant Jelly enlarges the Jellysaur companion instead, letting Dino-Sour Cookie ride fast atop the Jellysaur for a short time. Landing from the air while riding the Jellysaur creates Dino Paw Jellies on the ground. Landing from greater heights creates more Jellies. (Jellysaur Ride counts as a riding skill.)', description: "Highly enriched sour jellies were melted as ingredients for this sour Cookie. The most important rule in baking Dino-Sour Cookie was styling a sharp hairdo with sour cream mousse. Because he craves extreme adventures and loves dinosaurs, he practically lives in the Dragon's Valley. On one of those adventures, he met his companion. He accidentally dropped a fossil, but to his surprise, a Jellysaur popped out! Now, these two have become the best of pals and set out on dangerous adventures together.", name: 'Dino-Sour Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 300 friends' }, th: { abilities: 'Jelly Dinosaur Ride', description: 'วิ่งกับเยลลี่ไดโนเสาร์ เร่งความเร็วกับเยลลี่ไดโนเสาร์ในโหมดตัวยักษ์ การลงจอดแบบตัวยักษ์ทำให้ไดโนฟุตเยลลี่งอกจากพื้น ยิ่งกระโดดสูง เยลลี่ที่สร้างก็ยิ่งมาก\n\nเยลลี่เปรี้ยวเข้มข้นถูกหลอมเป็นส่วนผสมสำหรับคุกกี้เปรี้ยวนี้ กฎที่สำคัญที่สุดในการอบคุกกี้ไดโนซาวร์คือการจัดทรงผมแหลมของมันด้วยมูสครีมเปรี้ยว เพราะเขาปรารถนาการผจญภัยสุดขีดและรักไดโนเสาร์ เขาจึงใช้ชีวิตอยู่ในหุบเขามังกรเป็นหลัก ในการผจญภัยครั้งหนึ่ง เขาได้พบเพื่อนร่วมทาง เขาทำฟอสซิลหล่นโดยบังเอิญ แต่ที่น่าประหลาดใจคือ เยลลี่ไดโนเสาร์โผล่ออกมา! ตอนนี้ ทั้งคู่กลายเป็นเพื่อนซี้และออกผจญภัยอันตรายด้วยกัน', name: 'คุกกี้ไดโนเสาร์', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี เพื่อน 333 คน' } } }, { grade: 6, id: cookie:64, image: 'sea_fairy_cookie.png', rank: 5, release_date: 1459728000, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Sea Fairy Cookie launches a powerful Wave Blast. During Wave Blast, Wave Beads crush obstacles, creating Sea Crystal Jellies.', description: "Sea Fairy Cookie was frozen under a curse long, long ago. But perhaps because of her grieving heart, her soul was frozen beyond magic. If it weren't for the warm kindness of our Cookies, she might have chosen to stay frozen forever. Beyond her flowing hair, the twinkle in her eyes shows that she is still willing to fight her fate. Let's hope she does not let go of her sword, giving up hope and choosing to turn into sea foam.", name: 'Sea Fairy Cookie', power_plus: 'Recovers partial Energy when colliding with an obstacle at a given interval (More recovery with upgrades)', power_plus_requirement: '', unlock_goal: 'Gather 100 Warming Hearts' }, th: { abilities: 'Wave Blast', description: 'เรียกคลื่นทรงพลังและพุ่งตามช่วงเวลาที่กำหนด ระหว่างเวฟพุ่ง ลูกปัดคลื่นทำลายอุปสรรค สร้างซีคริสตัลเยลลี่\n\nด้วยความพิโรธของมังกรที่ปกคลุมโลกคุกกี้ คำสาปของนางฟ้าทะเลเริ่มละลายทีละน้อย แต่บางทีอาจเพราะหัวใจที่โศกเศร้าของเธอ วิญญาณของเธอจึงถูกแช่แข็งเกินกว่าจะมีเวทมนตร์ใดช่วย ถ้าไม่ใช่เพราะความเมตตาอันอบอุ่นของเหล่าคุกกี้ของเรา เธออาจเลือกที่จะแช่แข็งตลอดไป ตอนนี้ เคียงข้างเหล่าคุกกี้ของเรา เธอต่อสู้กับเปลวเพลิงของมังกรแดงด้วยความสามารถในการควบคุมอากาศหนาวเย็นและน้ำ เหนือผมที่พลิ้วไหวของเธอ ประกายในดวงตาของเธอยังคงบอกว่าเธอเต็มใจสู้กับชะตากรรมของเธอ หวังว่าเธอจะไม่ปล่อยดาบของเธอ ละทิ้งความหวัง และเลือกที่จะกลายเป็นฟองทะเล', name: 'คุกกี้นางฟ้าทะเล', power_plus: 'Recovers partial Energy when colliding with an obstacle at a given interval (More recovery with upgrades)', power_plus_requirement: '', unlock_goal: 'รางวัลพิเศษจากการเก็บหัวใจเพลิง 100 ดวง' } } }, { grade: 4, id: cookie:65, image: 'cotton_candy_cookie.png', rank: 3, release_date: 1461888000, tr: { en: { abilities: 'Collects a unique set of Alphabet Jellies that lead to a special Bonus Time. Touching Mail Boxes in Bonus Time creates Heart Letters. Occasionally throws away unfinished love letters that burst destroying obstacles and creating Cotton Candy Jellies. (While running, Alphabet Jellies may sometimes appear in place of basic Jellies.)', description: "Cotton Candy Cookie is made from the sweetest of sugars and undoubtedly has the highest level of sugar among the Cookies. With such a saccharine heart, no wonder she's always in love! Cotton Candy Cookie spends all her days writing love letters but ends up throwing away more than she sends. Her goal is not to reveal her feelings to her beloved one but to cherish each moment of being in love. Cookies often joke that Cotton Candy Cookie sends way too many letters, but the truth is that everyone secretly wishes for one: what's inside the envelope is so very sweet!", name: 'Cotton Candy Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:75]]Cotton Candy Bird' }, th: { abilities: 'Cotton Candy Letter', description: 'เก็บตัวอักษรที่แปลกประหลาดและไปยังโบนัสไทม์พิเศษ ส่งจดหมายรักผ่านไปรษณีย์นกในช่วงโบนัสไทม์เพื่อสร้างฮาร์ตเยลลี่ ทิ้งจดหมายรักที่ยังเขียนไม่เสร็จ ซึ่งทำลายอุปสรรคและสร้างคอตตอนแคนดี้เยลลี่ (อัลฟาเบ็ตเยลลี่ปรากฏเป็นครั้งคราวระหว่างเยลลี่ปกติ)\n\nคุกกี้ที่ทำจากน้ำตาลหวานๆ เห็นได้ชัดว่าคุกกี้คอตตอนแคนดี้มีระดับน้ำตาลสูงที่สุดในบรรดาคุกกี้ ด้วยหัวใจที่หวานขนาดนี้ ไม่แปลกที่เธอจะตกหลุมรักอยู่เสมอ! เธอใช้เวลาทั้งวันเขียนจดหมายรัก แต่ทิ้งจดหมายมากกว่าที่ส่ง เธอไม่ได้เขียนจดหมายเหล่านั้นเพื่อให้ความรักของเธอเป็นจริง แต่เพื่อทะนุถนอมทุกช่วงเวลาของการมีความรัก คุกกี้เกือบทุกตัวได้รับจดหมายจากคุกกี้คอตตอนแคนดี้ ว่ากันว่าเนื้อหาในจดหมายหวานมาก จนคุกกี้ทุกตัวหวังว่าจะได้รับสักฉบับ', name: 'คุกกี้รสสายไหม', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยง Cotton Candy Birdie' } } }, { grade: 4, id: cookie:66, image: 'roll_cake_cookie.png', rank: 3, release_date: 1464652800, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Double Jumping causes Roll Cake Cookie to slam down his hammer, crushing obstacles and creating Spare Part Jellies. Collecting 34 Spare Part Jellies summons the Road Roller for riding in Blast Mode (Road Roller counts as a riding skill.)', description: "Roll Cake Cookie was made out of the yummiest ingredients and generously decorated with the fluffiest fresh whipped cream. Sounds like a great combination? Far from it! Roll Cake Cookie has quite a set of destructive habits. First, he likes to smash things with a giant hammer. Second, he rides an enormous road roller. And as if that wasn't enough, once Roll Cake Cookie was caught yelling, \"I ONLY WANTED TO BE A LOVABLE CAKE!\" Perhaps the milked cow had a wild side, or the whipped cream was whipped too much? We'll never know!", name: 'Roll Cake Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:76]]Light Bros' }, th: { abilities: 'Road Roller', description: 'สามารถใช้ค้อนได้ตามช่วงเวลาที่กำหนด ขณะใช้ค้อน การลงจอดกระโดดสองชั้นทำลายอุปสรรคและสร้างอิ้งเกรเดียนท์เยลลี่ โรดโรลเลอร์จะถูกเรียกเมื่อเก็บอิ้งเกรเดียนท์เยลลี่ได้ 37-30 อัน (สกิลนับเป็นการขี่)\n\nคุกกี้ที่ทาด้วยวิปครีมสดจำนวนมาก ใช้เฉพาะส่วนผสมที่นุ่มและหวานที่สุดในการทำคุกกี้นี้ ดังนั้นจึงเป็นปริศนาอย่างยิ่งว่าทำไมเขาถึงป่าเถื่อนขนาดนี้ คุกกี้รสเค้กโรลพกค้อนโรลเค้กยักษ์เพื่อบดขยี้อุปสรรคทั้งหมดบนเส้นทางของเขา แต่นั่นไม่ใช่ทั้งหมด เขาขี่โรดโรลเลอร์ขนาดมหึมาของเขาเพื่อบดเพิ่มอีก อุ๊ย ช่างเป็นตัวละครอะไรเช่นนี้ (แต่พวกเขาบอกว่าโรดโรลเลอร์อร่อยกว่าด้วยอัลมอนด์ที่ติดมาจากการบดทั้งหมด!) บางทีวัวที่รีดนมอาจมีด้านป่าเถื่อน หรือวิปครีมอาจถูกตีมากเกินไป? เราไม่มีทางรู้ และนี่คือปริศนาอีกข้อที่ต้องไข คุกกี้รสเค้กโรลถูกได้ยินตะโกนว่า "ฉันก็อยากเป็นเค้กที่น่ารักเหมือนกัน!"', name: 'คุกกี้รสเค้กโรล', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสัตว์เลี้ยง [[pet:76]]Light Bros' } } }, { grade: 4, id: cookie:67, image: 'banana_cookie.png', rank: 3, release_date: 1467331200, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Banana Cookie leaves the stage to Choco the Monkey. The more hoops the monkey jumps through, the more Coins are dropped to the ground at the end of his performance.', description: "Banana Cookie's fabulous hula hoop show begins! She used be a world-famous wilderness explorer, becoming friends with all sorts of animals and critters. With so many fresh bananas from the tallest of trees in her dough, it's no wonder that Banana Cookie is an expert climber. While climbing a massive tree, she met Choco the Monkey. The two immediately knew they were best friends for life! The duo decided to join the circus and, ever since, their show has energized crowds to the max! Banana Cookie is always so full of energy that it seems she never gets tired from performing! Perhaps she's enjoying her own shows a bit too much. Even after the curtains close, she's still spinning her hula hoop. Some say she's too excited because of all the Coins that were thrown on stage. But in reality, she's just excited and happy all the time!", name: 'Banana Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:77]]Banana Lion' }, th: { abilities: 'Circus', description: 'ตามช่วงเวลาที่กำหนด จะถูกแทนที่ด้วยลิง ผ่านห่วงฮูลาฮูปเป็นลิงเพื่อรับเหรียญ\n\nเชิญชมการแสดงฮูลาฮูปสุดหวานของคุกกี้รสกล้วย! เมื่อเข้าไป คุณจะเห็นว่าผู้ชมเต็มไปด้วยเพื่อนสัตว์ป่าของเธอ หลังจากนั้น เธอเคยเป็นนักสำรวจชื่อดังระดับโลก การชมการแสดงของเธอจะเติมพลังให้คุณถึงขีดสุด! ส่วนโปรดของการแสดงของคุกกี้รสกล้วยคือตอนที่เธอถูกโรยด้วยเหรียญหลังการแสดงรอบสุดท้าย บางทีเธออาจสนุกกับมันเกินไปเล็กน้อย บางคนถึงกับบอกว่าเธอเก็บเหรียญทั้งหมด แม้ว่าลิงจะเป็นคนเล่นกล แต่ความจริงคือ เธอบริจาครายได้ส่วนใหญ่ของคณะละครสัตว์ให้องค์กรพิทักษ์สัตว์ และลิงก็เห็นด้วย', name: 'คุกกี้รสกล้วย', power_plus: '', power_plus_requirement: '', unlock_goal: 'ไม่สามารถรับได้' } } }, { grade: 4, id: cookie:68, image: 'pancake_cookie.png', rank: 3, release_date: 1471392000, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Pancake Cookie starts flying. Acorn Jellies and Sunflower Jellies appear while in flight. Picking up Sunflower Jellies creates Sunflower Seed Jellies. (Leveling up makes the gauge fill faster.)', description: "Browned to perfection, the ever-energetic Pancake Cookie is cute to the extreme. And unlike his brother, he chooses to use his cuteness to the fullest! He even added a piece of butter on top of his head to make himself even cuter. Cuteness overload! This sweet and innocent Cookie's favorite thing in the world is Acorn Jelly. When he sees one, he'll use all his cutie pie charms to get that Acorn Jelly. You can try to resist his charms, but he'll get that Acorn Jelly from you one way or another.", name: 'Pancake Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have [[cookie:66]]Roll Cake Cookie' }, th: { abilities: 'Flying Squirrel', description: 'สร้างอโกร์นเยลลี่และซันฟลาวเวอร์เยลลี่และบินตามช่วงเวลาที่กำหนด การเก็บซันฟลาวเวอร์เยลลี่จะสร้างซันฟลาวเวอร์ซีดเยลลี่ (อัปเกรดเพื่อบินถี่ขึ้น)\n\nอบจนเป็นสีน้ำตาลทองสมบูรณ์ คุกกี้รสแพนเค้กน่ารักและมีชีวิตชีวาถือกำเนิด ต่างจากพี่ชายของเขา เขาน่ารักสุดขีด และเขารู้ดี! เขาถึงกับใส่เนยชิ้นหนึ่งบนหัวเพื่อให้ตัวเองน่ารักยิ่งขึ้น น่ารักเกินต้านทาน! สิ่งที่คุกกี้แสนหวานบริสุทธิ์คนนี้ชอบที่สุดในโลกคืออโกร์นเยลลี่ คุณสามารถพยายามต่อต้านเสน่ห์ของเขาได้ แต่เขาจะได้อโกร์นเยลลี่จากคุณไม่ทางใดก็ทางหนึ่ง', name: 'คุกกี้รสแพนเค้ก', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้ Roll Cake' } } }, { grade: 6, id: cookie:69, image: 'wind_archer_cookie.png', rank: 5, release_date: 1471392000, tr: { en: { abilities: 'Pulls his bowstring while the Slide button is held and shoots at the fallen souls when it is released. Hitting a certain number of fallen souls will trigger Wind Dash. (Leveling up reduces the number of fallen souls needed to trigger Wind Dash)', description: "Originally, this Cookie was the wind who loved the green of the forest. This wind delightfully spent its days spreading fresh and sweet fragrances across the forest. In order to save the paradise in peril, a mysterious being granted it the power to purify the Darkness. This transformed the wind into Wind Archer Cookie, the protector of the forest. As long as Wind Archer Cookie's heart keeps hope, he'll carry on his duty.", name: 'Wind Archer Cookie', power_plus: 'Creates Mystery Box at a given rate in Episode 5 "Dessert Paradise" (Higher probability with upgrades)', power_plus_requirement: '', unlock_goal: 'Special acquisition (event / no unlock condition in data)' }, th: { abilities: 'Wind Dash', description: 'กดปุ่มสไลด์เพื่อดึงสายธนูและปล่อยเพื่อโจมตีวิญญาณที่ล้มลง การโจมตีวิญญาณที่ล้มลงในจำนวนที่ถูกต้องจะปล่อยวินด์แดช (การอัปเกรดจะลดจำนวนวิญญาณที่ล้มลงที่ต้องใช้ในการปล่อยวินด์แดช)\n\nเดิมที คุกกี้นี้คือสายลมที่รักความเขียวขจีของป่า สายลมนี้ใช้เวลาอย่างมีความสุขในการโปรยกลิ่นหอมสดชื่นหวานไปทั่วป่า จนกระทั่งวิญญาณที่ล้มลงเริ่มรุกรานป่าและกินทุกสิ่งที่หวานที่พวกมันเห็น เหลือไว้ให้ของหวานใช้ชีวิตด้วยความกลัว เพื่อช่วยสวรรค์ที่ตกอยู่ในอันตราย หงส์น้ำตาล เป่าชีวิตและพลังแห่งการชำระล้างเข้าไปในสายลม เปลี่ยนสายลมให้เป็นคุกกี้นักธนูแห่งสายลม ผู้พิทักษ์ป่าจากความมืด ตราบใดที่หัวใจของคุกกี้นักธนูแห่งสายลมซึ่งบรรจุความหวังของป่ายังคงอยู่ เขาจะไม่มีวันหยุดปกป้องป่า', name: 'คุกกี้นักธนูแห่งสายลม', power_plus: 'Creates Mystery Box at a given rate in Episode 5 "Dessert Paradise" (Higher probability with upgrades)', power_plus_requirement: '', unlock_goal: 'รางวัลพิเศษจากการเก็บอัญมณีลึกลับทั้งหมดในตอนที่ 5: Dessert Paradise' } } }, { grade: 4, id: cookie:70, image: 'moon_rabbit_cookie.png', rank: 3, release_date: 1473724800, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Moon Rabbit Cookie transforms into a giant Rice Cake Bunny. In this form, landing from a Jump stomps up Honey Rice Cake Jellies. Giant Rice Cake Bunny gets bigger and jumps become higher as time goes by.', description: "Fresh rice harvested from the happy soils of the Cookie World was used for baking cheerful Moon Rabbit Cookie. This Cookie's chubby cheeks are always filled with sweet rice cakes. While some may think it's cute, her craving for more rice cakes may be one of the strongest forces of the Universe. That craving can even become so strong that she might turn into a giant Rice Cake Bunny, and—oh boy!—you'd better keep your distance because she is going to wreak SWEET HAVOC. A group of particularly brave Cookies once tried to keep the giant Rice Cake Bunny in check by grabbing each other's hands and building a circle around her. Ever since, the Cookies have kept a tradition of holding hands and going around in circles under the full moon.", name: 'Moon Rabbit Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 58 Cookies' }, th: { abilities: 'Rice Cake Bunny', description: 'แปลงร่างเป็นกระต่ายข้าวปั้นยักษ์ตามช่วงเวลาที่กำหนด การลงจอดของกระต่ายข้าวปั้นยักษ์สร้างฮันนี่ไรซ์เค้กเยลลี่ ขนาดของกระต่ายข้าวปั้นยักษ์ใหญ่ขึ้นและการกระโดดสูงขึ้นเมื่อเวลาผ่านไป\n\nข้าวสดที่เก็บเกี่ยวจากผืนดินอันมีความสุขของสวรรค์แห่งของหวานถูกใช้เพื่ออบคุกกี้มูนแรบบิทผู้มีความสุข แก้มอ้วนของคุกกี้นี้เต็มไปด้วยเค้กข้าวหวานเสมอ น่ารักจริงๆ! แต่ความปรารถนาเค้กข้าวของเธอมีด้านมืดเช่นกัน ภายใต้พระจันทร์เต็มดวง ความอยากเค้กข้าวของคุกกี้มูนแรบบิทสามารถเพิ่มขึ้นจนเธอแปลงร่างเป็นกระต่ายข้าวปั้นยักษ์! จากนั้นเธอก็กระโดดไปมาอย่างบ้าคลั่ง บดขยี้ทุกสิ่งรอบตัวจนกว่าจะมีใครให้เค้กข้าวเพื่อสงบเธอ กาลครั้งหนึ่ง ระหว่างการแปลงร่างสุดบ้าคลั่งครั้งหนึ่ง คุกกี้ตัวอื่นพยายามควบคุมกระต่ายข้าวปั้นยักษ์ด้วยการจับมือกันเป็นวงล้อมรอบเธอ ตั้งแต่นั้นมา คุกกี้รักษาประเพณีการจับมือและเดินเป็นวงกลมใต้พระจันทร์เต็มดวง', name: 'คุกกี้กระต่ายบนดวงจันทร์', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้ 58 ตัว' } } }, { grade: 4, id: cookie:71, image: 'strawberry_shortcake_cookie.png', rank: 3, release_date: 1712016000, tr: { en: { abilities: 'Periodically creates Dog Chew Jellies that trigger Blast on all fours. Each Dog Chew Jelly fills the green gauge a little. When it is full, Strawberry Shortcake Cookie rides a Giant Cake Hound and turns nearby Jellies into Cake Slice Jellies. (Giant Cake Hound counts as a riding skill.)', description: "Once a Cake Hound deeply loved by their Cookie, they eventually went to doggy heaven. After making a wish to the Witch, they returned as half-Cookie, half-hound. While they can't quite remember their Cookie's face anymore, the joyful memories they shared remain vivid. Perhaps a familiar sniff will help them recognize the Cookie again!", name: 'Strawberry Shortcake Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Gather 400 Sweet Berry Slices' }, th: { abilities: 'Giant Cake Hound', description: '<tabber>\n\nครั้งหนึ่งเคยเป็นฮาวด์เค้กที่คุกกี้ของมันรักมาก สุดท้ายก็ไปสู่สุคติของหมา หลังจากอธิษฐานต่อแม่มด พวกมันกลับมาเป็นครึ่งคุกกี้ครึ่งฮาวด์ แม้พวกมันจะจำใบหน้าของคุกกี้ของมันไม่ได้อีกแล้ว แต่ความทรงจำอันสนุกสนานที่แบ่งปันกันยังคงชัดเจน บางทีกลิ่นคุ้นเคยอาจช่วยให้พวกมันจำคุกกี้นั้นได้อีกครั้ง!', name: 'คุกกี้สตรอว์เบอร์รีชอร์ตเค้ก', power_plus: '', power_plus_requirement: '', unlock_goal: '*เก็บชิ้นสตรอเบอร์รีหวาน 400 ชิ้น (Kakao)\n*มีสมบัติระดับ S 10 ชิ้น (India)' } } }, { grade: 4, id: cookie:72, image: 'gulab_jamun_cookie.png', rank: 3, release_date: 1733875200, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Gulab Jamun Cookie starts a festival, dancing to the music, setting off color splashes, and creating Gulab Jamun Jellies and Coins. The more Gulab Jamun Jellies are collected, the greater the color splash. (Leveling up increases Gulab Jamun Jelly Points.)', description: 'Little Gulab Jamun Cookie fell in love with dance at her very first Holi, many years ago. Now, there is no other dancer as graceful as she is. Her movements are as vibrant and fluid as honeyed syrup, yet delicate, leaving behind a faint but captivating trail of cardamom and rose. It is said that just watching Gulab Jamun Cookie perform can free your heart of all worries.', name: 'Gulab Jamun Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 45 Treasures at +9' }, th: { abilities: 'Color Splash', description: '<tabber>\n\n<tabber> |-|India= คุกกี้กุแล็บจามุนตัวน้อยตกหลุมรักการเต้นรำในเทศกาลโฮลีครั้งแรกเมื่อหลายปีก่อน ตอนนี้ ไม่มีนักเต้นคนใดสง่างามเท่าเธอ ท่วงท่าของเธอสดใสและลื่นไหลราวกับไซรัปน้ำผึ้ง แต่ก็ละเอียดอ่อน ทิ้งกลิ่นกระวานและกุหลาบอันน่าหลงใหลจางๆ ว่ากันว่าเพียงแค่ดูคุกกี้กุแล็บจามุนแสดง ก็สามารถปลดปล่อยหัวใจของคุณจากความกังวลทั้งหมด |-|Kakao= คุกกี้กุแล็บจามุน อบด้วยรัสกุลลาทอดในน้ำมันกุหลาบ แล้วแช่ในไซรัปน้ำตาล หลงใหลการเต้นรำในเทศกาลโฮลีตั้งแต่เด็ก ตอนนี้คุกกี้นี้ดึงดูดใจคุกกี้ตัวอื่นด้วยท่าเต้นที่สะกดใจในเทศกาลต่างๆ การดูการเต้นของคุกกี้นี้ทำให้จิตวิญญาณของคุณรู้สึกเป็นอิสระ </tabber>', name: 'คุกกี้กุแลปจามุน', power_plus: '', power_plus_requirement: '', unlock_goal: '*ทำคะแนน 1,50,00,000 แต้ม (India)\n*อัปเกรดสมบัติ 45 ชิ้นถึง +9 (Kakao)' } } }, { grade: 4, id: cookie:73, image: 'kaju_katli_cookie.png', rank: 3, release_date: 1733875200, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Kaju Katli Cookie throws his spear, crushing obstacles and creating Kaju Katli Jellies in their place. Picking up the spear triggers Blast Mode while flinging it around. (Leveling up increases Kaju Katli Jelly Points.)', description: 'Delectable kaju and silky condensed milk? What a noble combination! Alas, Prince Kaju Katli Cookie is forced to hide his regal descent to pursue his dream of traveling the lands. Armed with his trusty spear, Kaju Katli Cookie is on a quest to unravel what his fate holds in store. Ah, the infinite mysteries of the world!', name: 'Kaju Katli Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 35 evolved S Treasures' }, th: { abilities: 'Master of the Spear', description: '<tabber>\n\n<tabber> |-|India= กาจูอันโอชะและนมข้นเนียนนุ่ม—ช่างเป็นการผสมผสานที่งดงาม! อนิจจา เจ้าชายคุกกี้กาจูคัตลีถูกบังคับให้ซ่อนเชื้อพระวงศ์ของเขาเพื่อไล่ตามความฝันในการท่องดินแดน ติดอาวุธด้วยหอกคู่ใจ คุกกี้กาจูคัตลีออกตามหาว่าโชคชะตาของเขาจะเป็นเช่นไร อ่า ความลึกลับอันไม่มีที่สิ้นสุดของโลก! |-|Kakao= คุกกี้กาจูคัตลี อบด้วยความเข้มข้นของกาจูและนมข้นเหนียวข้น เจ้าชายผู้ซ่อนตัวตน ผู้อยากรู้อยากเห็นเกี่ยวกับโลกนอกวัง คุกกี้นี้ถือหอกไว้ในมือ วิ่งฝ่าชะตากรรมอย่างกล้าหาญเพื่อค้นหาตัวตนที่แท้จริงในการเดินทาง อยากสำรวจความลับอันไม่มีที่สิ้นสุดของโลก! </tabber>', name: 'คุกกี้กาจูแคตลี', power_plus: '', power_plus_requirement: '', unlock_goal: '*ถึงเลเวล 30 (India)\n*ครอบครองสมบัติวิวัฒน์เกรด S 35 ชิ้น (Kakao)' } } }, { grade: 4, id: cookie:74, image: 'marshmallow_bunny_cookie.png', rank: 3, release_date: 1743033600, tr: { en: { abilities: 'Periodically summons Bunny Tunnel Portals that restore a small amount of HP and trigger Blast while creating Coins and Marshmallow Jellies. Entering a Giant Bunny Tunnel Portal leads to a magical world full of Coins and Jellies, where multiple jumps and magnetic effect are active.', description: "Marshmallow Bunny Cookie is always full of bubbly curiosity! Hopping in and out of her Bunny Tunnel, Marshmallow Bunny Cookie always goes wherever the fun is. Nothing is more exciting than jumping into the great unknown: that's how one learns new stories—the greatest treasure there is!", name: 'Marshmallow Bunny Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Gather 400 Marshmallow Eggs' }, th: { abilities: 'Mysterious World', description: 'คุกกี้มาร์ชเมลโลว์บันนี่เต็มไปด้วยความอยากรู้อยากเห็น! กระโดดเข้าออกอุโมงค์บันนี่ของเธอ คุกกี้มาร์ชเมลโลว์บันนี่ไปทุกที่ที่มีความสนุก ไม่มีอะไรน่าตื่นเต้นไปกว่าการกระโดดเข้าสู่สิ่งที่ไม่รู้จัก นั่นคือวิธีเรียนรู้เรื่องราวใหม่—สมบัติล้ำค่าที่สุด!', name: 'คุกกี้กระต่ายมาร์ชแมลโลว์', power_plus: '', power_plus_requirement: '', unlock_goal: 'เก็บไข่มาร์ชเมลโลว์ 400 ฟอง' } } }, { grade: 4, id: cookie:75, image: 'cucumber_cookie.png', rank: 3, release_date: 1745798400, tr: { en: { abilities: 'Periodically casts his fishing rod to crush obstacles and collect Fish Jellies. Occasionally sits down on a lotus leaf to fish for a Big Fish Jelly. Tapping both buttons rapidly fills the green gauge, resulting in a more valuable catch. Big Fish Jellies restore a small amount of HP and create a large amount of Fish Jellies. Slower HP drain while sitting on the lotus leaf.', description: 'With his laid-back personality, Cucumber Cookie would like to enjoy fishing at a leisurely pace, but the fish just keep coming. Maybe the high moisture content is the secret of every cast bringing a huge catch!', name: 'Cucumber Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 67 Cookies' }, th: { abilities: 'Fishing', description: 'ด้วยบุคลิกสบายๆ คุกกี้แตงกวาอยากเพลิดเพลินกับการตกปลาอย่างช้าๆ แต่ปลาก็เข้ามาเรื่อยๆ บางทีความชุ่มชื้นสูงอาจเป็นความลับที่ทำให้ทุกการตกได้ปลาใหญ่!', name: 'คุกกี้แตงกวา', power_plus: '', power_plus_requirement: '', unlock_goal: 'เก็บคุกกี้ 67 ตัว' } } } ];
INSERT [ { grade: 4, id: cookie:76, image: 'sikhye_cookie.png', rank: 3, release_date: 1748476800, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Sikhye Cookie builds a house out of Baduk Stone Jellies. Winning the gambit by collecting most of the Sealed White Stone Jellies creates a White Masterful Gambit Stone. Throwing this stone crushes obstacles earning Crush Points and triggers coin fireworks.', description: 'Sikhye Cookie spends more time lingering in front of a candy store choosing treats than contemplating her next move! As soon as she sits down in front of a Baduk board, her eyes gleam as she plans dozens of moves ahead in an instant. With her free-spirited nature, she constantly throws moves as unpredictable as the grains of rice in Sikhye at her opponent.', name: 'Sikhye Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 70 Cookies at Lv.8' }, th: { abilities: 'Masterful Gambit', description: 'คุกกี้ซิกเคใช้เวลาอยู่หน้าร้านขายขนมเลือกขนมมากกว่าคิดหมากต่อไป! ทันทีที่นั่งลงหน้ากระดานบาดุก ดวงตาของเธอเป็นประกายขณะวางแผนล่วงหน้าหลายสิบหมากในชั่วพริบตา ด้วยนิสัยอิสระของเธอ เธอส่งหมากที่คาดเดาไม่ได้เหมือนเมล็ดข้าวในซิกเคใส่คู่ต่อสู้ตลอดเวลา', name: 'คุกกี้ซิกเค', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี คุกกี้เลเวล 8 จำนวน 70 ตัว' } } }, { grade: 4, id: cookie:77, image: 'sujeonggwa_cookie.png', rank: 3, release_date: 1748476800, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Sujeonggwa Cookie builds a house out of Baduk Stone Jellies. Winning the gambit by collecting most of the Sealed Black Stone Jellies creates a Black Masterful Gambit Stone. Throwing this stone crushes obstacles, earns Crush Points, and triggers coin fireworks.', description: 'With a subtle scent of cinnamon and a focus as firm as ginger, Sujeonggwa Cookie always sits before the Baduk board with a look of perfect calm. With each move built upon sincerity, she always delivers quiet yet profound moves, much like the subtle sweetness lingering at the end of a bitter flavor.', name: 'Sujeonggwa Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:86]]Elder White Rice' }, th: { abilities: 'Masterful Gambit', description: 'ด้วยกลิ่นอบเชยละมุนและสมาธิแน่วแน่ดั่งขิง คุกกี้ซูจองกวานั่งอยู่หน้ากระดานบาดุกด้วยสีหน้าสงบนิ่งสมบูรณ์แบบ ทุกหมากวางบนความจริงใจ เธอส่งหมากที่เงียบแต่ลึกซึ้งเสมอ เหมือนความหวานละมุนที่ติดปลายลิ้นหลังรสขม', name: 'คุกกี้ซูจองกวา', power_plus: '', power_plus_requirement: '', unlock_goal: 'ปลดล็อก [[pet:85]]Elder Black Rice' } } }, { grade: 4, id: cookie:78, image: 'barley_sentry_cookie.png', rank: 3, release_date: 1751241600, tr: { en: { abilities: 'Gains Magnetic Aura and points for all Jellies while shielded. Grows larger and faster with each gathered Barley Jelly. Catching a Barley Jelly fills the green gauge a little. When it is full, Barley Sentry Cookie assumes his sentry form, triggering Blast while creating Jellies and crushing obstacles. Partially restores HP at the end of the transformation.', description: 'Barley Sentry Cookie usually flutters around like a baby sparrow, but at crucial times, he seizes the moment to transform into a fierce warrior, defeating enemies with his sturdy Barley Spear in hand. He looks quite dignified and serious as he keeps on the lookout for bugs hiding in the fields.', name: 'Barley Sentry Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 40 evolved S Treasures' }, th: { abilities: 'Sentry Flight', description: 'คุกกี้ทหารรักษาการณ์บาร์เลย์มักบินไปมาเหมือนลูกกระจ๊อก แต่ในยามวิกฤต เขาคว้าโอกาสแปลงร่างเป็นนักรบดุร้าย เอาชนะศัตรูด้วยหอกบาร์เลย์อันแข็งแกร่งในมือ เขาดูสง่างามและจริงจังขณะเฝ้ามองหาแมลงที่ซ่อนตัวอยู่ในทุ่งนา', name: 'คุกกี้ยามข้าวบาร์เลย์', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองสมบัติเกรด S วิวัฒน์ 40 ชิ้น' } } }, { grade: 5, id: cookie:79, image: 'princess_bari_cookie.png', rank: 4, release_date: 1753920000, tr: { en: { abilities: 'Periodically transforms Jellies into three types of Flower Jellies that fill the flower gauge. When the gauge is full, Princess Bari Cookie enters the forest of the Sacred Tree to banish spirits to the afterlife, leaving behind Spirit Jellies. Banishing a giant spirit yields a Healing Water Jelly that restores HP and triggers Blast Mode. Healing Water Jellies do not count as HP Potions. (Leveling up increases Flower Jelly Points.)', description: 'Princess Bari, having completed her arduous journey, has finally been reborn as a Goddess of the Underworld. Princess Bari Cookie sends lost souls to the netherworld. Every swing of her sword releases the fragrance of the three flowers from the Sacred Tree it was woven from. Princess Bari Cookie does not rush to comfort the sorrowful spirits, nor does she turn away from them. She simply leads them to the final world that will take in everyone equally.', name: 'Princess Bari Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: "Gather 20 Princess Bari Cookie's Soulstones" }, th: { abilities: 'Banishment', description: 'แปลงร่างเป็นฟลาวเวอร์เยลลี่สามชนิดเป็นระยะเพื่อเติมเกจดอกไม้ เมื่อเกจเต็ม [[cookie:8]]บารีเข้าสู่ป่าแห่งต้นไม้ศักดิ์สิทธิ์เพื่อขับไล่วิญญาณสู่ปรโลก ทิ้งสปิริตเยลลี่ไว้เบื้องหลัง การขับไล่วิญญาณยักษ์ให้ฮีลลิ่งวอเตอร์เยลลี่ที่ฟื้นฟูพลังชีวิตและปล่อยโหมดพุ่ง ฮีลลิ่งวอเตอร์เยลลี่ไม่นับเป็นโพชันพลังชีวิต (การเลเวลอัพเพิ่มคะแนนฟลาวเวอร์เยลลี่)\n\nเจ้าหญิงบารี ผู้เสร็จสิ้นการเดินทางอันแสนทรหด ในที่สุดก็เกิดใหม่เป็นเทพธิดาแห่งยมโลก [[cookie:8]]บารีส่งวิญญาณที่หลงทางไปสู่ปรโลก ทุกครั้งที่ฟันดาบ กลิ่นหอมของดอกไม้สามชนิดจากต้นไม้ศักดิ์สิทธิ์ที่ใช้ทอด้ามจะปล่อยออกมา [[cookie:8]]บารีไม่รีบเร่งที่จะปลอบโยนวิญญาณที่โศกเศร้า และไม่หันหนีจากพวกมัน เธอเพียงนำพวกมันไปสู่โลกสุดท้ายที่รองรับทุกคนอย่างเท่าเทียม', name: 'คุกกี้เจ้าหญิงบารี', power_plus: '', power_plus_requirement: '', unlock_goal: 'เก็บโซลสโตน 20 ก้อน' } } }, { grade: 4, id: cookie:80, image: 'potato_salad_cookie.png', rank: 3, release_date: 1756339200, tr: { en: { abilities: 'Periodically throws various carpets that create Coins and fill the green gauge a little. When the gauge is full, Potato Salad Cookie rides on his delivery bike as boiled potatoes and mayonnaise spread across the floor. Riding over them creates Coins. Landing on them from a jump creates even more Coins.', description: 'Potato Salad Cookie travels far and wide carrying his fresh veggie carpets, stitch by stitch handcrafted with overflowing affection for vegetables. Be it on his hooves or on his delivery bike "Mayo Vroom Vroom", this Cookie reaches even the farthest corners of the land. As a true merchant, naturally he loves Coins and makes a jingling sound wherever he runs.', name: 'Potato Salad Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:89]]Tater Trader' }, th: { abilities: 'Salad Bomb', description: 'คุกกี้โปเตโต้ซาลัดเดินทางไปทั่วสารทิศพร้อมกับพรมผักสดของเขา ประกอบด้วยมือทีละฝีเข็มด้วยความรักอันล้นเหลือต่อผัก ไม่ว่าจะบนกีบเท้าหรือจักรยานส่งของ "มาโยวรูมรูม" คุกกี้นี้ไปถึงมุมที่ไกลที่สุดของแผ่นดิน ในฐานะพ่อค้าตัวจริง แน่นอนว่าเขารักเหรียญและส่งเสียงกรุ๊งกริ๊งทุกที่ที่วิ่ง', name: 'คุกกี้สลัดมันฝรั่ง', power_plus: '', power_plus_requirement: '', unlock_goal: 'ปลดล็อก [[pet:89]]Tater Trader' } } }, { grade: 4, id: cookie:81, image: 'scallion_kimchi_cookie.png', rank: 3, release_date: 1759104000, tr: { en: { abilities: 'Periodically performs sword slashes to crush obstacles and fill the green gauge. When the gauge is full, Scallion Kimchi Cookie charges forward while slashing obstacles in her way. Scallion Kimchi Bear Jellies spawn wherever Scallion Kimchi Cookie crushes obstacles. (Leveling up increases Crush Points.)', description: "Originally a fresh, vibrant green scallion, Scallion Kimchi Cookie returned in fully fermented form from the training she was called on by the heavens. Her haggard appeaerance alone may seem enough to scare away ghosts, but once you see the sharp blades in her hands flashing, you'll know she's about to unleash the spiciest exorcism you can imagine!", name: 'Scallion Kimchi Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 50 evolved S Treasures' }, th: { abilities: 'Scallion Kimchi', description: 'เดิมทีเป็นต้นหอมสดเขียวชอุ่ม คุกกี้สแกลเลียนคิมจิกลับมาในรูปแบบที่หมักเต็มที่จากการฝึกที่สวรรค์เรียกหาเธอ รูปร่างทรุดโทรมของเธอเพียงอย่างเดียวอาจดูพอจะไล่ผีได้ แต่เมื่อเห็นใบมีดคมในมือเธอวับวาว คุณจะรู้ว่าเธอกำลังจะปล่อยพิธีไล่ผีที่เผ็ดที่สุดเท่าที่คุณจะจินตนาการได้!', name: 'คุกกี้กิมจิต้นหอม', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติ S วิวัฒน์ 50 ชิ้น' } } }, { grade: 4, id: cookie:82, image: 'white_kimchi_cookie.png', rank: 3, release_date: 1759104000, tr: { en: { abilities: 'Catching flying White Kimchi Rolls attaches talismans to surrounding obstacles to make it possible to pass them for Evasion Points. Collecting a certain number of White Kimchi Rolls summons Cabbage Spirits that can be passed through for Evasion Points. (Leveling up increases Evasion Points.)', description: "White Kimchi Cookie soothes souls with her graceful and pure shamanic dance. Her solemn and serene movements resemble the dance of a butterfly. It is said that all souls that touch the leaves of the White Kimchi Cookie's robe are freed from their suffering.", name: 'White Kimchi Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 55 Treasures at +9' }, th: { abilities: 'White Kimchi', description: 'คุกกี้ไวท์คิมจิปลอบประโลมวิญญาณด้วยการร่ายรำชามานิกอันบริสุทธิ์ ท่วงท่าอันเคร่งขรึมและสงบนิ่งของเธอคล้ายการเต้นของผีเสื้อ ว่ากันว่าวิญญาณทั้งหมดที่สัมผัสใบของชุดของคุกกี้ไวท์คิมจิจะหลุดพ้นจากความทุกข์ทรมาน', name: 'คุกกี้กิมจิขาว', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สมบัติที่ +9 จำนวน 55 ชิ้น' } } }, { grade: 5, id: cookie:83, image: 'admiral_gimbap_cookie.png', rank: 4, release_date: 1762128000, tr: { en: { abilities: "The small blue gauge charges over time. When it is full, Admiral Gimbap Cookie's troops launch various attacks to crush obstacles and create basic jellies, filling the green gauge a little. When the green gauge is full, Admiral Gimbap Cookie rides a giant turtle, firing torpedoes to crush obstacles and create Gimbap Jellies. (Leveling up increases Gimbap Jelly Points.)", description: "Undefeated in battle, Admiral Gimbap Cookie's feat of winning a big sea battle without losing a single ship has become the stuff of legends. Even the infamously rough currents of the Laver Sea calm down in front of him. The spicy red seasoning that accompanies his otherwise restrained black and white attire is said to have been awarded to him in honor of keeping his fighting spirit even when the world turned its back on him. A truly remarkable hero, down to his quirky habit of keeping a diary!", name: 'Admiral Gimbap Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: "Gather 20 Admiral Gimbap Cookie's Soulstones" }, th: { abilities: "Admiral's Charge", description: 'ไร้พ่ายในสมรภูมิ ชัยชนะในศึกทะเลใหญ่โดยไม่เสียเรือแม้ลำเดียวของคุกกี้พลเรือเอกคิมบับกลายเป็นตำนาน แม้แต่กระแสน้ำอันฉาวโฉ่ของทะเลลาเวอร์ก็สงบลงต่อหน้าเขา เครื่องปรุงสีแดงเผ็ดที่มาพร้อมกับชุดขาวดำอันสุภาพของเขาถูกกล่าวว่าเป็นรางวัลที่มอบให้เพื่อเป็นเกียรติแก่การรักษาจิตวิญญาณนักสู้ของเขาแม้เมื่อโลกหันหลังให้เขา ฮีโร่ที่น่าทึ่งอย่างแท้จริง ลงไปถึงนิสัยแปลกๆ ของการเขียนไดอารี่!', name: 'คุกกี้พลเรือเอกคิมบับ', power_plus: '', power_plus_requirement: '', unlock_goal: 'เก็บโซลสโตน 20 ก้อน' } } }, { grade: 4, id: cookie:84, image: 'manggaetteok_cookie.png', rank: 3, release_date: 1764720000, tr: { en: { abilities: 'The green gauge charges over time. When it is full, Manggaetteok Cookie spreads out her Manggae Leaf to soar into the air. Creates Manggaetteok Jellies and Wind Jellies (up to 10) while gliding. Picking up Wind Jellies prolongs the gliding.', description: 'Manggaetteok Cookie is the only daughter of the venerable Vine Leaf family. She likes to go on secret outings in the forest, hiding her soft cheeks under her leaf cloak, which also allows her to glide freely through the woods on the gentle breeze and land on the ground just as smoothly.', name: 'Manggaetteok Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have 75 Cookies' }, th: { abilities: 'Manggae Leaf Glider', description: 'คุกกี้มังแกต็อกเป็นลูกสาวคนเดียวของตระกูลเวินลีฟอันสูงศักดิ์ เธอชอบออกนอกบ้านอย่างลับๆ ในป่า ซ่อนแก้มนุ่มของเธอไว้ใต้เสื้อคลุมใบไม้ ซึ่งยังทำให้เธอร่อนผ่านป่าได้อย่างอิสระบนสายลมอ่อนโยนและร่อนลงพื้นอย่างนุ่มนวล', name: 'คุกกี้มังกึดต็อก', power_plus: '', power_plus_requirement: '', unlock_goal: 'ครอบครองคุกกี้ 75 ตัว' } } }, { grade: 6, id: cookie:85, image: 'blooming_dancheong_cookie.png', rank: 5, release_date: 1768435200, tr: { en: { abilities: 'The small blue gauge charges over time. When it is full, Plum Blossom Jellies grow, charging the green gauge a little. When the green gauge is full, Plum Blossom Dragons fly by, turning basic Jellies into Plum Blossom Jellies and Coins.', description: 'Blooming Dancheong Cookie was baked from gat-kimchi, made by grinding plum blossoms that bloomed in the snow and seasoning them over mustard leaves. Born from ingredients that overcame biting winds and solitude, this Cookie came to possess a spirit both resilient and noble. To create a land where Cookies could thrive, Blooming Dancheong Cookie gathered the energy of the Five Colors, swept away the heavy clouds, and planted a colossal plum World Tree on Mount Kimchi, the peak closest to the sky, linking heaven and earth as one. Warm sunlight and the gentle fragrance of plum blossoms soon began to fill the barren land. A world that had once been silent slowly became alive with the laughter of Cookies, and Blooming Dancheong Cookie, accompanied by the Plum Blossom Dragons, continued to watch over them. Though the tale now lives on only as legend, a lone shrine is said to still be standing at the summit of Mount Kimchi, where Blooming Dancheong Cookie is worshipped as a mountain spirit.', name: 'Blooming Dancheong Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Special acquisition (event / no unlock condition in data)' }, th: { abilities: 'Plum Blossom', description: 'คุกกี้แดนชองเบ่งบานถูกอบจากกัตคิมจิ ซึ่งทำโดยบดดอกบ๊วยที่เบ่งบานในหิมะและปรุงรสบนใบมัสตาร์ด เกิดจากส่วนผสมที่ฝ่าลมหนาวและความโดดเดี่ยว คุกกี้นี้จึงมีจิตวิญญาณทั้งยืดหยุ่นและสูงส่ง เพื่อสร้างดินแดนที่คุกกี้จะเติบโตได้ คุกกี้แดนชองรวมพลังแห่งห้าสี กวาดเมฆหนัก และปลูกต้นบ๊วยโลกขนาดมหึมาบนเขาคิมจิ ยอดเขาที่ใกล้ฟ้าที่สุด เชื่อมฟ้ากับดินเป็นหนึ่ง แสงแดดอุ่นและกลิ่นหอมอ่อนโยนของดอกบ๊วยเริ่มเติมเต็มแผ่นดินที่แห้งแล้ง โลกที่เคยเงียบงันค่อยๆ มีชีวิตด้วยเสียงหัวเราะของคุกกี้ และคุกกี้แดนชองพร้อมกับมังกรดอกบ๊วยยังคงเฝ้าดูพวกมัน แม้เรื่องราวจะเหลือเพียงตำนาน ว่ากันว่าศาลเจ้าอันโดดเดี่ยวยังคงยืนอยู่บนยอดเขาคิมจิ ที่ซึ่งคุกกี้แดนชองได้รับการบูชาในฐานะภูติภูเขา', name: 'คุกกี้ดันชองผลิบาน', power_plus: '', power_plus_requirement: '', unlock_goal: 'รางวัลพิเศษจากการเก็บอัญมณีลึกลับทั้งหมดในตอนที่ 6: Plum Blossom Palace of the Underworld' } } }, { grade: 4, id: cookie:86, image: 'garaetteok_cookie.png', rank: 3, release_date: 1768435200, tr: { en: { abilities: 'The small blue gauge charges over time. When it is full, Double Jumping causes Garaetteok Cookie to strike the ground, destroying obstacles, creating Garaetteok Jellies and filling the green gauge a little. When the green gauge is full, Garaetteok Cookie flies ahead surrounded by totem underlings, passing through obstacles to earn Evasion Points.', description: "Garaetteok Cookie's fierce gaze is fixed on the village shrine under the protection of the heavens. After wandering the land in search of learning, he was chosen by the shrine as the village's guardian. With a nature as pure and firm as garaetteok, he watches over the village day and night, the totems his only companions.", name: 'Garaetteok Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:94]]Sotdae Flock' }, th: { abilities: 'Garae Totem Blast', description: 'สายตาอันดุร้ายของคุกกี้คาแรตต็อกจับจ้องที่ศาลเจ้าหมู่บ้านภายใต้การคุ้มครองของสวรรค์ หลังจากท่องแผ่นดินเพื่อแสวงหาความรู้ เขาถูกศาลเจ้าเลือกให้เป็นผู้พิทักษ์หมู่บ้าน ด้วยนิสัยบริสุทธิ์และแน่วแน่ดั่งคาแรตต็อก เขาเฝ้ามองหมู่บ้านทั้งกลางวันและกลางคืน โดยมีเสาโทเท็มเป็นเพื่อนเพียงคนเดียว', name: 'คุกกี้การัตต็อก', power_plus: '', power_plus_requirement: '', unlock_goal: 'มี สัตว์เลี้ยง: [[pet:94]]Sotdae Flock' } } }, { grade: 4, id: cookie:87, image: 'choco_pistachio_cookie.png', rank: 3, release_date: 1772064000, tr: { en: { abilities: 'Periodically summons a Spiky Choco Mole that carries the Cookie forward. Movement Speed increases while riding. Landing from a Double Jump while mounted uncovers Spread Oil and creates Choco Pistachio Jellies. Counts as a riding skill.', description: 'Boing! Choco Pistachio Cookie travels across the Cocoa Desert in search of the Pistachio Oasis. After discovering rich Spread Springs within the oasis, the Cookie built a massive fortune from collecting the precious liquid. The confident pose may come off as a little arrogant at first glance, but in truth, this Cookie generously shares the hard-earned spring water with every Cookie across the Cocoa Desert—a true believer in giving back to the community.', name: 'Choco Pistachio Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Own Marshmallow Bunny & Pistachio Cookie' }, th: { abilities: 'Choco Pistachio Jellies', description: 'บอยยง! คุกกี้ช็อกโกพิสตาชิโอเดินทางข้ามทะเลทรายโกโก้เพื่อค้นหาโอเอซิสพิสตาชิโอ หลังจากค้นพบสปริงสเปรดอันอุดมภายในโอเอซิส คุกกี้สร้างโชคลาภมหาศาลจากการเก็บของเหลวอันล้ำค่านี้ ท่าทางมั่นใจอาจดูเย่อหยิ่งเล็กน้อยเมื่อมองแวบแรก แต่ความจริงแล้ว คุกกี้นี้แบ่งปันน้ำสปริงที่หามาด้วยหยาดเหงื่อให้คุกกี้ทุกตัวทั่วทะเลทรายโกโก้อย่างเอื้อเฟื้อ—ผู้เชื่อมั่นในการตอบแทนชุมชนอย่างแท้จริง', name: 'คุกกี้ช็อกโกพิสตาชิโอ', power_plus: '', power_plus_requirement: '', unlock_goal: 'ปลดล็อก pistachio และ marshmallowbunny' } } }, { grade: 4, id: cookie:88, image: 'dandelion_fairy_cookie.png', rank: 3, release_date: 1774915200, tr: { en: { abilities: 'Swings her Pom-pom Flower Stalk to create Dandelion Jelly and Pom-Pom Jelly. When flying through the air on the Pom-pom Flower Stalk, touching a Pom-Pom Seed causes Dandelion Seed Jellies to scatter.', description: "Dandelion Fairy Cookie is a gentle friend to nameless wildflowers. No matter how barren the land, it is quickly colored with a warm energy of happiness upon encountering Dandelion Fairy Cookie's flower breeze. Dandelion Cookie rides the wind on her Pom-pom Flower Stalk diligently every day to bring a happy and cozy spring to all Cookies and fill the world with love and gratitude.", name: 'Dandelion Fairy Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Gather 400 Dandelion Seeds' }, th: { abilities: 'Dandelion Breeze', description: 'คุกกี้แฟรี่แดนดิไลออนเป็นเพื่อนผู้อ่อนโยนของดอกไม้ป่านิรนาม ไม่ว่าแผ่นดินจะแห้งแล้งเพียงใด มันจะถูกแต้มด้วยพลังความสุขอันอบอุ่นอย่างรวดเร็วเมื่อพบกับสายลมดอกไม้ของคุกกี้แฟรี่แดนดิไลออน คุกกี้แดนดิไลออนขี่สายลมบนก้านดอกปอมปอมของเธออย่างขยันขันแข็งทุกวันเพื่อนำฤดูใบไม้ผลิที่สุขสบายมาสู่คุกกี้ทั้งหมด และเติมโลกด้วยความรักและความกตัญญู', name: 'คุกกี้นางฟ้าแดนดิไลออน', power_plus: '', power_plus_requirement: '', unlock_goal: 'เก็บเมล็ดแดนดิไลออน 400 เมล็ด' } } }, { grade: 4, id: cookie:89, image: 'kaymak_cookie.png', rank: 3, release_date: 1777420800, tr: { en: { abilities: 'Swings his Golden Honey Staff to crush obstacles during Blast. The green gauge charges over time. When it is full, Kaymak Cookie rides on his Milk Cloud, summoning decoys that crush obstacles and create Kaymak Jellies.', description: 'Hard as granite and swift as the wind, Kaymak Cookie knows not a fear in the world. He is known for his arrogant nature, fearing not even the heavens, but upon closer inspection, he possesses a nature as pure and profound as milk. After spending 500 years isolated in the mountains due to his uncontrollable power, he was able to return to the world and embark on a path of asceticism under the guidance of a certain Cookie. Through indefatigable training, he has learned to wield his power beneficially and is being reformed into a Cookie with an increasingly deep and solid flavor.', name: 'Kaymak Cookie', power_plus: 'Summons XP Party when Kaymak Cookie, Pine Monk, Lotus Root Phantom, and [[cookie:93]] are gathered', power_plus_requirement: 'when Kaymak Cookie, [[cookie:90]], [[cookie:91]], and [[cookie:93]] are gathered', unlock_goal: 'Have 60 evolved S Treasures' }, th: { abilities: 'Decoy Technique', description: 'แข็งดั่งหินแกรนิตและว่องไวดั่งสายลม คุกกี้คายมักไม่รู้จักความกลัวในโลก เขาเป็นที่รู้จักในนิสัยหยิ่งยโส ไม่เกรงกลัวแม้สวรรค์ แต่เมื่อมองใกล้ๆ เขามีนิสัยบริสุทธิ์และลึกซึ้งดั่งน้ำนม หลังจากใช้เวลา 500 ปีโดดเดี่ยวในภูเขาเพราะพลังที่ควบคุมไม่ได้ของเขา ในที่สุดเขาก็สามารถกลับสู่โลกและเริ่มเส้นทางบำเพ็ญตบะภายใต้การชี้นำของ ผ่านการฝึกฝนอย่างไม่รู้จักเหน็ดเหนื่อย เขาเรียนรู้ที่จะใช้พลังของเขาอย่างเป็นประโยชน์ และกำลังถูกหล่อหลอมเป็นคุกกี้ที่มีรสชาติลึกซึ้งและมั่นคงยิ่งขึ้น', name: 'คุกกี้ไคมัก', power_plus: 'Summons XP Party when Kaymak Cookie, Pine Monk, Lotus Root Phantom, and [[cookie:93]] are gathered', power_plus_requirement: 'when Kaymak Cookie, [[cookie:90]], [[cookie:91]], and [[cookie:93]] are gathered', unlock_goal: 'ครอบครองสมบัติวิวัฒน์อันดับ S 60 ชิ้น' } } }, { grade: 5, id: cookie:90, image: 'pine_monk_cookie.png', rank: 4, release_date: 1779926400, tr: { en: { abilities: 'Upon eating Sutra Jelly, unfolds the Sutra to create Pine Leaf Jellies and Coins. After eating a certain amount of Sutra Jellies, expels phantoms with a Giant Buddha Statue.', description: "Pine Monk Cookie was born beneath a Red Pine Tree that endured the river's fierce currents and strong winds. While his often unrestrained and inconsiderate behavior makes it hard to believe he is a monk, no one can deny his competence in effortlessly solving any problem with his brilliant mind and eyes of wisdom. Made of red pine, he possesses deep and unwavering conviction and will. Now chosen by the heavens, he is walking the path of ascetic practice for enlightenment. Possessing immense magical power, monsters coveting his strength are constantly eyeing Pine Monk Cookie, but with his trusty companions by his side, he seemingly has no need to worry.", name: 'Pine Monk Cookie', power_plus: 'Summons XP Party when Kaymak, Pine Monk Cookie, Lotus Root Phantom, and [[cookie:93]] are gathered', power_plus_requirement: 'when [[cookie:89]], Pine Monk Cookie, [[cookie:91]], and [[cookie:93]] are gathered', unlock_goal: "Gather 20 Pine Monk Cookie's Soulstones" }, th: { abilities: 'Giant Statue', description: 'คุกกี้พระสนมันเกิดใต้ต้นสนแดงที่ทนทานต่อกระแสน้ำอันเชี่ยวกรากและลมแรงของแม่น้ำ แม้พฤติกรรมที่มักไร้การควบคุมและไม่เกรงใจจะทำให้ยากจะเชื่อว่าเขาเป็นพระ แต่ไม่มีใครปฏิเสธความสามารถของเขาในการแก้ปัญหาทุกอย่างอย่างง่ายดายด้วยสมองอันเฉียบแหลมและดวงตาแห่งปัญญา ทำจากไม้สนแดง เขามีความเชื่อมั่นและจิตใจอันแน่วแน่ลึกซึ้ง ตอนนี้ถูกสวรรค์เลือกสรร เขากำลังเดินบนเส้นทางบำเพ็ญตบะเพื่อตรัสรู้ ด้วยพลังเวทมหาศาล มอนสเตอร์ที่โลภพลังของเขาจ้องมองคุกกี้พระสนอยู่ตลอด แต่ด้วยสหายที่ไว้ใจได้เคียงข้าง เขาดูเหมือนไม่จำเป็นต้องกังวล', name: 'คุกกี้พระสน', power_plus: 'Summons XP Party when Kaymak, Pine Monk Cookie, Lotus Root Phantom, and [[cookie:93]] are gathered', power_plus_requirement: 'when [[cookie:89]], Pine Monk Cookie, [[cookie:91]], and [[cookie:93]] are gathered', unlock_goal: 'เก็บโซลสโตน 20 ก้อน' } } } ];
INSERT [ { grade: 4, id: cookie:91, image: 'lotus_root_phantom_cookie.png', rank: 3, release_date: 1782345600, tr: { en: { abilities: 'Swings the crescent moon spade to make obstacles passable and create Skull Lotus Jellies when the small blue gauge is full. Each swing slightly charges the green gauge. When the green gauge is full, Lotus Root Phantom Cookie transforms into a Lotus Phantom and rushes ahead quickly while passing through obstacles.', description: "Lotus Root Phantom Cookie used to spend the time leisurely by a small lake in the desert. She would put her trickster mind to use by playing all kinds of pranks on unassuming Cookies that had gotten lost in the desert. When [[cookie:90]]'s party managed to avoid falling for her traps, she took a keen interest and joined them on their journey. Though she rarely reveals her true feelings, she seems quite content among this group of unique and talented personalities.", name: 'Lotus Root Phantom Cookie', power_plus: 'Summons XP Party when Kaymak, Pine Monk, Lotus Root Phantom Cookie, and [[cookie:93]] are gathered', power_plus_requirement: 'when [[cookie:89]], [[cookie:90]], Lotus Root Phantom Cookie, and [[cookie:93]] are gathered', unlock_goal: 'Have Pet: [[pet:99]]Lotus Sitter' }, th: { abilities: 'Lotus Phantom', description: 'แกว่งจอบพระจันทร์เสี้ยวเพื่อทำให้อุปสรรคผ่านได้และสร้างสคัลโลตัสเยลลี่เมื่อเกจสีน้ำเงินเล็กเต็ม แต่ละการแกว่งชาร์จเกจสีเขียวเล็กน้อย เมื่อเกจสีเขียวเต็ม คุกกี้โลตัสรูทแพนท่อมแปลงร่างเป็นแพนท่อมโลตัสและพุ่งไปข้างหน้าอย่างรวดเร็วขณะผ่านอุปสรรค\n\nคุกกี้โลตัสรูทแพนท่อมเคยใช้เวลาอย่างสุขสบายข้างทะเลสาบเล็กๆ ในทะเลทราย เธอใช้ความคิดเจ้าเล่ห์ของเธอเล่นกลสารพัดกับคุกกี้ที่ไม่ทันระวังซึ่งหลงทางในทะเลทราย เมื่อ คณะหนึ่งสามารถหลบเลี่ยงกับดักของเธอได้ เธอสนใจอย่างมากและเข้าร่วมการเดินทางของพวกเขา แม้เธอไม่ค่อยเผยความรู้สึกที่แท้จริง แต่เธอดูพอใจมากท่ามกลางกลุ่มบุคลิกอันเป็นเอกลักษณ์และมีความสามารถนี้', name: 'คุกกี้ผีรากบัว', power_plus: 'Summons XP Party when Kaymak, Pine Monk, Lotus Root Phantom Cookie, and [[cookie:93]] are gathered', power_plus_requirement: 'when [[cookie:89]], [[cookie:90]], Lotus Root Phantom Cookie, and [[cookie:93]] are gathered', unlock_goal: 'ได้รับ [[pet:99]]Lotus Sitter' } } }, { grade: 6, id: cookie:92, image: 'candied_yam_cookie.png', rank: 5, release_date: 1784764800, tr: { en: { abilities: 'The small blue gauge charges over time. When it is full, Candied Yams falls from the sky and create Candied Yam Jellies. Each activation fills the green gauge a little. When the green gauge is full, Candied Yam Cookie enters an enlightened state and creates Sacred Bear Jellies that are drawn towards her by the power of enlightenment.', description: "Candied Yam Cookie came into being by adding Lotus Honey to sweet potatoes placed as offerings of devotion by Cookies. Using appropriate trials to prevent them from fixating solely on comfort and sweetness, she guides Cookies towards attaining enlightenment by their own strength. Recently, she has bestowed a major task upon [[cookie:90]] and his disciples, and is paying particularly close attention to their journey toward enlightenment. Since time immemorial, she has always listened to the Cookies' prayers and extended a helping hand, ensuring that no Cookie has to succumb to despair at the end of a lonely life. Maybe she is even right now quietly listening to our small voices!", name: 'Candied Yam Cookie', power_plus: 'Chance of creating a Mystery Box in Episode 7 (Land of Enlightenment). (Leveling up increases the chance.)', power_plus_requirement: '', unlock_goal: 'Special acquisition (event / no unlock condition in data)' }, th: { abilities: 'Stage of Nirvana', description: 'เกจสีน้ำเงินเล็กชาร์จตามเวลา เมื่อเต็ม มันเทศอบจะตกลงมาจากฟ้าและสร้างมันเทศอบเยลลี่ แต่ละการใช้งานเติมเกจสีเขียวเล็กน้อย เมื่อเกจสีเขียวเต็ม คุกกี้มันเทศอบเข้าสู่สภาวะรู้แจ้งและสร้างศักดิ์สิทธิ์แบร์เยลลี่ที่ถูกดึงดูดเข้าหาเธอด้วยพลังแห่งการรู้แจ้ง\n\nคุกกี้มันเทศอบถือกำเนิดจากการเติมน้ำผึ้งโลตัสลงในมันหวานที่ถูกวางเป็นเครื่องบูชาด้วยความศรัทธาของคุกกี้ เธอใช้การทดลองที่เหมาะสมเพื่อป้องกันไม่ให้พวกเขาจดจ่อกับความสบายและความหวานเพียงอย่างเดียว เธอนำทางคุกกี้ให้บรรลุการรู้แจ้งด้วยกำลังของตัวเอง เมื่อเร็วๆ นี้ เธอมอบภารกิจสำคัญให้กับ และเหล่าสาวกของเขา และกำลังให้ความสนใจเป็นพิเศษกับการเดินทางสู่การรู้แจ้งของพวกเขา ตั้งแต่กาลก่อน เธอรับฟังคำอธิษฐานของคุกกี้เสมอและยื่นมือช่วยเหลือ ทำให้ไม่มีคุกกี้ตัวใดต้องยอมจำนนต่อความสิ้นหวังในบั้นปลายชีวิตอันโดดเดี่ยว บางทีตอนนี้เธออาจกำลังฟังเสียงเล็กๆ ของเราอยู่!', name: 'คุกกี้มันเชื่อม', power_plus: 'Chance of creating a Mystery Box in Episode 7 (Land of Enlightenment). (Leveling up increases the chance.)', power_plus_requirement: '', unlock_goal: 'รางวัลพิเศษจากการเก็บอัญมณีลึกลับทั้งหมดในตอนที่ 7: Land of Enlightenment' } } }, { grade: 4, id: cookie:93, image: 'braised_pork_cookie.png', rank: 3, release_date: 1784764800, tr: { en: { abilities: 'The small blue gauge charges over time. When it is full, Braised Pork Cookie tills the soil to harvest Braised Pork Jellies. Each harvest fills the green gauge a little. When the green gauge is full, the Cookie whirls around the Braised Pork Pitchfork to draw in Jellies and obstacles. Jellies absorbed thusly award bonus points. Finally, Braised Pork Cookie throws the pitchfork to draw in Jellies in front. (Skill activates faster the lower the remaining HP.)', description: "No one tops Braised Pork Cookie when it comes to plowing the field! Braised Pork Cookie's limbs are strong from working the fields. So famous she became for her reliability in handling all the village's tasks that [[cookie:90]] recruited her into his traveling party. Her biggest strengths are her fiery temperament that causes her to charge straight into any problem, and her hearty nature that allows her to shake off any hardship and bounce right back at the sight of a delicious meal.", name: 'Braised Pork Cookie', power_plus: 'Summons XP Party when Kaymak, Pine Monk, Lotus Root Phantom, and Braised Pork Cookie are gathered', power_plus_requirement: 'when [[cookie:89]], [[cookie:90]], [[cookie:91]], and Braised Pork Cookie are gathered', unlock_goal: 'Have [[cookie:89]]Kaymak / [[cookie:90]]Pine Monk / [[cookie:91]]Lotus Root Cookie' }, th: { abilities: 'Whirlwind Sweep', description: 'เกจสีน้ำเงินเล็กชาร์จตามเวลา เมื่อเต็ม คุกกี้หมูตุ๋นพรวนดินเพื่อเก็บเกี่ยวหมูตุ๋นเยลลี่ แต่ละการเก็บเกี่ยวเติมเกจสีเขียวเล็กน้อย เมื่อเกจสีเขียวเต็ม คุกกี้หมุนคราดหมูตุ๋นเพื่อดูดเยลลี่และอุปสรรคเข้ามา เยลลี่ที่ถูกดูดมานี้ให้คะแนนโบนัส สุดท้าย คุกกี้หมูตุ๋นขว้างคราดเพื่อดูดเยลลี่ด้านหน้า (สกิลทำงานเร็วขึ้นเมื่อพลังชีวิตที่เหลือต่ำลง)\r\n\r\nไม่มีใครเทียบคุกกี้หมูตุ๋นได้เมื่อพูดถึงการไถนา! แขนขาของคุกกี้หมูตุ๋นแข็งแรงจากการทำงานในทุ่งนา เธอโด่งดังมากในเรื่องความน่าเชื่อถือในการจัดการงานทั้งหมดของหมู่บ้าน จน รับเธอเข้าร่วมคณะเดินทางของเขา จุดแข็งที่ใหญ่ที่สุดของเธอคือนิสัยไฟแรงที่ทำให้เธอพุ่งเข้าหาปัญหาโดยตรง และนิสัยใจกว้างที่ทำให้เธอสะบัดความยากลำบากและเด้งกลับมาได้ทันทีเมื่อเห็นอาหารอร่อย', name: 'คุกกี้หมูตุ๋น', power_plus: 'Summons XP Party when Kaymak, Pine Monk, Lotus Root Phantom, and Braised Pork Cookie are gathered', power_plus_requirement: 'when [[cookie:89]], [[cookie:90]], [[cookie:91]], and Braised Pork Cookie are gathered', unlock_goal: 'มี [[cookie:89]]Kaymak / [[cookie:90]]Pine Monk / [[cookie:91]]Lotus Root Cookie' } } }, { grade: 4, id: cookie:94, image: 'mango_sticky_rice_cookie.png', rank: 3, release_date: 1787788800, tr: { en: { abilities: 'Races swiftly on a surfboard during Blast. While windsurfing, the score for all Jellies increases. (Counts as a riding skill.)', description: "Mango Sticky Rice Cookie was made using glutinous rice simmered in sweet coconut milk and topped with bright yellow mango. As a skilled windsurfer, she always rides the breezy wind across the Coconut Milk Sea. Her favorite thing is the mango-colored sun sparkling on the ocean! If you ever wonder where she might be, she's probably cutting through the waves toward that sun with a refreshing smile on her face.", name: 'Mango Sticky Rice Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:101]]Mango Roll' }, th: { abilities: 'Races swiftly on a surfboard during Blast. While windsurfing, the score for all Jellies increases. (Counts as a riding skill.)', description: "Mango Sticky Rice Cookie was made using glutinous rice simmered in sweet coconut milk and topped with bright yellow mango. As a skilled windsurfer, she always rides the breezy wind across the Coconut Milk Sea. Her favorite thing is the mango-colored sun sparkling on the ocean! If you ever wonder where she might be, she's probably cutting through the waves toward that sun with a refreshing smile on her face.", name: 'Mango Sticky Rice Cookie', power_plus: '', power_plus_requirement: '', unlock_goal: 'Have Pet: [[pet:101]]Mango Roll' } } } ];

