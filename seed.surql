olved: true, is_power_plus: false, rank: 3, release_date: 0, source: 'draw', sub: '1 Pit Lift, restoring 60 HPWith upgrades, +230-410 points for all Jellies', tr: { en: { description: '', name: 'Springtime Picnic Basket' }, th: { description: 'ตะกร้าปิกนิกที่เต็มไปด้วยผลไม้ ขนมปัง และแม้แต่สายลมสดชื่นแห่งฤดูใบไม้ผลิ! ค่อนข้างหนักเพราะแน่นไปด้วยของอร่อยหวานฉ่ำ แต่คุณจะรู้สึกเบาสบายเมื่อออกเดินทางไปเที่ยวกับมัน หยิบตะกร้าแล้วออกไปเพลิดเพลินกับฤดูใบไม้ผลิกันเถอะ', name: 'Springtime Picnic Basket' } } }, { effect_lines: [{ en: '-6% HP drain', state: 0, th: '-6% HP drain', values: ['6%', '', '', '', '', '', '', '', '', '7%'] }], family: 'draw', grade: 4, id: treasure:720, image: 'springtime_picnic_mat.png', is_evolved: false, is_power_plus: false, rank: 3, release_date: 0, source: 'draw', sub: 'Increased collision damageWith upgrades, -6-7% HP drain', tr: { en: { description: '', name: 'Springtime Picnic Mat' }, th: { description: 'เสื่อปิกนิกที่เข้ากันได้ดีกับสายลมอ่อนๆ ของฤดูใบไม้ผลิ เมื่อปูลงบนสนามหญ้าสีเขียว จะเกิดภาพราวกับดอกไม้สีเหลืองแห่งฤดูใบไม้ผลิบานสะพรั่งเต็มที่ พร้อมของว่างแสนอร่อย ความสุขก็เพิ่มขึ้นเป็นสองเท่า!', name: 'Springtime Picnic Mat' } } } ];
