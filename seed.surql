-- ------------------------------
-- OPTION
-- ------------------------------

OPTION IMPORT;

-- ------------------------------
-- ANALYZERS
-- ------------------------------

DEFINE ANALYZER cookie_search_en TOKENIZERS CLASS,PUNCT FILTERS LOWERCASE;
DEFINE ANALYZER cookie_search_th TOKENIZERS CLASS FILTERS LOWERCASE, NGRAM(1,3);

-- ------------------------------
-- SEQUENCES
-- ------------------------------

DEFINE SEQUENCE build_seq BATCH 1000 START 1;
DEFINE SEQUENCE cookie_seq BATCH 1000 START 95;
DEFINE SEQUENCE episode_seq BATCH 1000 START 702;
DEFINE SEQUENCE ingredient_seq BATCH 1000 START 243;
DEFINE SEQUENCE jelly_seq BATCH 1000 START 6123;
DEFINE SEQUENCE pet_seq BATCH 1000 START 102;
DEFINE SEQUENCE relic_seq BATCH 1000 START 550307;
DEFINE SEQUENCE skin_seq BATCH 1000 START 1850002;
DEFINE SEQUENCE treasure_seq BATCH 1000 START 874;
DEFINE SEQUENCE user_seq BATCH 1000 START 1;

