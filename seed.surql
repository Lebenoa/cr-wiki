-- ------------------------------
-- TABLE: ingredient
-- ------------------------------

DEFINE TABLE ingredient TYPE ANY SCHEMALESS PERMISSIONS NONE;


DEFINE INDEX ingredient_search_0 ON ingredient FIELDS tr.en.name FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX ingredient_search_1 ON ingredient FIELDS tr.th.name FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);
DEFINE INDEX ingredient_search_2 ON ingredient FIELDS tr.en.description FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX ingredient_search_3 ON ingredient FIELDS tr.th.description FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);

DEFINE EVENT ingredient_gram ON ingredient WHEN ($after.tr.en.name ?? '') != '' THEN { FOR $g IN (SELECT VALUE gram FROM name_gram WHERE section = 'ingredient' AND entity_id = record::id($after.id)) { DELETE name_gram WHERE section = 'ingredient' AND gram = $g AND entity_id = record::id($after.id) }; FOR $g IN array::windows(array::filter(string::split(string::lowercase($after.tr.en.name), ''), |$c: any| $c != ''), 3).map(|$w: any| array::join($w, '')) { CREATE name_gram SET gram = $g, section = 'ingredient', entity_id = record::id($after.id) }; };

-- ------------------------------
