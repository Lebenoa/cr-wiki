-- ------------------------------
-- TABLE: episode
-- ------------------------------

DEFINE TABLE episode TYPE ANY SCHEMALESS PERMISSIONS NONE;


DEFINE INDEX episode_search_0 ON episode FIELDS tr.en.name FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX episode_search_1 ON episode FIELDS tr.th.name FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);
DEFINE INDEX episode_search_2 ON episode FIELDS tr.en.description FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX episode_search_3 ON episode FIELDS tr.th.description FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);

DEFINE EVENT episode_gram ON episode WHEN ($after.tr.en.name ?? '') != '' THEN { FOR $g IN (SELECT VALUE gram FROM name_gram WHERE section = 'episode' AND entity_id = record::id($after.id)) { DELETE name_gram WHERE section = 'episode' AND gram = $g AND entity_id = record::id($after.id) }; FOR $g IN array::windows(array::filter(string::split(string::lowercase($after.tr.en.name), ''), |$c: any| $c != ''), 3).map(|$w: any| array::join($w, '')) { CREATE name_gram SET gram = $g, section = 'episode', entity_id = record::id($after.id) }; };

-- ------------------------------
-- TABLE DATA: episode
-- ------------------------------

INSERT [ { entry_cost: '1 × Life', id: episode:1, image: 'escape_from_the_oven.png', kind: 'story', league_ranked: true, stars: 1, tr: { en: { description: "It's too hot! We need to get out of here! The Cookies' great escape begins here. Jump, slide, run and don't look back!", name: 'Escape from the Oven' }, th: { description: "It's too hot! We need to get out of here! The Cookies' great escape begins here. Jump, slide, run and don't look back!", name: 'Escape from the Oven' } } }, { entry_cost: '1 × Life', id: episode:2, image: 'primeval_forest.png', kind: 'story', league_ranked: true, stars: 2, tr: { en: { description: "Finally, the Cookie Kingdom! But it's all in ruins! With a map for adventure in hands, you embark on a journey to restore its former glory!", name: 'Primeval Forest' }, th: { description: "Finally, the Cookie Kingdom! But it's all in ruins! With a map for adventure in hands, you embark on a journey to restore its former glory!", name: 'Primeval Forest' } } }, { entry_cost: '1 × Life', id: episode:3, image: 'dragons_valley.png', kind: 'story', league_ranked: true, stars: 5, tr: { en: { description: "It's even hotter than inside the oven! Make your way past the land of boiling Lava. Watch out - the ground is shaking!", name: "Dragon's Valley" }, th: { description: "It's even hotter than inside the oven! Make your way past the land of boiling Lava. Watch out - the ground is shaking!", name: "Dragon's Valley" } } }, { entry_cost: '1 × Life', id: episode:4, image: 'city_of_wizards.png', kind: 'story', league_ranked: true, stars: 3, tr: { en: { description: "You've reached the City of Wizards in search for clues about the Kingdom's fate. But the town is abandoned! And strange objects block your path. Mysterious!", name: 'City of Wizards' }, th: { description: "You've reached the City of Wizards in search for clues about the Kingdom's fate. But the town is abandoned! And strange objects block your path. Mysterious!", name: 'City of Wizards' } } }, { entry_cost: '1 × Life', id: episode:5, image: 'dessert_paradise.png', kind: 'story', league_ranked: true, stars: 4, tr: { en: { description: 'Following a sweet scent across the ocean, our Cookies found the Dessert Paradise - a land in the sky, flowing with the fountain of life! A mysterious and mighty presence is said to live at the top of the giant Tree of Life. Ready to find out?', name: 'Dessert Paradise' }, th: { description: 'Following a sweet scent across the ocean, our Cookies found the Dessert Paradise - a land in the sky, flowing with the fountain of life! A mysterious and mighty presence is said to live at the top of the giant Tree of Life. Ready to find out?', name: 'Dessert Paradise' } } }, { entry_cost: '1 × Life', id: episode:6, image: 'plum_blossom_palace.png', kind: 'story', league_ranked: true, stars: 5, tr: { en: { description: 'At the entrance to an eerie, mystical village, suddenly a gate to the heavens opens up! A trail under blooming plum blossom trees leads... right into the netherworld?! Keep your wits here, or you might never find your way back!', name: 'Plum Blossom Palace' }, th: { description: 'At the entrance to an eerie, mystical village, suddenly a gate to the heavens opens up! A trail under blooming plum blossom trees leads... right into the netherworld?! Keep your wits here, or you might never find your way back!', name: 'Plum Blossom Palace' } } }, { entry_cost: '1 × Life', id: episode:7, image: 'land_of_enlightenment.png', kind: 'story', league_ranked: true, stars: 3, tr: { en: { description: 'A mystical land has risen above the sea, out of reach for all but the most courageous and persevering of Cookies. Many trials wait on the daunting and treacherous path to enlightenment, but together we can overcome all!', name: 'Land of Enlightenment' }, th: { description: 'A mystical land has risen above the sea, out of reach for all but the most courageous and persevering of Cookies. Many trials wait on the daunting and treacherous path to enlightenment, but together we can overcome all!', name: 'Land of Enlightenment' } } }, { entry_cost: '1 × Key', id: episode:501, image: 'island_of_coins.png', kind: 'special', league_ranked: false, tr: { en: { description: "The ghost of Pirate Cookie is surrounded by an eerie aura. That's because he's protecting his hidden treasures. Anything could happen on this island, so be careful.", name: 'Island of Coins' }, th: { description: "The ghost of Pirate Cookie is surrounded by an eerie aura. That's because he's protecting his hidden treasures. Anything could happen on this island, so be careful.", name: 'Island of Coins' } } }, { entry_cost: '1 × Key', id: episode:502, image: 'tower_of_frozen_waves.png', kind: 'special', league_ranked: false, tr: { en: { description: "Far beyond the sea lies a mesmerizing tower that looks like frozen ocean waves. What secrets wait at the top? The higher you climb, the colder it gets. Don't get frozen in place!", name: 'Tower of Frozen Waves' }, th: { description: "Far beyond the sea lies a mesmerizing tower that looks like frozen ocean waves. What secrets wait at the top? The higher you climb, the colder it gets. Don't get frozen in place!", name: 'Tower of Frozen Waves' } } }, { entry_cost: '1 × Key', id: episode:503, image: 'mysterious_rabbit_hole.png', kind: 'special', league_ranked: true, tr: { en: { description: "Once you step into the mysterious Marshmallow Hills, you'd better watch your footing around those rabbit holes. After all, there's no telling where they might lead!", name: 'Mysterious Rabbit Hole' }, th: { description: "Once you step into the mysterious Marshmallow Hills, you'd better watch your footing around those rabbit holes. After all, there's no telling where they might lead!", name: 'Mysterious Rabbit Hole' } } }, { entry_cost: '1 × Key', id: episode:601, image: 'coin_palace_rush.png', kind: 'event', league_ranked: false, tr: { en: { description: "A mysterious palace of gold appeared out of nowhere like a mirage! The Coin Palace sparkles with endless treasure and blinding golden glamour! Don't let all that gold fool you! Charge ahead with your eyes glued to the coins, and you're bound to run into trouble!", name: 'Coin Palace Rush' }, th: { description: "A mysterious palace of gold appeared out of nowhere like a mirage! The Coin Palace sparkles with endless treasure and blinding golden glamour! Don't let all that gold fool you! Charge ahead with your eyes glued to the coins, and you're bound to run into trouble!", name: 'Coin Palace Rush' } } }, { entry_cost: '1 × Free', id: episode:602, image: 'xp_elixir_workshop.png', kind: 'event', league_ranked: false, tr: { en: { description: 'You discovered a secret alchemy workshop! Grab the XP-Elixirs packed with Star Jellies to grow your experience faster than ever!', name: 'XP-Elixir Workshop' }, th: { description: 'You discovered a secret alchemy workshop! Grab the XP-Elixirs packed with Star Jellies to grow your experience faster than ever!', name: 'XP-Elixir Workshop' } } }, { entry_cost: '1 × Party Run Ticket', id: episode:701, image: 'party_run.png', kind: 'event', league_ranked: false, tr: { en: { description: '', name: 'Party Run' }, th: { description: '', name: 'Party Run' } } } ];

