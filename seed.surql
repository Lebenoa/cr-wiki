DEFINE TABLE pet TYPE ANY SCHEMALESS PERMISSIONS NONE;


DEFINE INDEX pet_release_date ON pet FIELDS release_date;
DEFINE INDEX pet_search_0 ON pet FIELDS tr.en.name FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX pet_search_1 ON pet FIELDS tr.th.name FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);
DEFINE INDEX pet_search_2 ON pet FIELDS tr.en.description FULLTEXT ANALYZER cookie_search_en BM25(1.2,0.75);
DEFINE INDEX pet_search_3 ON pet FIELDS tr.th.description FULLTEXT ANALYZER cookie_search_th BM25(1.2,0.75);

DEFINE EVENT pet_gram ON pet WHEN ($after.tr.en.name ?? '') != '' THEN { FOR $g IN (SELECT VALUE gram FROM name_gram WHERE section = 'pet' AND entity_id = record::id($after.id)) { DELETE name_gram WHERE section = 'pet' AND gram = $g AND entity_id = record::id($after.id) }; FOR $g IN array::windows(array::filter(string::split(string::lowercase($after.tr.en.name), ''), |$c: any| $c != ''), 3).map(|$w: any| array::join($w, '')) { CREATE name_gram SET gram = $g, section = 'pet', entity_id = record::id($after.id) }; };

-- ------------------------------
-- TABLE DATA: pet
-- ------------------------------

INSERT [ { grade: 1, id: pet:1, image: 'choco_drop.png', rank: 0, release_date: 1364860800, tr: { en: { abilities: 'Periodically charges ahead to turn Jellies into Bear Jellies.', description: "A sweet little companion made from 100% cocoa. Among the Witch's shelves crowded with bizarre and questionable ingredients, this might just be the most normal thing around.", name: 'Choco Drop' }, th: { abilities: 'สร้างเยลลี่หมี', description: 'เพื่อนร่วมทางที่ทำจากโกโก้ 100% ท่ามกลางชั้นวางของของแม่มดที่เต็มไปด้วยส่วนผสมแปลกประหลาดและน่าสงสัย นี่อาจเป็นสิ่งปกติที่สุดเท่าที่เคยมีมา', name: 'ช็อกโก้ดรอป' } } }, { grade: 1, id: pet:2, image: 'cheese_drop.png', rank: 0, release_date: 1390435200, tr: { en: { abilities: 'Picks up missed Jellies.', description: "Harvested from the Cheeseberry bushes deep within the Witch's Forest near the end of summer. It happily gobbles up any Jellies Cookies leave behind—and the more it grows, the greedier its appetite gets.", name: 'Cheese Drop' }, th: { abilities: 'เก็บเยลลี่ที่พลาด', description: 'พุ่มชีสเบอร์รี่ของป่าแม่มดช่วงปลายฤดูร้อน', name: 'ชีสดรอป' } } }, { grade: 1, id: pet:3, image: 'hand_of_liker.png', rank: 0, release_date: 1482364800, tr: { en: { abilities: 'Periodically creates a Silver Coin worth 5 regular Coins.', description: 'Likes just about everything, happy smiles in particular.', name: 'Hand of Liker' }, th: { abilities: 'สร้างเหรียญ', description: 'เหรียญเงินมูลค่า 5 เหรียญ\n\nชอบเกือบทุกสิ่ง โดยเฉพาะรอยยิ้มที่มีความสุข', name: 'มือกดไลก์' } } }, { grade: 1, id: pet:4, image: 'double_bubble.png', rank: 0, release_date: 0, tr: { en: { abilities: 'Periodically creates a Bear Jelly Party.', description: "A strange mutant Jelly unlike the ordinary ones scattered around the Witch's kitchen, with twice the chewiness and twice the personality. One side always wears a cheerful grin and happily creates Bear Jelly Party items, while the other just silently trails behind looking mildly unimpressed.", name: 'Double Bubble' }, th: { abilities: 'สร้างปาร์ตี้เยลลี่หมี', description: 'อาร์เยลลี่ปาร์ตี้ (พวกมันเปลี่ยนเยลลี่ปกติเป็นแบร์เยลลี่)\n\nเหมือนหมากฝรั่ง', name: 'ดับเบิลบับเบิล' } } }, { grade: 2, id: pet:5, image: 'dust_unicorn.png', rank: 1, release_date: 1364860800, tr: { en: { abilities: 'Periodically creates a Gold Coin worth 10 regular Coins.', description: "One of the Witch's favorite crafting materials, carefully made by gathering the firmest fluffballs rolling around the unicorn stables and drying them gently beneath the moonlight.", name: 'Dust Unicorn' }, th: { abilities: 'สร้างเหรียญทอง (มูลค่า 10 เหรียญ)', description: 'ยูนิคอร์นนอนหลับและตากแห้งใต้แสงจันทร์ เป็นส่วนผสมที่แม่มดทะนุถนอมมาก', name: 'ยูนิคอร์นน้อย' } } }, { grade: 2, id: pet:6, image: 'merry_hat.png', rank: 1, release_date: 0, tr: { en: { abilities: 'Periodically creates a Silver Coin worth 5 regular Coins.', description: "Contrary to the rumors, Merry Hat can actually be found surprisingly easily during the busy holiday season. Just visit while the owner's distracted and quietly take one before anyone notices.", name: 'Merry Hat' }, th: { abilities: 'Periodically creates a Silver Coin worth 5 regular Coins.', description: "Contrary to the rumors, Merry Hat can actually be found surprisingly easily during the busy holiday season. Just visit while the owner's distracted and quietly take one before anyone notices.", name: 'Merry Hat' } } }, { grade: 1, id: pet:7, image: 'rainbows_end.png', rank: 0, release_date: 1364860800, tr: { en: { abilities: 'Grows larger in Bonus Time.', description: "Take a piece of cloud from the end of a rainbow, whip it together with melted sugar, and you'll get Rainbow's End—softer and fluffier than ordinary cotton candy could ever dream of being. Ride one into Bonus Time, and it soaks up moisture from the air, growing bigger and puffier so Cookies can gobble up even more Jellies. Some Cookies get so blissfully buried in the giant fluff that they nearly let go entirely, and if that ever happens, Rainbow's End might just drift off and become a real cloud in the sky.", name: "Rainbow's End" }, th: { abilities: 'เติบโตในโบนัสไทม์', description: 'เติบโตในโบนัสไทม์\n\nather แต่ไม่เคยหม่นหมอง', name: 'ปลายรุ้ง' } } }, { grade: 1, id: pet:8, image: 'holiday_stocking.png', rank: 0, release_date: 1387497600, tr: { en: { abilities: 'Increases running speed.', description: "This is actually just an imitation version—surprisingly easy to make with nothing more than red fabric and a bit of stuffing. Honestly, it's so convincing that there's barely any difference from the real thing, so most Cookies can't even tell which one's authentic anymore. (Though rumors say the original is hidden somewhere far, far away.) Holiday Stocking also gives Cookies a nice little speed boost while running.", name: 'Holiday Stocking' }, th: { abilities: 'ความเร็วพื้นฐานเพิ่มขึ้น', description: 'เป็นเพียงเวอร์ชันเลียนแบบ—ทำง่ายอย่างน่าประหลาดใจด้วยผ้าสีแดงและไส้เล็กน้อย จริงๆ แล้ว มันสมจริงมากจนแทบไม่ต่างจากของจริง คุกกี้ส่วนใหญ่แยกไม่ออกว่าอันไหนของแท้อีกต่อไป (แม้ข่าวลือจะบอกว่าของดั้งเดิมถูกซ่อนไว้ที่ไหนสักแห่งไกลแสนไกล) ถุงเท้าวันหยุดยังให้ความเร็วเพิ่มขึ้นเล็กน้อยแก่คุกกี้ขณะวิ่งด้วย', name: 'ถุงเท้าเทศกาล' } } }, { grade: 2, id: pet:9, image: 'electric_beat.png', rank: 1, release_date: 1390435200, tr: { en: { abilities: 'Periodically creates a Magnet Jelly.', description: 'A high-tech material formed from pure electromagnetic energy. Rumor has it that it starts dancing whenever electronic music plays nearby. Sounds ridiculous? Try blasting some EDM while you play and see what happens.', name: 'Electric Beat' }, th: { abilities: 'สร้างเยลลี่แม่เหล็ก', description: 'อิเล็กทริกเยลลี่\n\nจากเสียงเพลงสุดฟังก์', name: 'จังหวะไฟฟ้า' } } }, { grade: 2, id: pet:10, image: 'rare_garlic.png', rank: 1, release_date: 1390435200, tr: { en: { abilities: 'Periodically creates a Blast Jelly.', description: 'The peeled kind can be found all year round, but if you want a fresh unpeeled one, timing is everything. Strangely enough, its face and backside look exactly the same, making it impossible to tell which end that smell is coming from.', name: 'Rare Garlic' }, th: { abilities: 'สร้างพุ่งเยลลี่', description: 'เยลลี่หายาก\n\nแย่หน่อย แต่โชคดีที่มันหายาก', name: 'กระเทียมหายาก' } } }, { grade: 3, id: pet:11, image: 'flowercopter.png', rank: 2, release_date: 1364860800, tr: { en: { abilities: 'Increases flying speed in Bonus Time.', description: "This flower can travel across vast distances, which is very useful in Bonus Time: add some Magnet or Blast Jellies on top, and you're all set!", name: 'Flowercopter' }, th: { abilities: 'เร่งโบนัสไทม์', description: 'โบนัสไทม์\n\nแพ้เกสรดอกไม้เป็นบางครั้ง', name: 'ฟลาวเวอร์คอปเตอร์' } } }, { grade: 4, id: pet:12, image: 'little_ghost.png', rank: 3, release_date: 1364860800, tr: { en: { abilities: 'Grants Pit Lifts to lift Cookies after falling into pits.', description: 'Poor thing. It could only escape the Witch as a ghost.', name: 'Little Ghost' }, th: { abilities: 'ยกขึ้นจากหลุม', description: 'สามารถหนีแม่มดได้เพียงในร่างผี', name: 'ผีน้อย' } } }, { grade: 4, id: pet:13, image: 'giggle_bomb.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically charges ahead to cause explosions that turn obstacles into Coins.', description: "At first glance, it just looks like an ordinary black cannonball. But once [[cookie:16]]'s bomb gets fired up enough, it blasts straight through any obstacles in the way. The way it scrunches up its face before exploding does look suspiciously like it's about to fart... though honestly, the result is just as satisfying.", name: 'Giggle Bomb' }, th: { abilities: 'Periodically charges ahead to cause explosions that turn obstacles into Coins.', description: "At first glance, it just looks like an ordinary black cannonball. But once [[cookie:16]]'s bomb gets fired up enough, it blasts straight through any obstacles in the way. The way it scrunches up its face before exploding does look suspiciously like it's about to fart... though honestly, the result is just as satisfying.", name: 'Giggle Bomb' } } }, { grade: 2, id: pet:14, image: 'cozy_yarn.png', rank: 1, release_date: 1364860800, tr: { en: { abilities: 'Periodically creates a Bonus Time Jelly.', description: "A luxurious yarn spun from scattered bits of sunlight, glowing with its own warmth and shimmer. Both beautiful and incredibly cozy, it's prized by Cookies everywhere. When eaten, it creates a special item that sends Cookies straight into Bonus Time.", name: 'Cozy Yarn' }, th: { abilities: 'สร้างเยลลี่โบนัสไทม์', description: 'เยลลี่ที่ส่งคุณเข้าสู่โบนัสไทม์\n\nเส้นด้ายอุ่นๆ ที่สร้างแสงและความร้อนได้เอง ทำจากเศษแสงอาทิตย์ ถ้าคุณกินมัน คุณจะบินเข้าสู่โบนัสไทม์ทันที', name: 'ไหมพรมอบอุ่น' } } }, { grade: 3, id: pet:15, image: 'lucky_dice_bros.png', rank: 2, release_date: 1390435200, tr: { en: { abilities: 'Periodically creates a random item.', description: 'Always hanging around wherever games and wagers are involved, this sly little gambler lives for the thrill of a bet. With enough clever thinking, almost anything can be won, though a little luck never hurts either.', name: 'Lucky Dice Bros' }, th: { abilities: 'สร้างพาวเวอร์เยลลี่สุ่ม', description: 'วางเดิมพันกันและเสี่ยงภัย พลังของสองทำให้พวกมันโชคดีและหุนหันพลันแล่นเป็นพิเศษ', name: 'ลูกเต๋านำโชค' } } }, { grade: 4, id: pet:16, image: 'princesss_locket.png', rank: 3, release_date: 1390435200, tr: { en: { abilities: 'Periodically creates a Mini HP Potion.', description: 'A rare and precious accessory of Cookie Royalty passed down for generations. The Witch might have made it long time ago, when she used to work for the Royal family.', name: "Princess's Locket" }, th: { abilities: 'สร้างโพชันพลังงานจิ๋ว}}', description: 'เครื่องประดับหายากและล้ำค่าของราชวงศ์คุกกี้ที่สืบทอดกันมาหลายชั่วอายุคน แม่มดอาจทำมันไว้นานแล้ว ตอนที่เธอยังทำงานให้ราชวงศ์', name: 'จี้เวทมนตร์' } } }, { grade: 3, id: pet:17, image: 'dragons_tail.png', rank: 2, release_date: 1390435200, tr: { en: { abilities: 'Periodically summons Guardian Dragon, destroying obstacles in its way.', description: "\"No, it's not aloe vera.\" Legend says this is actually the severed tail of a red dragon [[cookie:9]] cut down long ago. These days, only the tail remains floating around but deep down, it still remembers the mighty dragon it once belonged to. Whenever a tired Cookie is worn out from dodging obstacles, the legendary dragon suddenly appears to charge ahead invincibly—and at that point, nobody mistakes it for aloe vera anymore.", name: "Dragon's Tail" }, th: { abilities: 'เรียกวิญญาณมังกร', description: 'เมื่อเทียบกับว่านหางจระเข้ มันถูกนำมาจากมังกรสีน้ำเงินในการต่อสู้อันดุเดือดและยังคงเก็บพลังของมังกรไว้บางส่วน แน่นอนว่าคุณจะไม่สับสนกับว่านหางจระเข้เมื่อวิญญาณของมังกรกลับมา', name: 'หางมังกร' } } }, { grade: 3, id: pet:18, image: 'brain_gum.png', rank: 2, release_date: 1390435200, tr: { en: { abilities: 'Slows HP drain.', description: "Just because it's got a giant head doesn't mean it's a genius, and Brain Gum works the same way: bigger doesn't mean tastier. Still, the perfect size does make for some pretty impressive bubble blowing. Cookies running alongside Brain Gum also tire out much more slowly.", name: 'Brain Gum' }, th: { abilities: 'พลังงานลดลงช้าลง', description: 'ฟองสบู่ที่เคี้ยวได้และเพิ่มไอคิวของคุกกี้เพื่อให้ใช้พลังงานช้าลง', name: 'หมากฝรั่งรูปสมอง' } } }, { grade: 2, id: pet:19, image: 'mocha_delight.png', rank: 1, release_date: 1364860800, tr: { en: { abilities: 'Periodically creates an Alphabet Jelly.', description: "The best tasting mocha cup you'll ever have. All that whipped cream makes it sooo good.", name: 'Mocha Delight' }, th: { abilities: 'สร้างเยลลี่ตัวอักษร', description: 'โอชะถ้วยสุดท้ายที่คุณจะได้ดื่ม วิปครีมทั้งหมดนั้นทำให้มันอร่อยมากกก', name: 'โมคาเดไลต์' } } }, { grade: 3, id: pet:20, image: 'wishing_star.png', rank: 2, release_date: 0, tr: { en: { abilities: 'Revives the Cookie upon collapse.', description: '[[cookie:12]] somehow arrived from the oven already holding this mysterious little thing. How? Why? No one seems to know...', name: 'Wishing Star' }, th: { abilities: 'Revives the Cookie upon collapse.', description: '[[cookie:12]] somehow arrived from the oven already holding this mysterious little thing. How? Why? No one seems to know...', name: 'Wishing Star' } } }, { grade: 2, id: pet:21, image: 'dumbbell_twins.png', rank: 1, release_date: 0, tr: { en: { abilities: 'Periodically creates a Giant Jelly.', description: "These dumbbells were twins from the very beginning—and they're even used as ingredients for creating that signature [[cookie:15]] strength. Thanks to the Giant Jellies they create, even ordinary Cookies can enjoy a little taste of muscles themselves.", name: 'Dumbbell Twins' }, th: { abilities: 'Periodically creates a Giant Jelly.', description: "These dumbbells were twins from the very beginning—and they're even used as ingredients for creating that signature [[cookie:15]] strength. Thanks to the Giant Jellies they create, even ordinary Cookies can enjoy a little taste of muscles themselves.", name: 'Dumbbell Twins' } } }, { grade: 4, id: pet:22, image: 'snow_blossom.png', rank: 3, release_date: 1393027200, tr: { en: { abilities: 'Chance to create ice bridges over pits.', description: "Used as the main ingredient for shaved ice, a fantastic summer specialty, it's [[cookie:17]]'s best friend and makes her performances even more beautiful!", name: 'Snow Blossom' }, th: { abilities: 'สร้างสะพานน้ำแข็ง}}', description: 'ส่วนผสมสำคัญสำหรับน้ำแข็งไส สุดยอดของเมนูฤดูร้อน มันเป็นเพื่อนซี้ของคุกกี้สเก็ตติ้งควีนและทำให้การแสดงของเธองดงามยิ่งขึ้น!', name: 'เกล็ดหิมะ' } } }, { grade: 4, id: pet:23, image: 'jellyco_cube.png', rank: 3, release_date: 1393027200, tr: { en: { abilities: 'Periodically launches Jellyco missiles', description: "A masterpiece of cutting-edge escape technology, it releases powerful missiles filled with Jellies. Hurry, get a glance at the sophisticated Jellyco missile system. You've never seen anything like it.", name: 'Jellyco Cube' }, th: { abilities: 'ยิงมิสไซล์เจลลีโค|Power+ = ไม่มี', description: 'ผลงานชิ้นเอกของเทคโนโลยีหลบหนีล้ำสมัย มันปล่อยมิสไซล์ทรงพลังที่เต็มไปด้วยเยลลี่ รีบไปชมระบบมิสไซล์เจลลีโคสุดล้ำ คุณไม่เคยเห็นอะไรแบบนี้มาก่อน', name: 'กล่องลูกบาศก์เยลลี่โค่' } } }, { grade: 4, id: pet:24, image: 'glitter_ball.png', rank: 3, release_date: 1396224000, tr: { en: { abilities: 'Periodically charges ahead to sprinkle Colorful Star Jellies.', description: "Spreads joy, excitement, and Colorful Star Jellies wherever it goes. Not only will you get extra points, you'll feel GREAT too!", name: 'Glitter Ball' }, th: { abilities: 'ให้เยลลี่และเหรียญ', description: 'ความตื่นเต้นและเรนโบว์สตาร์เยลลี่ทุกที่ที่มันไป คุณจะได้คะแนนพิเศษและรู้สึกเยี่ยมไปเลย!', name: 'ลูกบอลดิสโก้' } } }, { grade: 4, id: pet:25, image: 'awol_cracker.png', rank: 3, release_date: 1395273600, tr: { en: { abilities: 'Periodically creates a Hardtack Jelly that grants Giant and slightly restores HP.', description: "Formerly part of the flour division, he was too impatient to wait for the promotion and decided to flee and join the Cookies' escape team.", name: 'AWOL Cracker' }, th: { abilities: 'สร้างของว่างเพื่อทำให้คุกกี้กลายเป็นตัวยักษ์', description: 'แครกเกอร์ที่ทำให้คุกกี้ตัวใหญ่และให้พลังงานเล็กน้อย\n\nของแผนกแป้ง เขาอดใจรอโปรโมชันไม่ไหวและตัดสินใจหนีมาร่วมทีมหลบหนีของคุกกี้', name: 'แครกเกอร์หนีทัพ' } } }, { grade: 4, id: pet:26, image: 'flame_bat.png', rank: 3, release_date: 1399852800, tr: { en: { abilities: 'Absorbs Spirit Jellies one by one, restoring a small amount of HP with each absorbed.', description: "Apparently, after eating something unbelievably spicy, this poor thing wandered around desperately searching for ice-cold water until it caught the Witch's attention. Whatever it was looking for has long since been forgotten, but somehow, it still always feels thirsty.", name: 'Flame Bat' }, th: { abilities: 'เก็บเยลลี่วิญญาณ', description: 'ความสนใจของแม่มดเมื่อมันค้นหาน้ำแข็งหลังจากกินอะไรที่เผ็ดมากๆ มาก ตั้งแต่นั้นมา มันดูจะกระหายน้ำอยู่เสมอ', name: 'ค้างคาวเพลิง' } } }, { grade: 4, id: pet:27, image: 'golden_drop.png', rank: 3, release_date: 1377216000, tr: { en: { abilities: 'Periodically creates a Giant Gold Coin worth 100 Coins.', description: 'Golden Drop! One of the best drops there are. Make sure not to miss one when you see one!', name: 'Golden Drop' }, th: { abilities: 'เหรียญทองตัวยักษ์', description: 'เป็นครั้งคราวสร้างเหรียญทองยักษ์มูลค่า 100 เหรียญ\n\nดรอป! หนึ่งในดรอปที่ดีที่สุดเท่าที่มีมา อย่าลืมเก็บมันเมื่อเห็น!', name: 'โกลเดนดรอป' } } }, { grade: 4, id: pet:28, image: 'windy.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Moves ahead to gather Jellies. (Cannot gather Jellies unaffected by magnetic effects.)', description: "A playful little breeze that drifts through the riverside fields on clear sunny days. Carrying just a hint of cool moisture, it leaves anything it touches feeling wonderfully refreshed. It's hard to spot with your eyes alone, though—sometimes you have to close them and simply feel it.", name: 'Windy' }, th: { abilities: 'Moves ahead to gather Jellies. (Cannot gather Jellies unaffected by magnetic effects.)', description: "A playful little breeze that drifts through the riverside fields on clear sunny days. Carrying just a hint of cool moisture, it leaves anything it touches feeling wonderfully refreshed. It's hard to spot with your eyes alone, though—sometimes you have to close them and simply feel it.", name: 'Windy' } } }, { grade: 4, id: pet:29, image: 'fox_bead.png', rank: 3, release_date: 1380585600, tr: { en: { abilities: 'Periodically creates Giant Blast Beads.', description: 'A lonely Fox Bead wandering the world in search of its missing owner, [[cookie:23]]. Though separated, its mysterious powers remain as strong as ever. Better find it before the shimmering blue flame flickers out.', name: 'Fox Bead' }, th: { abilities: 'ลูกปัดพุ่งตัวยักษ์', description: 'สหายที่สูญหายของนินเทลส์ ทักษะที่ผิดปกติของมันยังคงแข็งแกร่ง แต่ต้องกลับไปรวมกับคุกกี้ก่อนที่แสงสีน้ำเงินสดใสจะดับลง', name: 'ลูกปัดจิ้งจอก' } } }, { grade: 3, id: pet:30, image: 'luck_o_lantern.png', rank: 2, release_date: 1382140800, tr: { en: { abilities: 'Periodically creates a random item.', description: "With so many candies inside, it's probably the sweetest pumpkin you'll find. It loves parties and dark places where it can be seen in all its glory.", name: "Luck-o'-lantern" }, th: { abilities: 'ให้ของรางวัลสุ่ม', description: 'ของดีๆ ดีกว่าสัตว์เลี้ยงตัวอื่นใด\n\nขนมด้านใน มันอาจเป็นฟักทองที่หวานที่สุดที่คุณจะพบ มันชอบปาร์ตี้และที่มืดๆ ที่มันจะถูกเห็นในความงดงามเต็มที่', name: 'โคมนำโชค' } } }, { grade: 4, id: pet:31, image: 'book_of_wizdom.png', rank: 3, release_date: 1401235200, tr: { en: { abilities: 'Grants Speed Points based on running speed.', description: "Once opened, this magic spellbook refuses to shut itself ever again. Worse yet, it can't stop loudly reading every spell inside on its own, turning the whole area into absolute chaos. Seriously... anything but the \"Summon Witch\" spell. And somehow, the faster you run, the faster the pages start flipping!", name: 'Book of Wizdom' }, th: { abilities: 'คะแนนความเร็วพิเศษ', description: 'หนังสือเล่มนี้ไม่สามารถปิดได้ ระวังมันด้วย เพราะมันรู้คาถาทั้งหมดที่อยู่ในนั้น ยิ่งคุณวิ่งเร็ว มันก็ให้คะแนนมากขึ้น', name: 'หนังสือเวทมนตร์' } } }, { grade: 4, id: pet:32, image: 'flower_pod.png', rank: 3, release_date: 1399248000, tr: { en: { abilities: 'Periodically creates Bonus Time Blast Jelly.', description: 'This little flower bud is far too shy to fully bloom. The smallest harsh word can make it wilt, and hearing about strong winds in some faraway land is enough to bring it to tears. Delicate and endlessly sensitive, it needs to be treated with the gentlest care. Only under warm, comforting sunlight does it finally open its petals and dance freely.', name: 'Flower Pod' }, th: { abilities: 'สร้างไอเทมพุ่งและโบนัสไทม์', description: 'มันเหี่ยวเฉาจากการสัมผัสใดๆ และร้องไห้ด้วยความเห็นอกเห็นใจเมื่อได้ข่าวลมแรงในดินแดนไกล มันจะเบ่งบานเต็มที่ในอากาศบริสุทธิ์ของโบนัสไทม์เท่านั้น', name: 'ดอกตูม' } } }, { grade: 4, id: pet:33, image: 'spotlight_fan.png', rank: 3, release_date: 1404950400, tr: { en: { abilities: 'Periodically shines a spotlight over the Cookie that grants Magnet, crushes obstacles on collision, and slows HP drain. (The Magnet does not stack with other magnetic effects.)', description: "Brings out the best in every Cookie. When it shines over you, a wonderful vanilla scent is spread around too. If that's too much attention for you, just take a step back.", name: 'Spotlight Fan' }, th: { abilities: 'เอฟเฟกต์สปอตไลต์', description: 'สิ่งที่ดีที่สุดในคุกกี้ทุกตัว เมื่อมันส่องแสงมาที่คุณ กลิ่นวานิลลาอันมหัศจรรย์ก็กระจายไปรอบๆ ด้วย ถ้านั่นมากเกินไปสำหรับคุณ แค่ถอยหลังหนึ่งก้าว', name: 'สปอตไลท์' } } }, { grade: 4, id: pet:34, image: 'rocket_firecracker.png', rank: 3, release_date: 1409529600, tr: { en: { abilities: 'Performs Pit Lift when the Cookie falls into a pit. Recharges after a time.', description: 'Made from cherry candy and bubblegum, it flies far and bursts with joy. Its star candy powder filling helps Chewy Rocket ignite and explode after a speedy flight. It can save the Cookie again when the filling regenerates.', name: 'Rocket Firecracker' }, th: { abilities: 'ยกขึ้นจากหลุมพร้อมพุ่ง', description: 'ลูกอมแข็งและหมากฝรั่ง มันบินไกลและระเบิดด้วยความสุข ไส้ผงสตาร์แคนดี้ช่วยให้เชวี่ร็อคเก็ตติดไฟเองและระเบิดหลังการบินอันรวดเร็ว มันสามารถช่วยคุกกี้ได้อีกครั้งเมื่อไส้สร้างใหม่', name: 'จรวดดอกไม้ไฟ' } } }, { grade: 4, id: pet:35, image: 'yule_log_cake.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically creates an Alphabet Giant Jelly that grants Giant and one random missing Bonus Time Alphabet Jelly.', description: "A tree with branches made of chocolate, found only in the Witch's Forest, gets sweeter every winter and always stays a bit frozen. A piece of the chocolate branch makes the world's best Christmas roll cake!", name: 'Yule Log Cake' }, th: { abilities: 'Periodically creates an Alphabet Giant Jelly that grants Giant and one random missing Bonus Time Alphabet Jelly.', description: "A tree with branches made of chocolate, found only in the Witch's Forest, gets sweeter every winter and always stays a bit frozen. A piece of the chocolate branch makes the world's best Christmas roll cake!", name: 'Yule Log Cake' } } } ];
INSERT [ { grade: 4, id: pet:36, image: 'snow_globe.png', rank: 3, release_date: 1419811200, tr: { en: { abilities: 'Periodically creates flying HP Potions accompanied by Snow Flower Jellies.', description: "For a feel of winter, just look inside the glass, where it snows all day every day, even on the hottest summer days. Don't hold the globe for too long though; you might catch a cold.", name: 'Snow Globe' }, th: { abilities: 'สร้างโพชันพลังงานหิมะ', description: 'ฤดูหนาว แค่มองเข้าไปในกระจก ที่ซึ่งหิมะตกตลอดทั้งวันทุกวัน แม้ในวันที่ร้อนที่สุดของฤดูร้อน แต่อย่าถือลูกแก้วนานเกินไป คุณอาจเป็นหวัดได้', name: 'ลูกแก้วโลกหิมะ' } } }, { grade: 4, id: pet:37, image: 'lucky_pouch.png', rank: 3, release_date: 1390953600, tr: { en: { abilities: 'Periodically creates a Gold Coin, with a small chance for a Giant Gold Coin.', description: "Long before Cookies ever figured out how to earn Coins, they traveled alongside Lucky Pouch Pets gifted by the elder Cookies. Stuffed absolutely full of good fortune, these plump little companions are just as generous and warmhearted as they look. Of course, some say they're not swollen with luck at all... they just ate way too much during the holiday feast.", name: 'Lucky Pouch' }, th: { abilities: 'ทำให้เหรียญตกลงมา}}', description: 'เหรียญ (1 เหรียญตามช่วงเวลาที่กำหนด)\n\nกาลครั้งหนึ่ง เมื่อคุกกี้ไม่มีความรู้เรื่องการเงิน พวกเขาจะพกถุงโชคลาภที่ปู่ย่าตายายให้ไปทุกที่ เต็มไปด้วยความสุขและอัดแน่นจนแทบแตก ถุงนี้พาโชคลาภไปทุกที่ ตำนานเล่าว่าครั้งหนึ่งมันกินเหรียญมากเกินไปในช่วงเฉลิมฉลองปีใหม่ และมันก็อ้วนมาตั้งแต่นั้น</center>', name: 'กระเป๋านำโชค' } } }, { grade: 4, id: pet:38, image: 'pink_candy.png', rank: 3, release_date: 1423785600, tr: { en: { abilities: 'Periodically calls a Royal Bear Jelly Meteor from the sky, which creates Pink Candy Jellies when it hits the ground.', description: 'Even the Royal Bear Jellies, the mysterious Jellies from Bonus Time, are dazzled by this pink candy. The secret in this special ability comes from the concentrated love signals Pink Candy emits. Not even the Royal Bear Jellies can withstand the power of love, so gaze into the sky of Bonus Time and make a wish.', name: 'Pink Candy' }, th: { abilities: 'ดึงดูดดาวตกเยลลี่หมีรอยัล', description: 'แม้แต่รอยัลแบร์เยลลี่ เยลลี่ลึกลับจากโบนัสไทม์ ยังต้องตะลึงกับแคนดี้สีชมพูนี้ ความลับของความสามารถพิเศษนี้มาจากสัญญาณรักอันเข้มข้นที่พิงก์แคนดี้ปล่อยออกมา แต่แม้รอยัลแบร์เยลลี่จะต้านทานพลังแห่งความรักได้ ดังนั้นจงมองขึ้นไปบนท้องฟ้าของโบนัสไทม์และอธิษฐาน', name: 'ลูกอมสีชมพู' } } }, { grade: 4, id: pet:39, image: 'purple_candle.png', rank: 3, release_date: 1413763200, tr: { en: { abilities: 'Periodically brightens its flame to reveal hidden Jellies. Obstacles set on fire become passable.', description: 'This candle emits a mysterious purple flame, entrancing all who gaze upon it with its mesmerizing scent and shimmer. Those caught under its spell can see unknown Jellies from another dimension, and must take great care to not lose themselves in that world or else they will be trapped there forever.', name: 'Purple Candle' }, th: { abilities: 'สร้างพลุสีม่วง', description: 'มันปล่อยเปลวไฟสีม่วงลึกลับ สะกดทุกคนที่จ้องมองด้วยกลิ่นหอมและประกายอันน่าหลงใหล ผู้ที่ตกอยู่ใต้มนต์สะกดของมันสามารถมองเห็นเยลลี่ที่ไม่รู้จักจากอีกมิติหนึ่ง และต้องระวังอย่างยิ่งที่จะไม่หลงทางในโลกนั้น เกรงว่าจะติดอยู่ที่นั่นตลอดกาล', name: 'เทียนหอมสีม่วง' } } }, { grade: 4, id: pet:40, image: 'pistachio_firefly.png', rank: 3, release_date: 1414627200, tr: { en: { abilities: 'Creates Blast HP Items: regain HP and enter Blast Mode at the same time.', description: "Beyond the Witch's lair lies the forgotten pistachio forest that glows a luminous bright green at night. The Pistachio Firefly, an extra-bright native of the forest, produces this enchanting light. The firefly smells nice and toasty and can illuminate your way on long, dark runs. However, it will buzz around restlessly, worried that its delicious core will be eaten!", name: 'Pistachio Firefly' }, th: { abilities: 'ฟื้นฟูพลังงาน สร้างเยลลี่พุ่งสปีด', description: 'ในถ้ำของแม่มดมีป่าพิสตาชิโอที่ถูกลืม ซึ่งเปล่งแสงเขียวสดใสในเวลากลางคืน แสงนี้สร้างโดยหิ่งห้อย หิ่งห้อยสว่างพิเศษเฉพาะของป่าที่ถูกลืม แม้พวกมันจะบินว่อนอย่างกระสับกระส่ายและกังวลเสมอว่าไส้อร่อยๆ ของพวกมันจะถูกกิน แต่พวกมันมีกลิ่นเหมือนเกาลัดคั่วร้อนๆ และส่องทางให้คุณในการวิ่งมืดๆ ที่ยาวนาน', name: 'หิ่งห้อย' } } }, { grade: 4, id: pet:41, image: 'jelly_scale.png', rank: 3, release_date: 1415923200, tr: { en: { abilities: 'Periodically converts Coins into points. (Amount converted at once is limited.)', description: "The perfect Pet for Cookies who believe no amount of Coins is too much when delicious high-scoring Jellies are on the line. Best of all, no matter how much they eat, they don't gain weight—just more points! Honestly, what could be better than that?", name: 'Jelly Scale' }, th: { abilities: 'แปลงเหรียญเป็นคะแนน', description: 'แปลงเหรียญเป็นคะแนนตามช่วงเวลาปกติ (มีขีดจำกัดจำนวนที่เขาสามารถแปลงได้ในแต่ละครั้ง) การอัปเกรดจะทำให้อัตราการแปลงเร็วขึ้น\r\n\r\nมีไว้สำหรับคุกกี้ที่อยากระเบิดความสนุกด้วยคะแนนสูงสุดเท่าที่จะทำได้ ไม่ว่าจะแลกด้วยอะไร! และไม่ว่าคุณจะกินมากแค่ไหน สิ่งเดียวที่จะอ้วนคือคะแนนของคุณ! เยี่ยม!', name: 'ตราชั่งเยลลี่' } } }, { grade: 4, id: pet:42, image: 'coin_scale.png', rank: 3, release_date: 1415923200, tr: { en: { abilities: 'Periodically converts points into Coins. (Amount converted at once is limited.)', description: 'A prized scale made for true coin supremacists—those who believe Coins can buy anything that matters. Rather than measuring weight, this rare artifact calculates everything by its Coin value instead.', name: 'Coin Scale' }, th: { abilities: 'แปลงคะแนนเป็นเหรียญ', description: 'แปลงคะแนนเป็นเหรียญตามช่วงเวลาปกติ (มีขีดจำกัดจำนวนที่เขาสามารถแปลงได้ในแต่ละครั้ง) การอัปเกรดจะทำให้อัตราการแปลงเร็วขึ้น\r\n\r\nสิ่งของทุกชิ้นมีจุดประสงค์และหน้าที่ของมัน แต่ด้วยเหรียญ คุณสามารถได้มันทั้งหมด! ถ้าคุณเป็นคนรักเหรียญ ตาชั่งนี้คือสัตว์เลี้ยงที่ดีที่สุดที่จะอยู่เคียงข้างคุณ ตาชั่งนี้ทำได้มากกว่าแค่ชั่งเหรียญ มันยังแปลงคะแนนเป็นเหรียญ และพูดตามตรง... เราทุกคนต้องการเหรียญเพิ่มอีกนิด!', name: 'ตราชั่งเหรียญ' } } }, { grade: 4, id: pet:43, image: 'oak_barrel.png', rank: 3, release_date: 1417132800, tr: { en: { abilities: 'Periodically creates a Ripe Potion that restores HP, increases running speed and decreases obstacle damage for a short time.', description: "This Oak Barrel is full of juice made from over-ripened grapes. It was left forgotten in a dark corner of the Witch's kitchen and it was able to age into a delightfully sweet nectar with a delicate woody note. You might be tempted to drink the whole thing, but the recommended amount is just a couple glasses per day.", name: 'Oak Barrel' }, th: { abilities: 'สร้างโพชันจากองุ่นสุก', description: 'ถังที่เต็มไปด้วยน้ำผลไม้จากองุ่นสุกเกินไปถูกลืมไว้ในมุมมืดของครัวแม่มด และมันสามารถบ่มจนกลายเป็นน้ำหวานอันโอชะพร้อมกลิ่นไม้ละเอียดอ่อน คุณอาจอยากดื่มหมดทั้งถัง แต่ปริมาณที่แนะนำคือ 1-2 แก้วต่อวัน', name: 'ถังไม้โอ๊ก' } } }, { grade: 4, id: pet:44, image: 'apple_rabbit.png', rank: 3, release_date: 1398902400, tr: { en: { abilities: 'Grants Speed Points and slows HP drain', description: 'Cut an apple into the shape of a bunny and start having a little too much fun with it, and before long, you may spot a Green Apple Rabbit hopping around right beside you. Its crisp apple scent keeps spirits high and energy up no matter how long the fun lasts. Just be careful where you leave your forks... one glimpse of cutlery, and the poor thing turns painfully shy.', name: 'Apple Rabbit' }, th: { abilities: 'ให้คะแนนความเร็วและพลังงานลดลงช้าลง', description: 'คะแนนโบนัสสำหรับความเร็วที่มากขึ้นและพลังงานลดลงช้าลง\n\nตัดแอปเปิ้ลเป็นรูปกระต่ายแล้วเริ่มเล่นอีกครั้ง ในไม่ช้า แอปเปิ้ลแรบบิทจะกระโดดตามคุณไป! กลิ่นแอปเปิ้ลกรอบของมันช่วยรักษาพลังงานของคุณ ทำให้เวลาเล่นสนุกยิ่งขึ้น แต่มันเขินส้อมนะ ดังนั้นเก็บมีดและส้อมให้ห่าง', name: 'กระต่ายแอปเปิล' } } }, { grade: 4, id: pet:45, image: 'fluffy_cheese_cat.png', rank: 3, release_date: 1412035200, tr: { en: { abilities: 'Periodically creates a Cat Coin worth 20 Coins. The frequency gradually increases over time.', description: "Somewhere in the corner of a kitchen filled with fragrant tea and sweet desserts, a tiny kitten once tried sneaking a bite of something—probably a little pile of cheese powder. It doesn't seem like it actually managed to eat much of it, though. Even so, the kitten now lives in a blissful haze where it can't tell whether it's covered in cheese or is the cheese... and honestly, it seems perfectly happy that way.", name: 'Fluffy Cheese Cat' }, th: { abilities: 'สร้างเหรียญแมว 20 เหรียญตามช่วงเวลาที่กำหนด', description: 'ลูกแมวตัวน้อยนี้กำลังสอดแนมไปรอบๆ ห้องครัวที่เต็มไปด้วยชาหอมและของหวานอร่อย เมื่อมันสะดุดกับก้อนชีสร่วน มันกินเลอะเทอะจริงๆ และจบลงด้วยการถูกปกคลุมด้วยผงชีสมากมายจนตอนนี้มันดูไม่เหมือนแมวอีกต่อไป', name: 'แมวเหมียวชีส' } } }, { grade: 4, id: pet:46, image: 'backpacky.png', rank: 3, release_date: 1418860800, tr: { en: { abilities: 'Periodically performs a Power Burp, ejecting various Jellies in a cone formation.', description: "A blanket backpack that follows along on its own, so there's no need to lug it around everywhere. Sure, it can feel a little embarrassing when it waddles after you with its arms wide open during the day, but once the cold night air rolls in, you'll be glad you brought it along.", name: 'Backpacky' }, th: { abilities: 'เรอพลังเยลลี่จำนวนมาก', description: 'มันคือกระเป๋าเป้อันสุดเจ๋งที่คุณไม่ต้องสะพาย และเมื่ออุณหภูมิลดลงในตอนกลางคืน คุณสามารถใช้มันอุ่นตัวเองได้จริงๆ', name: 'เป้คู่ใจ' } } }, { grade: 6, id: pet:47, image: 'king_choco_drop.png', rank: 5, release_date: 1418860800, tr: { en: { abilities: 'Periodically charges ahead to crush obstacles and scatter various Jellies and items. Lays down a red carpet for the Cookie, allowing pits to be crossed safely.', description: 'Once sealed away deep within the castle of a fallen kingdom, this royal Pet finally regained its true form after the seal was broken. Unfortunately, centuries of accumulated chocolate fluff have made moving around a little less graceful than before. Still, it proudly remembers the glorious days when it darted across battlefields to carry its king to safety.', name: 'King Choco Drop' }, th: { abilities: 'จัดขบวนพาเหรดเยลลี่ขณะคุ้มกัน', description: 'ในช่วงเวลาที่กำหนด มันทำลายอุปสรรคและกระจายเยลลี่กับไอเทม มันยังปูพรมแดงเหนือหลุมเพื่อให้คุกกี้ผ่านได้อย่างปลอดภัย\n\nเป็นสัตว์เลี้ยงที่ถูกล็อกไว้หลายปีในปราสาทที่ถูกลืมของอาณาจักรที่พังทลาย รูปลักษณ์ปัจจุบันของมันไม่ยุติธรรมกับความรุ่งโรจน์ในอดีต แต่มันยังคงเปล่งรัศมีความสง่างามของราชวงศ์', name: 'คิงช็อกโก้ดรอป' } } }, { grade: 4, id: pet:48, image: 'lemon_slice.png', rank: 3, release_date: 1406851200, tr: { en: { abilities: 'Periodically creates a Lemon Soda Potion that turns obstacles into Bubble Jellies.', description: "Losing a slice once made Lemon Slice terribly sad. But because of that missing piece, it learned how to eat Jellies, chat with Cookies, flash a bright citrusy smile, and even blow kisses at its favorite Cookie. Sometimes, losing something doesn't lead to sadness after all—and Lemon Slice now knows that better than anyone.", name: 'Lemon Slice' }, th: { abilities: 'สร้างโพชันโซดามะนาว', description: 'แตกสลายเมื่อเขาสูญเสียเลมอนซีกหนึ่งของเขา แต่เขาตระหนักได้ว่าเขาได้อะไรมากมายเช่นกัน หากไม่มีซีกนั้น ตอนนี้เขาสามารถกินเยลลี่ได้ และเมื่อรอยยิ้มของเขากลับมา เขายังมีความมั่นใจที่จะส่งจูบให้คุกกี้ที่เขาหลงรัก', name: 'เลม่อนหั่นแว่น' } } }, { grade: 4, id: pet:49, image: 'ghost_butler.png', rank: 3, release_date: 1422576000, tr: { en: { abilities: 'Periodically creates a Power Jelly, following a strict order.', description: "Once a legendary old butler famous for impossibly perfect schedule management, this tireless soul continued working even after becoming a ghost. The notebook it carries everywhere is crammed with such absurdly packed schedules that nobody can make sense of them—yet somehow, every single task gets done flawlessly. Spend too long around Ghost Butler, and before you know it, you'll be working yourself to death too. In those cases, it's highly recommended to ask for \"break time\" to be added to the schedule.", name: 'Ghost Butler' }, th: { abilities: 'สร้างเยลลี่ตามลำดับที่กำหนด', description: 'ผีตนนี้คือวิญญาณของบัตเลอร์ผู้ภักดีที่ดูแลคฤหาสน์โบราณในชาติก่อน ความภักดีของเขาต่อบ้านหลังนี้ฝังลึกจนถึงแก่นแท้ของเขา แม้หลังจากที่เขาจากไป วิญญาณของเขายังคงหลอกหลอนคฤหาสน์พร้อมกับดำเนินตารางงานอันแน่นขนัดอย่างมืออาชีพ เขาหยุดพักบ้างไหม? ไม่มีใครรู้', name: 'ผีพ่อบ้าน' } } }, { grade: 4, id: pet:50, image: 'kiwi_bird.png', rank: 3, release_date: 1424995200, tr: { en: { abilities: 'Periodically creates a Kiwi Giant Jelly that turns obstacles into Kiwi Jellies.', description: "One day [[cookie:42]] was taking a nap under a ginormous kiwi tree, as per usual. Suddenly the largest kiwi fell from the tree, splitting in half... into a Kiwi Bird! Since that day, this curious-looking bird refuses to leave [[cookie:42]]'s side. Maybe it has mistaken [[cookie:42]]'s helmet for its loving mom. How cute!", name: 'Kiwi Bird' }, th: { abilities: 'สร้างเยลลี่ตัวยักษ์รสกีวี', description: "วันหนึ่ง คุกกี้คิวีไบเกอร์กำลังงีบหลับยาวใต้ต้นกีวีขนาดมหึมาและถูกปลุกด้วยเสียงเจี๊ยวจ๊าวอันอยากรู้อยากเห็น เมื่อเขาลืมตาขึ้น เขาเผชิญหน้ากับนกหน้าตาประหลาดที่ปฏิเสธจะไปจากข้างกายเขา ดูเหมือนนกน้อยตัวนี้จะเข้าใจผิดว่าหมวกกันน็อกของคุกกี้คิวีไบเกอร์เป็นแม่ที่รักของมัน ตอนนี้คุกกี้คิวีไบเกอร์มีเพื่อนร่วมผจญภัยใหม่!\n\n'(OvenBreak)' วันหนึ่งคุกกี้คิวีกำลังงีบหลับใต้ต้นกีวีขนาดมหึมาเช่นเคย ทันใดนั้น กีวีที่ใหญ่ที่สุดตกลงมาจากต้น แยกออกเป็นสองซีก... กลายเป็นนกคิวี! ตั้งแต่วันนั้น นกหน้าตาประหลาดนี้ปฏิเสธที่จะไปจากข้างกายคุกกี้คิวี บางทีมันอาจเข้าใจผิดว่าหมวกกันน็อกของคุกกี้คิวีเป็นแม่ที่รักของมัน น่ารักจริงๆ!", name: 'นกกีวี่' } } }, { grade: 4, id: pet:51, image: 'furball_pup.png', rank: 3, release_date: 1427414400, tr: { en: { abilities: 'Brings an HP Potion upon collapse to grant up to 4 Revives for each Cookie.', description: 'In the lonely cabin where [[cookie:43]] lives, a little pup one day appeared among the tufts of fur scattered in the corner, happily wagging its tail. It does everything it can to cheer its grumpy owner up with endless affection and puppy charm, but [[cookie:43]] only snaps back, insisting it should stay away before someone gets hurt. Sometimes the poor thing tears up a little, but it never leaves his side. Maybe it can see the loneliness he tries so hard to hide.', name: 'Furball Pup' }, th: { abilities: 'ฟื้นคืนชีพคุกกี้|Power+ = ไม่มี', description: 'เกิดจากก้อนขนที่วางอยู่มุมห้องของคุกกี้แวร์วูล์ฟ เขาไม่เคยห่างจากนายของเขา และเป็นเพื่อนที่ภักดีตั้งแต่วันที่ถือกำเนิด การคิดถึงความเหงาที่เขาจะเป็นถ้าไม่มีเขาทำให้เขาน้ำตาไหลและดูเหมือนก้อนขนเปียกก้อนโต', name: 'น้องหมาขนปุย' } } }, { grade: 4, id: pet:52, image: 'paprika_punching_bag.png', rank: 3, release_date: 1418860800, tr: { en: { abilities: 'Periodically creates a Giant Jelly Gold Coin that is worth 100 Coins and grants Giant.', description: "He always trains with [[cookie:46]] and saves him when the chips are down. He's a very reliable friend. The Punching Bag's tough Paprika skin provides the ultimate defense and helps him with his training. The powerful hits seem to choose him. He wants to get [[cookie:46]] pumped up with fighting spirit. By the way, does it really not hurt at all?", name: 'Paprika Punching Bag' }, th: { abilities: 'สร้างเหรียญทองตัวยักษ์', description: 'มันวิ่งไปกับคุกกี้มวยไทยและช่วยเขาเมื่อถึงคราวคับขัน มันเป็นเพื่อนที่ไว้ใจได้มาก ผิวปาปริก้าอันแข็งแกร่งของกระสอบทรายให้การป้องกันขั้นสุดยอดและช่วยเขาฝึกซ้อม หมัดทรงพลังดูเหมือนจะเลือกมัน มันอยากทำให้คุกกี้มวยไทยฮึกเหิมด้วยจิตวิญญาณนักสู้ ว่าแต่ มันไม่เจ็บเลยจริงๆ เหรอ?', name: 'กระสอบทรายปาปริกา' } } }, { grade: 4, id: pet:53, image: 'marshmallow_hamster.png', rank: 3, release_date: 1429833600, tr: { en: { abilities: 'Periodically charges ahead to absorb Jellies, then spits out Cocoa Marshmallow Jellies and an HP Potion.', description: "A bit of an accident happened during someone's attempt to draw a face onto a roasted marshmallow with chocolate: a drop of cherry syrup fell down, making the nose. It is so bright that you would even say it glows. Other marshmallows used to laugh at Marshmallow Hamster's nose and call it names. But ever since the Pet met [[cookie:44]], it's been happier than ever, filling its puffy cheeks with delicious Jellies.", name: 'Marshmallow Hamster' }, th: { abilities: 'แก้มตุ่ย', description: '<center>ดวงตาของมันถูกวาดด้วยหยดโกโก้เข้มข้น และจมูกสีแดงสดด้วยเชอร์รี่ไซรัปหยดหนึ่ง เขาดูผอมและเหมือนมาร์ชเมลโลว์แฟบเมื่อถูกเพื่อนๆ แกล้ง แต่ตั้งแต่ได้พบ[[cookie:44]] เขาก็มีความสุขมากกว่าที่เคย และตอนนี้เขาสามารถละลายหัวใจใครก็ได้เมื่อยิ้มด้วยแก้มอิ่มที่เต็มไปด้วยเมล็ดทานตะวัน</center>', name: 'แฮมสเตอร์มาร์ชแมลโลว์' } } }, { grade: 4, id: pet:54, image: 'ms_do_re_mi.png', rank: 3, release_date: 1428624000, tr: { en: { abilities: 'Periodically creates a Star Fireworks Potion for 330 Coins (only when enough Coins are available).', description: 'Ms. Do-Re-Mi loves to spend quiet nights staring at the dark blue sky in absolute silence. She once lamented the fact that she could only play a limited range of notes. Only now, that she has [[pet:55]] by her side, has she realized that it takes two to perform a harmoniously beautiful melody of love.', name: 'Ms. Do-Re-Mi' }, th: { abilities: 'สร้างโพชันพลุดาว', description: 'ใช้เวลาค่ำคืนอันเงียบสงบ จ้องท้องฟ้าสีน้ำเงินเข้มในความเงียบสนิท เธอเคยคร่ำครวญว่าเธอสามารถสร้างเสียงได้จำกัด แต่ตอนนี้เธอมีคุณฟา-โซล-ลา-ซีอยู่เคียงข้าง พวกเขาสามารถสร้างทำนองที่ประสานกันอย่างงดงาม ซึ่งว่ากันว่ากระตุ้นความรู้สึกแห่งความรักให้ทุกคนที่ฟัง', name: 'คุณโด-เร-มี' } } }, { grade: 4, id: pet:55, image: 'mr_fa_sol_la_si.png', rank: 3, release_date: 1428624000, tr: { en: { abilities: 'Periodically creates a Royal Blast Coin.', description: "Mr. Fa-Sol-La-Si is known to be a cranky orchestra director who never spares biting criticism if performance is not up to his standards. He discovered [[cookie:45]]'s talent and has been his advisor ever since. In the past, he gave groundbreaking performances. These days, he focuses on conducting his orchestra.", name: 'Mr. Fa-Sol-La-Si' }, th: { abilities: 'สร้างเหรียญรอยัลพุ่งแดช', description: 'เขาเป็นวาทยากรจอมขี้บ่นที่ไม่ละเว้นคำวิจารณ์ที่เฉียบขาดหากการแสดงไม่ได้มาตรฐานของเขา แต่ไม่มีใครตั้งคำถามทักษะและความไวทางดนตรีโดยกำเนิดของเขา เขาเป็นคนค้นพบพรสวรรค์ของ[[cookie:45]]และเป็นที่ปรึกษาของเขามาตั้งแต่พบกันครั้งแรก ขณะที่เขาเคยให้การแสดงที่สั่นสะเทือนพื้นดิน ตอนนี้เขากำลังควบคุมวงออร์เคสตราของเขา', name: 'มิสเตอร์ฟาซอลลาที' } } }, { grade: 4, id: pet:56, image: 'owlcorn.png', rank: 3, release_date: 1431648000, tr: { en: { abilities: 'Periodically creates a Bear Jelly Party Potion.', description: 'This is the cute Owlcorn that helps [[cookie:47]] practice her spells. Although Owlcorn is tough on [[cookie:47]], deep down Owlcorn wishes that she become a great wizard one day. When [[cookie:47]] left in search of the City of Wizards, Owlcorn was right there beside her.', name: 'Owlcorn' }, th: { abilities: 'สร้างโพชันเยลลี่หมีทั้งหมด', description: 'นกฮูกข้าวโพดที่ช่วย[[cookie:47]]ฝึกคาถาของเธอ แม้ Owlcorn จะเข้มงวดกับ[[cookie:47]] แต่ลึกๆ แล้ว Owlcorn หวังว่าสักวันเธอจะกลายเป็นพ่อมดผู้ยิ่งใหญ่ เมื่อ[[cookie:47]]ออกเดินทางตามหาเมืองแห่งพ่อมด Owlcorn ก็อยู่เคียงข้างเธอ', name: 'นกฮูกลูกโอ๊ก' } } }, { grade: 4, id: pet:57, image: 'mini_jackson_no_2.png', rank: 3, release_date: 1434067200, tr: { en: { abilities: 'Periodically shoots Coloring Laser to create Mini Gumball Jellies.', description: "[[cookie:49]] brought back a broken piece of sphere metal from the City of Wizards and colored it his way. Perhaps it's because he put his heart and soul into it night after night, Mini Jackson No. 2 started shooting colorful lasers! Prepare yourself if you want to see them together; you may be dazzled by their colorful art feast.", name: 'Mini Jackson No.2' }, th: { abilities: 'เลเซอร์ระบายสี', description: '[[cookie:49]]นำเศษโลหะทรงกลมที่แตกมาจากเมืองแห่งพ่อมดและระบายสีในแบบของเขา บางทีอาจเป็นเพราะเขาทุ่มเทหัวใจและวิญญาณลงไปทุกคืน มินิแจ็กสันหมายเลข 2 เริ่มยิงเลเซอร์สีสันสดใส! เตรียมตัวให้พร้อมถ้าอยากเห็นพวกเขาอยู่ด้วยกัน คุณอาจตาพร่าด้วยงานเลี้ยงศิลปะหลากสีของพวกเขา', name: 'มินิแจ็กสันหมายเลข 2' } } }, { grade: 4, id: pet:58, image: 'tea_cup.png', rank: 3, release_date: 1431648000, tr: { en: { abilities: 'Creates an Alphabet Potion that grants one random missing Bonus Time Alphabet Jelly.', description: 'The first thing [[cookie:50]] does at a picnic is to drink tea from her lovely tea cup. No matter what the weather, it maintains the perfect temperature and blend! With this kind of tea cup, you will want to go on a picnic every single day!', name: 'Tea Cup' }, th: { abilities: 'สร้างโพชันตัวอักษร', description: 'สิ่งแรกที่[[cookie:50]]ทำในปิกนิกคือการดื่มชาจากถ้วยชาอันน่ารักของเธอ ไม่ว่าอากาศจะเป็นอย่างไร มันรักษาอุณหภูมิและรสชาติที่สมบูรณ์แบบ! ด้วยถ้วยชาแบบนี้ คุณจะอยากไปปิกนิกทุกวัน!</center>', name: 'ถ้วยชา' } } }, { grade: 0, id: pet:59, image: 'bean_drop_duo.png', rank: 6, release_date: 1453420800, tr: { en: { abilities: 'Periodically creates 2 Bean Jellies. Grants 2 Pit Lifts and 2 Revives with 22 HP to each Cookie.', description: "In the Witch's garden grows a magical pea tree that sprouts pods with a single pea inside each one. But one day, among all the ordinary pods, there appeared one long, oddly shaped pod unlike the rest. Curious, the Witch cracked it open… and sure enough, inside the extra-long pod were not one, but two peas side by side!", name: 'Bean Drop Duo' }, th: { abilities: 'สร้างเยลลี่ถั่ว', description: 'แบร์เยลลี่ตามช่วงเวลาที่กำหนด ยกขึ้น 2 ครั้งและฟื้นคืนชีพ 2 ครั้งด้วยพลังงาน 22 (การฟื้นคืนชีพจะถูกใช้ซ้ำกับคุกกี้รีเลย์)\n\nสวนหลังบ้าน ต้นถั่ววิเศษเติบโต แต่วันหนึ่ง ถั่วหน้าตาแปลกเริ่มงอกจากมัน! ดังนั้นเพื่อนคู่หูสุดพิเศษยาวๆ นี้จึงถือกำเนิด และไม่ใช่แค่ถั่วเดียว แต่มีสองถั่ว!', name: 'คู่หูบีนดรอป' } } }, { grade: 4, id: pet:60, image: 'electro_lemon.png', rank: 3, release_date: 1436486400, tr: { en: { abilities: 'Periodically creates a Bear Jelly Party Blast Jelly.', description: "This Pet might be crinkling with static, but don't be afraid to come close! Electro Lemon is a limitless supply of power particles and allows Cookies to feel refreshed and excitedly run faster. It's perfect for skincare as well!", name: 'Electro Lemon' }, th: { abilities: 'สร้างพุ่งปาร์ตี้เยลลี่หมี', description: 'หลอดไฟที่คุณจะมีวิตามินซีไม่จำกัด สัตว์เลี้ยงนี้ทำให้คุกกี้รู้สึกสดชื่นและวิ่งเร็วขึ้นอย่างตื่นเต้น (เหมาะกับการดูแลผิวด้วย)', name: 'แบตเตอรี่เลมอน' } } }, { grade: 4, id: pet:61, image: 'mini_orange_mouse.png', rank: 3, release_date: 1438905600, tr: { en: { abilities: 'Periodically creates a Blast Jelly. Grants Speed Points based on running speed.', description: '[[cookie:52]] received this cutie on her birthday. Energetic and active, it wanders around in the wrong places all the time, making [[cookie:52]] look for it in all places imaginable. In fact, it was thanks to this pet that [[cookie:52]] made friends with a cookie tucked away all alone behind some bushes.', name: 'Mini Orange Mouse' }, th: { abilities: 'สร้างพุ่งเยลลี่ คะแนนความเร็ว', description: 'ได้รับเจ้าน่ารักนี้ในวันเกิดของเธอ ขี้เล่นและกระตือรือร้น มันเดินเตร่ไปในที่ผิดๆ ตลอดเวลา ทำให้[[cookie:52]]ต้องตามหามันในทุกที่ที่จินตนาการได้ จริงๆ แล้ว ต้องขอบคุณสัตว์เลี้ยงนี้ที่ทำให้[[cookie:52]]ได้เป็นเพื่อนกับคุกกี้ที่ซ่อนตัวอยู่ตามลำพังหลังพุ่มไม้', name: 'หนูส้ม' } } }, { grade: 4, id: pet:62, image: 'platinum_drop.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically creates a Platinum Coin worth 70 Coins. Grants 1 Pit Lift.', description: 'Once upon a time, a shiny meteorite fell from the sky, and from it emerged an incredibly precious Pet of pure platinum. Platinum Drop will definitely make you happy and rich. Or vice versa!', name: 'Platinum Drop' }, th: { abilities: 'Periodically creates a Platinum Coin worth 70 Coins. Grants 1 Pit Lift.', description: 'Once upon a time, a shiny meteorite fell from the sky, and from it emerged an incredibly precious Pet of pure platinum. Platinum Drop will definitely make you happy and rich. Or vice versa!', name: 'Platinum Drop' } } }, { grade: 4, id: pet:63, image: 'mr_limeguard.png', rank: 3, release_date: 1442361600, tr: { en: { abilities: 'Grants 3 Pit Lifts or Revives with 28 HP to each Cookie. Provides +100 HP for Cookie Relay.', description: 'Mr. Limeguard is the go-to Pet for safety on the water. According to [[cookie:20]], Mr. Limeguard was one tough coach in the Cookie Camp. He was known to be strict and his training methods were intense. But with his past aside, he is now busy keeping the feisty [[cookie:53]] safe from the dangers of water.', name: 'Mr. Limeguard' }, th: { abilities: 'ยกขึ้น/ฟื้นคืนชีพ พลังงานรีเลย์คุกกี้เพิ่มขึ้น', description: '<!--โปรดทราบว่าไม่มีช่องว่างระหว่าง Mr.Limeguard นั่นตั้งใจ--> คือสัตว์เลี้ยงที่ต้องมีเพื่อความปลอดภัยบนน้ำ ตามคำบอกของ[[cookie:20]] มิสเตอร์ไลม์การ์ดเป็นโค้ชที่โหดมากในค่ายคุกกี้ เขาเป็นที่รู้จักในความเข้มงวดและวิธีการฝึกที่หนักหน่วง แต่เมื่ออดีตผ่านไป ตอนนี้เขายุ่งอยู่กับการปกป้อง[[cookie:53]]จอมดื้อจากอันตรายที่น้ำจะก่อได้', name: 'คุณไลม์การ์ด' } } }, { grade: 4, id: pet:64, image: 'paper_boat_sailor.png', rank: 3, release_date: 1445558400, tr: { en: { abilities: 'Periodically shoots Sea Bubble Jellies to crush obstacles. The first shot each time creates an HP Potion.', description: "A paper boat made out of the letter that [[cookie:54]] did not send. Although it is not strong enough to cross the waves of the ocean yet, it claims that it will cross the ocean one day. Perhaps it wishes for [[cookie:54]]'s message to be delivered...", name: 'Paper Boat Sailor' }, th: { abilities: 'ยิงฟองทะเล สร้างโพชัน', description: 'เรือกระดาษที่ทำจากจดหมายที่[[cookie:54]]ไม่ได้ส่ง แม้มันจะยังไม่แข็งแรงพอจะข้ามคลื่นมหาสมุทร แต่ก็อ้างว่าสักวันมันจะข้ามมหาสมุทร บางทีมันอาจปรารถนาไม่ใช่ตัวมันเอง แต่ข้อความของ[[cookie:54]]จะถูกส่งถึง...', name: 'กะลาสีเรือกระดาษ' } } }, { grade: 4, id: pet:65, image: 'wave_drop.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically creates a Frozen Bear Jelly Party Potion.', description: 'At the top of the Tower of Frozen Waves, a drop fell from the frozen ice. This Pet gives new strength to the Cookies with its mystical and clear aura.', name: 'Wave Drop' }, th: { abilities: 'Periodically creates a Frozen Bear Jelly Party Potion.', description: 'At the top of the Tower of Frozen Waves, a drop fell from the frozen ice. This Pet gives new strength to the Cookies with its mystical and clear aura.', name: 'Wave Drop' } } }, { grade: 4, id: pet:66, image: 'panda_dumpling.png', rank: 3, release_date: 1449792000, tr: { en: { abilities: 'Periodically throws Dumpling Jellies, earning extra Coins with each throw. Obstacles hit by Dumpling Jellies are crushed.', description: "This little pet sold dumplings for a long, long time. One day, it mistook [[cookie:55]]'s head leaf for a bamboo leaf, and tried to eat it. That's when their special friendship started... right after it was beaten up. It provides free dumplings to [[cookie:55]], but somehow collects Coins along the way. Old habits die hard? Maybe it cannot forget its days as a dumpling vendor.", name: 'Panda Dumpling' }, th: { abilities: 'กระจายเยลลี่เกี๊ยว', description: 'สัตว์เลี้ยงตัวน้อยนี้ขายเกี๊ยวมาเป็นเวลานานมาก วันหนึ่ง มันเข้าใจผิดว่าใบไม้บนหัวของ[[cookie:55]]เป็นใบไผ่ และพยายามกินมัน นั่นคือจุดเริ่มต้นของมิตรภาพพิเศษของพวกเขา... หลังจากที่มันถูกทุบตี มันให้เกี๊ยวฟรีแก่[[cookie:55]] แต่ไม่รู้ว่าทำไมถึงเก็บเหรียญไปด้วย นิสัยเก่าเปลี่ยนยาก? บางทีมันอาจลืมวันเก่าๆ ในฐานะพ่อค้าเกี๊ยวไม่ได้', name: 'เกี๊ยวแพนด้า' } } }, { grade: 4, id: pet:67, image: 'uncooling_teacup.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Grants Crush Points when crushing obstacles. Slows HP drain.', description: 'This pet is a very special gift received by [[cookie:56]]. One well-known story claims that before his tea cools, [[cookie:56]] can quickly destroy every obstacle that lies in his path. But, shhh... the secret to this trick is that this pet is self-heating.', name: 'Uncooling Teacup' }, th: { abilities: 'Grants Crush Points when crushing obstacles. Slows HP drain.', description: 'This pet is a very special gift received by [[cookie:56]]. One well-known story claims that before his tea cools, [[cookie:56]] can quickly destroy every obstacle that lies in his path. But, shhh... the secret to this trick is that this pet is self-heating.', name: 'Uncooling Teacup' } } }, { grade: 4, id: pet:68, image: 'onion_fish.png', rank: 3, release_date: 1450656000, tr: { en: { abilities: 'Periodically sprays Onion Juice and creates Tear Jellies and Tear Jelly Potions. Obstacles touched by Onion Juice turn transparent and can be passed through.', description: "A fish that [[cookie:57]] found swimming in her tears one day. It enjoys swimming in tears. And when it feels dehydrated, it'll start spraying Onion Juice to gather tears from anything that surrounds it (even obstacles!).", name: 'Onion Fish' }, th: { abilities: 'พ่นน้ำหัวหอม', description: 'ปลาที่คุกกี้ออเนี่ยนพบว่ายอยู่ในน้ำตาของเธอวันหนึ่ง มันชอบว่ายน้ำในน้ำตา และเมื่อมันรู้สึกขาดน้ำ มันจะเริ่มพ่นน้ำหัวหอมเพื่อรวบรวมน้ำตาจากทุกสิ่งรอบตัว (แม้แต่อุปสรรค)!', name: 'ปลาหัวหอม' } } }, { grade: 4, id: pet:69, image: 'castanets.png', rank: 3, release_date: 1457049600, tr: { en: { abilities: 'Periodically starts a performance to create Christmas Macaron Jellies, with an additional Power Jelly among them.', description: "What started as an unusually rock-hard macaron became a one-of-a-kind instrument after [[cookie:58]] tied the ends together with a ribbon. Now reborn as the cheerful Castanets, it's completely obsessed with making music at every possible moment. One day, it dreams of sounding just as dazzling as [[cookie:58]]'s drumbeats. It can be a little too chatty for most Cookies to keep up with, but with [[cookie:58]] happily playing along, the two make perfect harmony.", name: 'Castanets' }, th: { abilities: 'การแสดงคาสทาเน็ต', description: 'วันหนึ่ง คุกกี้มาการองพบมาการองที่แข็งเป็นพิเศษ เธอนำมาการองนี้ผูกโบว์สีเหลืองสวยงามและเรียกมันว่าคาสทาเน็ตส์ มันมีความสุขสุดๆ ที่ถูกเปลี่ยนจากของหวานเก่าๆ มาเป็นเครื่องดนตรีที่วิเศษ สักวันมันหวังว่าจะสร้างเสียงที่ไพเราะเท่ากลองมาการองของคุกกี้มาการอง แม้ไม่ใช่ทุกคนจะยินดีกับเพื่อนจ้อจ้าตัวนี้ แต่คุกกี้มาการองอยู่เคียงข้างคาสทาเน็ตส์เสมอ พูดถึงความกลมกลืนที่สมบูรณ์แบบ!', name: 'กรับมาการง' } } }, { grade: 4, id: pet:70, image: 'cinnamon_bunny.png', rank: 3, release_date: 1454630400, tr: { en: { abilities: 'Periodically throws Cinnamon Bombs, crushing obstacles and creating Cinnamon Bun Jellies. Strawberry Cinnamon Bun Jellies slightly restore HP.', description: 'On a sweet, sweet day, [[cookie:59]] pulled this rabbit out of the hat. But this special rabbit refused to re-enter the hat! [[cookie:59]] forcefully pushed and rolled this rabbit into the hat, and ta-da! Cinnamon Bunny was born! Get it? Bun-ny? Although [[cookie:59]] now gave up on putting it back in the hat, this little bunny is still full of suspicion.', name: 'Cinnamon Bunny' }, th: { abilities: 'เวทมนตร์กระต่าย', description: 'ในวันที่แสนหวาน คุกกี้ซินนามอนดึงกระต่ายตัวนี้ออกจากหมวกของเขา แต่กระต่ายพิเศษตัวนี้ปฏิเสธที่จะกลับเข้าไปในหมวก! คุกกี้ซินนามอนผลักและม้วนกระต่ายตัวนี้กลับเข้าไปในหมวกอย่างแรง และแจ่ม! ซินนามอนบันนี่ถือกำเนิด! เข้าใจไหม? บันนี่? แม้คุกกี้ซินนามอนจะยอมแพ้ที่จะเอามันกลับเข้าไปในหมวกแล้ว แต่กระต่ายน้อยตัวนี้ยังเต็มไปด้วยความระแวง', name: 'กระต่ายอบเชย' } } } ];
INSERT [ { grade: 4, id: pet:71, image: 'sweet_rice_seal.png', rank: 3, release_date: 1458864000, tr: { en: { abilities: 'Rolls around and earns points after collecting a certain number of Jellies.', description: 'This little fellow likes to sit still and think …and think …and think. It thinks that because it thinks that it exists. When it thinks too much, it rolls over on its back and stops for a while to let some thoughts go.', name: 'Sweet Rice Seal' }, th: { abilities: 'โรลแอนด์โรล', description: 'เจ้าน้อยตัวนี้ชอบนั่งนิ่งๆ และคิด... และคิด... และคิด มันคิดว่ามันดำรงอยู่เพราะมันคิดว่ามันคิด เมื่อมันคิดมากเกินไป มันจะกลิ้งหงายหลังและหยุดพักสักครู่เพื่อปล่อยความคิดบางอย่างไป', name: 'แมวน้ำโมจิ' } } }, { grade: 4, id: pet:72, image: 'pocket_watch_referee.png', rank: 3, release_date: 1464307200, tr: { en: { abilities: 'Periodically creates a Magnet Blast Jelly.', description: "Nothing can slip through this strict referee. But don't be alarmed, once the match is over, it will be the gentlest Pet you've ever seen. Just make sure you don't touch its mustache. No one touches the mustache.", name: 'Pocket Watch Referee' }, th: { abilities: 'กรรมการนาฬิกาพก', description: 'ไม่มีอะไรหลุดรอดผู้ตัดสินเคร่งครัดคนนี้ได้ แต่อย่าตกใจ เมื่อจบการแข่งขัน มันจะเป็นสัตว์เลี้ยงที่อ่อนโยนที่สุดเท่าที่คุณเคยเห็น แค่แน่ใจว่าอย่าแตะหนวดของมัน ไม่มีใครแตะหนวดได้</center>', name: 'กรรมการนาฬิกาพก' } } }, { grade: 4, id: pet:73, image: 'herb_teapot.png', rank: 3, release_date: 1461801600, tr: { en: { abilities: 'Periodically sprinkles water and grows Jelly Flowers, crushing obstacles.', description: "Originally, a teapot, but ever since its friendship with [[cookie:62]] sprouted, it spends most of its days as a watering tin. When Cookies are tired, it gives them a nice cup of refreshing herbal tea. And when herbs seem thirsty, it energizes them with spring water. But - a strange thing - it flinches at the sight of bugs... Perhaps it's hiding a past we do not know of?", name: 'Herb Teapot' }, th: { abilities: 'พรมน้ำ', description: 'เดิมทีเป็นกาสำหรับชาสมุนไพร แต่ตั้งแต่มิตรภาพกับคุกกี้เฮิร์บงอกเงย มันใช้เวลาส่วนใหญ่เป็นกระป๋องรดน้ำ เมื่อคุกกี้เหนื่อย มันให้ชาสมุนไพรอุ่นๆ เรืองแสงสักถ้วย และเมื่อต้นอ่อนดูกระหายน้ำ มันเติมพลังด้วยน้ำสด แต่—เรื่องแปลก—มันสะดุ้งเมื่อเห็นแมลง... บางทีมันอาจซ่อนอดีตที่เราไม่รู้', name: 'กาน้ำชาสมุนไพร' } } }, { grade: 4, id: pet:74, image: 'dino_egg.png', rank: 3, release_date: 1459728000, tr: { en: { abilities: 'Periodically creates a Dino-Pop Giant Jelly that makes clusters of Dino-Candy Jelly pop.', description: "Even though it could hatch any time it wanted to, this little guy prefers to stay safely tucked away inside the egg. It's uncertain why it stays hidden. What is certain is that only it can break itself free. You can do it!", name: 'Dino Egg' }, th: { abilities: 'ไอเทมตัวยักษ์ไดโนแคนดี้', description: 'แม้มันจะฟักได้เมื่อไหร่ก็ได้ที่ต้องการ เจ้าน้อยตัวนี้ชอบซ่อนตัวอยู่ในไข่อย่างปลอดภัย ไม่แน่ใจว่าทำไมมันถึงซ่อนตัว สิ่งที่แน่นอนคือมีเพียงมันเท่านั้นที่จะทำลายตัวเองออกมาได้ ทำได้!', name: 'ไข่ไดโน' } } }, { grade: 4, id: pet:75, image: 'cotton_candy_bird.png', rank: 3, release_date: 1469750400, tr: { en: { abilities: 'Periodically creates an Alphabet Blast Jelly that triggers Blast and grants one random missing Bonus Time Alphabet.', description: "A cheerful little mail pigeon determined to deliver love all across the world. In its entire delivery career, it's only ever made one mistake—and of course, it involved [[cookie:65]]'s letters. To be fair, the recipient seems to change every other day.", name: 'Cotton Candy Bird' }, th: { abilities: 'สร้างไอเทมพุ่งตัวอักษร', description: 'นกออฟฟิศที่ออกไปส่งความรักสู่โลกคุกกี้ ทหารผ่านศึกตัวนี้ทำพลาดในการส่งของเพียงครั้งเดียวในชีวิต นั่นคือจดหมายฉบับหนึ่งของคุกกี้คอตตอนแคนดี้ แต่มันก็เข้าใจได้ ก็ผู้รับเปลี่ยนไปตลอดเวลามันก็สับสนเหมือนกัน จริงไหม?', name: 'พิราบสายไหม' } } }, { grade: 4, id: pet:76, image: 'light_bros.png', rank: 3, release_date: 1464652800, tr: { en: { abilities: 'Periodically triggers Blast. Slows HP drain the rest of the time.', description: "Light Bros used to be the only ones capable of stopping the racing [[cookie:66]], but now they've teamed up. It's all because Red became completely enthralled by the thrill of the road roller's Blast Mode. Now, like a matador's red cape, Red's appearance triggers [[cookie:66]]'s unstoppable Blast Mode instinct. The mad speed frightens Green, but Red remains completely unfazed.", name: 'Light Bros' }, th: { abilities: 'พุ่ง พลังงานลดลงช้าลง', description: 'เคยเป็นสิ่งเดียวที่หยุด[[cookie:66]]ได้ แต่ตอนนี้พวกเขาจับมือกัน! แทนที่จะหยุดที่ไฟแดง โรดโรลเลอร์กลับกลิ้งเร็วขึ้น—เหมือนวัวเห็นผ้าแดง เขียวกลัวความเร็วทั้งหมด แต่นั่นจะไม่หยุดแดงจากการสนุกกับการขี่', name: 'พี่น้องไลท์' } } }, { grade: 4, id: pet:77, image: 'banana_lion.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically fires a Banana Face to destroy obstacles and create Coins along its trajectory.', description: "The star attraction of the circus is, without a doubt, Banana Lion's famous \"sawing in half\" act! Though the more you watch it... the less it feels like an illusion.", name: 'Banana Lion' }, th: { abilities: 'Periodically fires a Banana Face to destroy obstacles and create Coins along its trajectory.', description: "The star attraction of the circus is, without a doubt, Banana Lion's famous \"sawing in half\" act! Though the more you watch it... the less it feels like an illusion.", name: 'Banana Lion' } } }, { grade: 4, id: pet:78, image: 'pancake_frisbee.png', rank: 3, release_date: 1476403200, tr: { en: { abilities: 'Periodically throws a Pancake Frisbee that crushes obstacles and creates Maple Syrup Jellies in its path.', description: "Pancake Frisbee wakes up early every morning to style its head with maple syrup. It's so difficult to find the perfect amount to drip.", name: 'Pancake Frisbee' }, th: { abilities: 'ขว้างแพนเค้กฟริสบี', description: 'แพนเค้กฟริสบี้ตื่นเช้าทุกวันเพื่อจัดทรงผม(?) ด้วยไซรัปเมเปิล หาปริมาณที่พอดีที่จะหยดได้ยากมาก', name: 'แผ่นแพนเค้ก' } } }, { grade: 4, id: pet:79, image: 'moon_mortar.png', rank: 3, release_date: 1473724800, tr: { en: { abilities: 'Periodically moves ahead to gather Jellies for the Cookie. Then pounds the collected Jellies into a giant Full Moon Rice Cake Jelly that restores a small amount of HP. (Full Moon Rice Cake Jellies are not affected by magnetic effects.)', description: "Moon Mortar's life is devoted to creating the PERFECT Full Moon Rice Cake Jelly. Even though its Full Moon Rice Cake Jellies are tasty and beautiful already, it's never enough for this Pet. All the \"failed\" rice cakes are happily consumed by [[cookie:70]].", name: 'Moon Mortar' }, th: { abilities: 'ตำข้าวต้มพระจันทร์เต็มดวง', description: 'ชีวิตของมันอุทิศให้กับการสร้างเต็มมูนไรซ์เค้กเยลลี่ที่สมบูรณ์แบบ แม้เต็มมูนไรซ์เค้กเยลลี่ของมันจะอร่อยและสวยงามอยู่แล้ว แต่มันก็ไม่เคยพอสำหรับสัตว์เลี้ยงตัวนี้ เค้กข้าวที่ "ล้มเหลว" ทั้งหมดถูกคุกกี้มูนแรบบิทกินอย่างมีความสุข', name: 'ครกดวงจันทร์' } } }, { grade: 4, id: pet:80, image: 'tiny_cake_hound.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Grants Speed Points based on running speed and periodically creates a Strawberry Potion.', description: 'A Cake Hound that is so energetic that no one has ever seen its feet touch the ground.', name: 'Tiny Cake Hound' }, th: { abilities: 'Grants Speed Points based on running speed and periodically creates a Strawberry Potion.', description: 'A Cake Hound that is so energetic that no one has ever seen its feet touch the ground.', name: 'Tiny Cake Hound' } } }, { grade: 4, id: pet:81, image: 'tiny_tabla.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically moves ahead to crush obstacles and turn nearby Jellies into Honey Bun Jellies. Slows HP drain while the skill is active.', description: '[[cookie:72]] met this little drum at her first Holi, and the two have been together ever since. Tiny Tabla loves performing with [[cookie:72]] more than anything in the world!', name: 'Tiny Tabla' }, th: { abilities: 'Periodically moves ahead to crush obstacles and turn nearby Jellies into Honey Bun Jellies. Slows HP drain while the skill is active.', description: '[[cookie:72]] met this little drum at her first Holi, and the two have been together ever since. Tiny Tabla loves performing with [[cookie:72]] more than anything in the world!', name: 'Tiny Tabla' } } }, { grade: 4, id: pet:82, image: 'parrot_dada.png', rank: 3, release_date: 1733875200, tr: { en: { abilities: 'Grants Speed Points based on running speed. Periodically creates a Blast Jelly.', description: "[[cookie:73]]'s old avian assistant, Parrot Dada, urges the prince to settle down a bit too often.", name: 'Parrot Dada' }, th: { abilities: 'ให้คะแนนความเร็วและสร้างพาวเวอร์เยลลี่', description: "ให้คะแนนโบนัสสำหรับความเร็วที่มากขึ้นและสร้างของดีๆ ตามช่วงเวลาที่กำหนด\n\nผู้ช่วยนกเก่าของ{{cch|Kaju Katli}} ปาร์รอทดาด้า มักจะเร่งให้เจ้าชายตั้งหลักสักที\n\n'Kakao:' นกแก้วที่รับใช้{{cch|Kaju Katli}}มาตั้งแต่เด็ก มันมีนิสัยชอบพูดซ้ำว่า \"น่าจะหาคู่ให้คุณสักคนแล้ว\"", name: 'นกแก้วดาดา' } } }, { grade: 4, id: pet:83, image: 'soft_egg_bunny.png', rank: 3, release_date: 1743033600, tr: { en: { abilities: 'Periodically charges ahead, crushing obstacles and creating Egg Jellies and HP Egg Jellies.', description: 'Egg-xasperated about where it might fall? No worries! While its body is soft, it is protected by a sturdy eggshell!', name: 'Soft Egg Bunny' }, th: { abilities: 'บดอุปสรรค เยลลี่', description: 'พุ่งไปข้างหน้าเป็นระยะ บดขยี้อุปสรรคและสร้างเอ้กเยลลี่กับเอชพีเอ้กเยลลี่\n\n<center>กังวลว่าไข่จะตกลงไปตรงไหน? ไม่ต้องห่วง! แม้ร่างจะนุ่ม แต่มันถูกปกป้องด้วยเปลือกไข่ที่แข็งแรง!</center>', name: 'กระต่ายไข่นุ่ม' } } }, { grade: 4, id: pet:84, image: 'cucu_dding.png', rank: 3, release_date: 1745798400, tr: { en: { abilities: 'Periodically sings to summon the Frog Family. The Frog Family crushes obstacles and creates Duckweed Jellies.', description: "Cucu-dding became best friends with [[cookie:75]] after a chance meeting at a fishing spot. It's convinced that its singing is what draws the fish to [[cookie:75]]'s rod. It loves gathering a family of frogs at the pond for a lively croaking chorus.", name: 'Cucu-dding' }, th: { abilities: 'บดอุปสรรค เยลลี่', description: 'มันร้องเพลงเพื่อเรียกครอบครัวกบ ครอบครัวกบทำลายอุปสรรคและสร้างดั๊กวีดเยลลี่\n\nคิวู-ดดิ้งกลายเป็นเพื่อนซี้กับ{{Cch|cucumber|ov=t}}หลังจากการพบกันโดยบังเอิญที่จุดตกปลา มันเชื่อว่าการร้องเพลงของมันคือสิ่งที่ดึงดูดปลามาที่คันเบ็ดของ[[cookie:75]] มันชอบรวบรวมครอบครัวกบที่บ่อน้ำเพื่อร้องประสานเสียงกบอย่างมีชีวิตชีวา</center>', name: 'คิวคัพดิ้ง' } } }, { grade: 4, id: pet:85, image: 'elder_black_rice.png', rank: 3, release_date: 1748476800, tr: { en: { abilities: 'Periodically creates a Black Rice Bowl Jelly that restores HP and transforms basic Jellies into Black Stone Jellies.', description: 'Elder Black Rice, crafted from tightly packed black rice grains. As strict as the firm, chewy bite of black rice itself, this stern teacher stays busy keeping snack-loving students in line all day long.', name: 'Elder Black Rice' }, th: { abilities: 'เยลลี่ข้าวดำ', description: 'สร้างแบล็คไรซ์โบวล์เยลลี่เป็นระยะซึ่งฟื้นฟูพลังชีวิตและแปลงเยลลี่พื้นฐานเป็นแบล็คสโตนเยลลี่\n\nเอ็ลเดอร์แบล็คไรซ์ สร้างจากเมล็ดข้าวดำที่อัดแน่น เคร่งครัดเหมือนรสชาติหนึบแน่นของข้าวดำ ครูที่เข้มงวดคนนี้ยุ่งอยู่กับการควบคุมนักเรียนที่ชอบกินขนมให้อยู่ในระเบียบตลอดทั้งวัน', name: 'ข้าวดำผู้อาวุโส' } } }, { grade: 4, id: pet:86, image: 'elder_white_rice.png', rank: 3, release_date: 1748476800, tr: { en: { abilities: 'Periodically creates a White Rice Bowl Jelly that restores HP and transforms basic Jellies into White Stone Jellies.', description: "Soft white rice carefully packed together to form the warm and gentle Elder White Rice. Whether it's a bad move or a rough day, this sweet old teacher always pats the student's back and says not to worry too much. After all, both Go and life are better when you know how to slow down for a turn or two.", name: 'Elder White Rice' }, th: { abilities: 'เยลลี่ข้าวขาว', description: 'สร้างไวท์ไรซ์โบวล์เยลลี่เป็นระยะซึ่งฟื้นฟูพลังชีวิตและแปลงเยลลี่พื้นฐานเป็นไวท์สโตนเยลลี่\n\nข้าวขาวนุ่มที่ถูกบรรจุอย่างพิถีพิถันรวมกันเป็นไวท์ไรซ์ผู้อาวุโสผู้อบอุ่นและอ่อนโยน ไม่ว่าจะหมากไม่ดีหรือวันที่แย่ ครูแกะหวานผู้นี้ตบหลังนักเรียนเสมอและบอกว่าไม่ต้องกังวลมากเกินไป หลังจากนั้น ทั้งโก{{Sic}}และชีวิตจะดีขึ้นเมื่อคุณรู้จักชะลอสักหนึ่งหรือสองตา', name: 'ข้าวขาวผู้อาวุโส' } } }, { grade: 4, id: pet:87, image: 'pegaplush.png', rank: 3, release_date: 1751241600, tr: { en: { abilities: 'Grants Speed Points based on running speed. Grants 3 Pit Lifts or Revives with 38 HP to each Cookie.', description: "Born in the pool beneath a roaring waterfall, this little Pegaplush has dreamed its whole life of carrying [[cookie:78]] on its back. And with [[cookie:78]] constantly rushing from place to place, its wings hardly get a moment's rest.", name: 'Pegaplush' }, th: { abilities: 'คะแนนความเร็ว ยกขึ้นจากหลุม/ฟื้นคืนชีพ', description: "ให้คะแนนความเร็วตามความเร็วที่วิ่ง ให้การยกขึ้นจากหลุม 3 ครั้งหรือฟื้นคืนชีพด้วยพลังชีวิต 38 แก่คุกกี้แต่ละตัว\r\n\r\n'เพกาพลัช' เป็นการเล่นคำระหว่าง 'เพกาซัส' กับ 'พลัชชี่ (plushie)'", name: 'เพกาพลัช' } } }, { grade: 4, id: pet:88, image: 'ghoul_cake.png', rank: 3, release_date: 1753920000, tr: { en: { abilities: 'Periodically sheds tears, causing Tear Jellies and Honey Tear Jellies to rain from the sky. Collecting Honey Tear Jellies restores HP. Honey Tear Jellies do not count as HP Potions.', description: "Just as it was about to satisfy the hunger of a young Cookie who had never once tasted the joys of a village feast, it was cruelly knocked to the ground by a corrupt magistrate's greed. Filled with bitterness and regret, Ghoul Cake still wanders this world, unable to move on. Its sorrowful story is so heartbreaking that even [[cookie:79]], tears welling in her eyes, hesitated before striking it down.", name: 'Ghoul Cake' }, th: { abilities: 'เยลลี่น้ำตา เยลลี่น้ำตาน้ำผึ้ง', description: 'ร้องไห้เป็นระยะ ทำให้เทียร์เยลลี่และฮันนี่เทียร์เยลลี่ตกลงมาจากฟ้า การเก็บฮันนี่เทียร์เยลลี่ฟื้นฟูพลังชีวิต ฮันนี่เทียร์เยลลี่ไม่นับเป็นโพชันพลังชีวิต', name: 'เค้กผี' } } }, { grade: 4, id: pet:89, image: 'tater_trader.png', rank: 3, release_date: 1756339200, tr: { en: { abilities: 'Periodically creates a Giant Jelly surrounded by Coins. Grants bonus Coins depending on speed.', description: "A cheerful little Tater Trader helping [[cookie:80]] run the shop in exchange for delicious homemade salads. It's surprisingly excellent at managing Coins and keeping business booming, though its sales strategy mostly consists of yelling \"Buy everything!\" at every customer who walks by.", name: 'Tater Trader' }, th: { abilities: 'เหรียญความเร็ว เยลลี่ตัวยักษ์', description: 'สร้างตัวยักษ์เยลลี่ที่รายล้อมด้วยเหรียญเป็นระยะ ให้เหรียญโบนัสตามความเร็ว\n\nเทเทอร์เทรดเดอร์ตัวน้อยผู้ร่าเริงช่วย{{cch|potatosalad|ov=t}}ดูแลร้านแลกกับสลัดโฮมเมดแสนอร่อย มันเก่งอย่างน่าประหลาดใจในการจัดการเหรียญและทำให้ธุรกิจคึกคัก แม้กลยุทธ์การขายของมันส่วนใหญ่จะเป็นการตะโกนว่า "ซื้อทุกอย่าง!" กับลูกค้าทุกคนที่เดินผ่าน', name: 'พ่อค้ามัน' } } }, { grade: 4, id: pet:90, image: 'lady_mudang.png', rank: 3, release_date: 1759104000, tr: { en: { abilities: 'Periodically flies up and rams into the ground, crushing obstacles to earn Crush Points. Leaves behind Scallion Kimchi Bear Jellies in place of crushed obstacles and an HP potion at its impact. Sprinkles seasoning to grant 1 Revive upon collapse.', description: "A fearless little shaman bug that charges headfirst with its sturdy body to \"drive away\" evil spirits. It first met [[cookie:81]] after mistaking the utterly exhausted Cookie for a ghost and attacking on sight—somehow, the two ended up becoming companions instead. Be careful not to catch Lady Mudang's sharp glowing gaze, or you might find yourself getting smacked with a handful of salt.", name: 'Lady Mudang' }, th: { abilities: 'บดอุปสรรค ฟื้นคืนชีพ}}', description: 'บินขึ้นและพุ่งชนพื้นเป็นระยะ บดขยี้อุปสรรคเพื่อรับคะแนนบดขยี้ ทิ้งสแกลเลียนคิมจิแบร์เยลลี่ไว้แทนอุปสรรคที่ถูกบดและโพชันพลังชีวิตที่จุดชน เมื่อล้มตัวลง โรยเครื่องปรุงเพื่อให้การฟื้นคืนชีพ 1 ครั้ง\n\nแมลงชามานตัวน้อยผู้ไม่เกรงกลัวที่พุ่งหัวชนกับร่างกายอันแข็งแกร่งเพื่อ "ขับไล่" วิญญาณชั่วร้าย มันพบ{{Cch|scallionkimchi|ov=t}}ครั้งแรกหลังจากเข้าใจผิดว่าคุกกี้ที่เหนื่อยล้าสุดขีดเป็นผีและโจมตีทันทีที่เห็น—ไม่รู้ว่าอย่างไร ทั้งคู่กลับกลายเป็นสหายกันแทน ระวังอย่าสบประกายตาอันแหลมคมของเลดี้มูดัง ไม่เช่นนั้นคุณอาจโดนเกลือกำมือหนึ่ง', name: 'ท่านหญิงมูดัง' } } }, { grade: 4, id: pet:91, image: 'kimchi_bell.png', rank: 3, release_date: 1759104000, tr: { en: { abilities: 'Periodically moves ahead, pickling obstacles with salt to make them passable. Slows HP drain while the skill is active. Sprinkles salt to revive the Cookie once upon collapse.', description: "The sacred Kimchi Bell that lifts the spirit with its clear, calming chime. Passed down through [[cookie:82]]'s family for generations, this mysterious little bell is said to carry the power of purification. Listen closely, and even the darkest thoughts may simply drift away!", name: 'Kimchi Bell' }, th: { abilities: 'หลบอุปสรรค ฟื้นคืนชีพ}}', description: "เคลื่อนไปข้างหน้าเป็นระยะ ดองอุปสรรคด้วยเกลือเพื่อให้ผ่านได้ ลดการสูญเสียพลังชีวิตขณะสกิลทำงาน โรยเกลือเพื่อฟื้นคืนชีพคุกกี้หนึ่งครั้งเมื่อล้มตัวลง\n\nระฆังคิมจิอันศักดิ์สิทธิ์ที่ปลอบประโลมจิตวิญญาณด้วยเสียงอันใสกังวาน สืบทอดผ่านตระกูลของ{{cch|whitekimchi|ov=t|'s}}มาหลายชั่วอายุคน ระฆังน้อยลึกลับนี้ว่ากันว่ามีพลังแห่งการชำระล้าง ฟังให้ดี แม้แต่ความคิดที่มืดมนที่สุดก็อาจลอยหายไป!", name: 'กระดิ่งกิมจิ' } } }, { grade: 4, id: pet:92, image: 'chronicles_of_run.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically records a journal and grants bonus points based on the number of points earned. Then creates a Yellow Bear Jelly Party and restores HP. Grants one more score when the Cookie collapses and reveals the top 5 records of the run.', description: "Chronicles of Run always dreamed of recording the tales of the Cookies it admired most—and as fate would have it, it found [[cookie:83]]. Ever since, it's stayed faithfully by the lonely hero's side, quietly looking after the feelings no one else notices. And because the world deserves to know every step of [[cookie:83]]'s legendary journey, Chronicles of Run proudly reads its finest entries aloud for all to hear.", name: 'Chronicles of Run' }, th: { abilities: 'Periodically records a journal and grants bonus points based on the number of points earned. Then creates a Yellow Bear Jelly Party and restores HP. Grants one more score when the Cookie collapses and reveals the top 5 records of the run.', description: "Chronicles of Run always dreamed of recording the tales of the Cookies it admired most—and as fate would have it, it found [[cookie:83]]. Ever since, it's stayed faithfully by the lonely hero's side, quietly looking after the feelings no one else notices. And because the world deserves to know every step of [[cookie:83]]'s legendary journey, Chronicles of Run proudly reads its finest entries aloud for all to hear.", name: 'Chronicles of Run' } } }, { grade: 4, id: pet:93, image: 'manggae_snail.png', rank: 3, release_date: 1764720000, tr: { en: { abilities: 'Periodically creates a Snail Slime Jelly that grants Giant and Magnet for a short time, and creates Dew Jellies that crush obstacles.', description: 'Once just a homeless little leaf snail, it finally found a place to belong after meeting [[cookie:84]], who gifted it a perfectly round rice cake shell to call home. At first glance, it looks just like a Manggae Rice Cake, but the tiny antennae poking up from the top give it away every time. Thanks to its special snail slime, it stays fresh and dewy all day long, leaving behind plenty of sparkling Dew Jellies wherever it goes.', name: 'Manggae Snail' }, th: { abilities: 'เยลลี่เมือกหอยทาก', description: 'สร้างสเนลสไลม์เยลลี่ที่ให้ตัวยักษ์และแม่เหล็กช่วงสั้นๆ เป็นครั้งคราว และสร้างดิวเยลลี่ที่บดขยี้อุปสรรค\n\nครั้งหนึ่งเคยเป็นหอยทากใบไม้จรจัดตัวน้อย ในที่สุดมันก็พบที่ที่มันเป็นเจ้าของหลังจากได้พบ{{cch|manggaetteok|ov=t}}ผู้มอบเปลือกเค้กข้าวกลมกลมเป็นบ้านให้ มองแวบแรกมันดูเหมือนเค้กข้าวมังแก แต่หนวดเล็กๆ ที่โผล่จากด้านบนทำให้จับได้ทุกครั้ง ด้วยสไลม์พิเศษของมัน มันคงความสดชื่นและชุ่มชื้นตลอดทั้งวัน ทิ้งดิวเยลลี่ประกายระยิบระยับมากมายไว้ทุกที่ที่มันไป', name: 'หอยทากมังกึด' } } }, { grade: 3, id: pet:94, image: 'sotdae_flock.png', rank: 2, release_date: 1768435200, tr: { en: { abilities: 'Periodically drops Sotdae poles from the sky to create Almond Slice Jellies. Obstacles hit by the poles become transparent and passable.', description: 'What began as a hand-carved almond duck made by [[cookie:86]] was blessed with the mysterious power of a village totem, transforming it into the Sotdae Flock overflowing with good fortune and abundance. Rumor has it that anyone lucky enough to stumble across the family gathered together is guaranteed a rich, satisfying, and wonderfully cozy day ahead.', name: 'Sotdae Flock' }, th: { abilities: 'เยลลี่ หลบอุปสรรค', description: 'หย่อนเสาโซทแดจากฟ้าเป็นครั้งคราวเพื่อสร้างอัลมอนด์สไลซ์เยลลี่ อุปสรรคที่ถูกเสาโจมตีจะโปร่งใสและผ่านได้\n\nสิ่งที่เริ่มต้นจากเป็ดอัลมอนด์แกะสลักด้วยมือโดย{{cch|garaetteok}}ได้รับพรจากพลังลึกลับของเสาโทเท็มหมู่บ้าน แปลงร่างเป็นฝูงโซทแดที่เต็มไปด้วยโชคลาภและความอุดมสมบูรณ์ ข่าวลือบอกว่าใครก็ตามที่โชคดีพอได้พบครอบครัวที่รวมตัวกันจะรับประกันว่าวันข้างหน้าจะร่ำรวย อิ่มเอม และอบอุ่นอย่างแสนสุข', name: 'ฝูงซอดแด' } } }, { grade: 4, id: pet:95, image: 'choco_hedgehog.png', rank: 3, release_date: 1772064000, tr: { en: { abilities: 'Periodically dashes ahead, bouncing off obstacles and scattering Cocoa Powder. Areas covered in Cocoa Powder turn into Cocoa Ground and generate Chewy Choco Jellies. While on Cocoa Ground, HP drains more slowly.', description: "A round little hedgehog that lives in groups across the Pistachio Oasis, Choco Hedgehog was discovered rolling alone through the oasis mud after losing its herd and eventually teamed up with [[cookie:87]]. Don't let the adorable looks fool you—its sharp spikes and incredible bounce power can smash through any obstacle. Small but mighty!", name: 'Choco Hedgehog' }, th: { abilities: 'เยลลี่ช็อกโกหนึบ', description: 'พุ่งไปข้างหน้าเป็นระยะ กระเด้งกับอุปสรรคและโปรยผงโกโก้ พื้นที่ที่ปกคลุมด้วยผงโกโก้กลายเป็นพื้นโกโก้และสร้างเชวี่ช็อกโกเยลลี่ ขณะอยู่บนพื้นโกโก้ พลังชีวิตลดลงช้าลง\n\nเม่นกลมตัวน้อยที่อาศัยเป็นกลุ่มทั่วโอเอซิสพิสตาชิโอ ช็อกโกเฮดจ์ฮ็อกถูกพบกลิ้งอยู่ตามลำพังในโคลนโอเอซิสหลังจากพลัดฝูง และสุดท้ายก็ร่วมทีมกับ{{cch|chocopistachio|ov=t}} อย่าปล่อยให้รูปลักษณ์น่ารักหลอกคุณ—หนามแหลมและพลังเด้งอันเหลือเชื่อของมันสามารถทลายอุปสรรคใดๆ ตัวเล็กแต่แกร่ง!', name: 'เม่นช็อกโก' } } }, { grade: 4, id: pet:96, image: 'baby_spore.png', rank: 3, release_date: 1774915200, tr: { en: { abilities: 'Periodically flies ahead on a flower petal, creating Spring Flower Jellies and a winged HP Potion on the path.', description: "Baby Spore lets itself be carried by the spring breeze on its long flight. It likes to shyly hide its soft cheeks behind flower petals whenever it gets the chance. Alternating between riding the winds and napping among the spring flowers, maybe that's why Baby Spore is always filled with the warm scent of sunshine.", name: 'Baby Spore' }, th: { abilities: 'เยลลี่ดอกไม้ฤดูใบไม้ผลิ', description: 'บินไปข้างหน้าบนกลีบดอกไม้เป็นครั้งคราว สร้างสปริงฟลาวเวอร์เยลลี่และโพชันพลังชีวิตติดปีกบนเส้นทาง\n\nเบบี้สปอร์ปล่อยให้ตัวเองถูกพัดพาโดยสายลมฤดูใบไม้ผลิในการบินอันยาวนาน มันชอบซ่อนแก้มนุ่มๆ ไว้หลังกลีบดอกไม้อย่างเขินอายเมื่อมีโอกาส สลับระหว่างการขี่สายลมและการงีบหลับท่ามกลางดอกไม้ฤดูใบไม้ผลิ บางทีนั่นอาจเป็นเหตุผลที่เบบี้สปอร์เต็มไปด้วยกลิ่นหอมอบอุ่นของแสงแดดเสมอ', name: 'สปอร์น้อย' } } }, { grade: 4, id: pet:97, image: 'honey_gourd.png', rank: 3, release_date: 1777420800, tr: { en: { abilities: 'Periodically creates Blast Honey Jelly Party.', description: "Despite its cute, round appearance, this is actually quite a terrifying gourd that lures its victims in with a sweet honey scent and sucks them inside. It is filled with sticky, sweet honey, making it nearly impossible to escape once you fall in... but no one knows what happens afterward. It is said that [[cookie:89]] is the only Cookie to have ever escaped Honey Gourd's trap. And it must have been very displeased with that, for it is constantly waiting for an opportunity to absorb [[cookie:89]] again.", name: 'Honey Gourd' }, th: { abilities: 'พุ่งปาร์ตี้เยลลี่น้ำผึ้ง', description: 'สร้างปาร์ตี้พุ่งฮันนี่เยลลี่เป็นระยะ\n\nแม้รูปลักษณ์น่ารักกลมกล่อม นี่คือน้ำเต้าที่น่ากลัวจริงๆ ซึ่งล่อเหยื่อด้วยกลิ่นน้ำผึ้งหวานและดูดพวกมันเข้าไปข้างใน มันเต็มไปด้วยน้ำผึ้งเหนียวหวาน ทำให้หนีไม่ได้เมื่อตกลงไป... แต่ไม่มีใครรู้ว่าเกิดอะไรขึ้นหลังจากนั้น ว่ากันว่า{{cch|kaymak|ov=t}}เป็นคุกกี้เพียงตัวเดียวที่เคยหนีจากกับดักของฮันนีกูร์ดได้ และมันคงไม่พอใจกับเรื่องนั้นมาก เพราะมันคอยรอโอกาสที่จะดูดคุกกี้คายมักกลับเข้าไปอีกตลอดเวลา', name: 'น้ำเต้าน้ำผึ้ง' } } }, { grade: 4, id: pet:98, image: 'white_dragon_horsie.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically changes into dragon form and charges ahead to turn Jellies into Pine Powder Jellies and restore HP.', description: 'Originally raised as the third son of the Dragon King, he was turned into a dragon horse as punishment for a transgression. [[cookie:90]] took pity on it bouncing around on its curled tail and gave it pine needle wings. Every once in a while, the seal is broken and it regains its original dragon form for a little while, but quickly reverts to its cuter self.', name: 'White Dragon Horsie' }, th: { abilities: 'Periodically changes into dragon form and charges ahead to turn Jellies into Pine Powder Jellies and restore HP.', description: 'Originally raised as the third son of the Dragon King, he was turned into a dragon horse as punishment for a transgression. [[cookie:90]] took pity on it bouncing around on its curled tail and gave it pine needle wings. Every once in a while, the seal is broken and it regains its original dragon form for a little while, but quickly reverts to its cuter self.', name: 'White Dragon Horsie' } } }, { grade: 4, id: pet:99, image: 'lotus_sitter.png', rank: 3, release_date: 1782345600, tr: { en: { abilities: 'Periodically creates a Lotus Drop Jelly that bursts, making nearby obstacles passable.', description: 'This lotus seed pod always follows in the shade of [[cookie:91]], mostly to stay out of the dry desert sun. Magical power granted by [[cookie:91]] allows it to fly around freely. A timid personality means it often sticks its head in the water whenever it gets embarrassed.', name: 'Lotus Sitter' }, th: { abilities: 'เยลลี่หยดดอกบัว', description: 'สร้างโลตัส ดรอปเยลลี่ที่ระเบิด ทำให้อุปสรรคใกล้เคียงผ่านได้เป็นระยะ\n\nฝักเมล็ดโลตัส มักตามเงาของ{{cch|lotusrootphantom|ov=t}}เสมอ ส่วนใหญ่เพื่อหลบแดดทะเลทรายแห้งแล้ง พลังเวทที่คุกกี้โลตัสรูทแพนท่อมมอบให้ทำให้มันบินไปมาได้อย่างอิสระ นิสัยขี้อายทำให้มันมักมุดหัวลงน้ำทุกครั้งที่เขินอาย', name: 'ที่นั่งดอกบัว' } } }, { grade: 4, id: pet:100, image: 'bok_choy_cushion.png', rank: 3, release_date: 1784764800, tr: { en: { abilities: 'Slows HP drain at lower Cookie HP.', description: "The Bok Choy Cushion has been [[cookie:93]]'s companion since her days of working the fields in her village. The moment you sit down on this crisp yet ever-fresh cushion, all the fatigue accumulated from hard work is lifted at once. Even now, as [[cookie:93]] has set out on the journey, it remains by her side so she can rest her feet on the long road ahead.", name: 'Bok Choy Cushion' }, th: { abilities: '-HP ลดลง', description: 'ลดการสูญเสียพลังชีวิตเมื่อพลังชีวิตของคุกกี้ต่ำ', name: 'หมอนผักกวางตุ้ง' } } }, { grade: 4, id: pet:101, image: 'mango_roll.png', rank: 3, release_date: 0, tr: { en: { abilities: 'Periodically generates a Mango Blast Jelly. Eating it turns obstacles into Mango Jellies. (Amount of converted Mango Jellies capped.)', description: 'Made by shaping glutinous rice into a round shape and arranging ripe mangoes around it like flower petals. Perhaps because it was born on a beach filled with happy laughter, its perpetually beaming smile is its most charming feature. Thanks to the Mango Roll, it always looks as if the summer sun is floating right next to the [[cookie:94]].', name: 'Mango Roll' }, th: { abilities: 'Periodically generates a Mango Blast Jelly. Eating it turns obstacles into Mango Jellies. (Amount of converted Mango Jellies capped.)', description: 'Made by shaping glutinous rice into a round shape and arranging ripe mangoes around it like flower petals. Perhaps because it was born on a beach filled with happy laughter, its perpetually beaming smile is its most charming feature. Thanks to the Mango Roll, it always looks as if the summer sun is floating right next to the [[cookie:94]].', name: 'Mango Roll' } } } ];

